      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@mdi/font@7.4.47/css/materialdesignicons.min.css');\n\nbody {\n  margin: 0;\n  background: #f7f8fa;\n  font-family: 'Inter', Arial, Helvetica, sans-serif;\n  color: #182235;\n  -webkit-font-smoothing: antialiased;\n}\n\n.navbar, .navbar *, .page, .page * { box-sizing: border-box; }\n.navbar img, .page img { display: block; }\n\n/* ---------------- navbar (unchanged shell) ---------------- */\n.navbar {\n  background: #fff;\n  border-bottom: 1px solid #f0eeeb;\n  box-shadow: 0 4px 18px rgba(35, 27, 17, 0.05);\n  font-family: 'Inter', Arial, sans-serif;\n}\n.navbar-inner {\n  max-width: 1400px;\n  min-height: 88px;\n  margin: 0 auto;\n  padding: 10px 40px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 24px;\n}\n.brand { display: inline-flex; align-items: center; flex-shrink: 0; text-decoration: none; }\n.brand img { height: 70px; width: auto; max-width: 155px; object-fit: contain; }\n.nav-middle { display: flex; flex: 1; min-width: 0; align-items: center; justify-content: space-between; gap: 22px; }\n.nav-links { display: flex; align-items: center; justify-content: center; gap: 20px; margin: 0 auto; padding: 0; list-style: none; }\n.nav-links a {\n  display: inline-flex;\n  align-items: center;\n  color: #333;\n  text-decoration: none;\n  font-size: 16px;\n  font-weight: 600;\n  padding: 12px 0;\n  white-space: nowrap;\n}\n.nav-links a:hover { color: #f06428; }\n.nav-cart { font-size: 21px; color: #333; line-height: 1; }\n.nav-actions { display: flex; align-items: center; gap: 12px; flex-shrink: 0; }\n.nav-search {\n  display: flex;\n  align-items: center;\n  width: 224px;\n  padding: 4px 5px 4px 15px;\n  border: 1px solid #e9e5e1;\n  border-radius: 30px;\n  background: #f8f8f8;\n}\n.nav-search input {\n  width: 100%;\n  min-width: 0;\n  padding: 9px 0;\n  border: 0;\n  outline: 0;\n  background: transparent;\n  color: #242424;\n  font-size: 14px;\n  font-family: inherit;\n}\n.nav-search input::placeholder { color: #898989; }\n.nav-search button {\n  display: grid;\n  place-items: center;\n  flex-shrink: 0;\n  width: 36px;\n  height: 36px;\n  padding: 0;\n  border: 0;\n  border-radius: 50%;\n  background: #fff0e7;\n  color: #ed5b22;\n  cursor: pointer;\n  font-size: 19px;\n}\n.nav-logout {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  min-height: 44px;\n  padding: 0 23px;\n  border: 1px solid #f06428;\n  border-radius: 30px;\n  background: #f06428;\n  color: #fff;\n  font-family: inherit;\n  font-size: 15px;\n  font-weight: 700;\n  cursor: pointer;\n  white-space: nowrap;\n}\n.nav-logout i { font-size: 18px; color: #fff; }\n\n/* ---------------- page ---------------- */\n.page { max-width: 1400px; margin: 0 auto; padding: 32px 40px 56px; }\n\n.page-head {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  gap: 24px;\n}\n.page-head h1 {\n  margin: 0;\n  font-size: 30px;\n  font-weight: 800;\n  letter-spacing: -0.7px;\n  color: #131c2b;\n}\n.order-count { font-size: 14px; font-weight: 500; color: #6f7a8a; }\n\n.toolbar {\n  display: flex;\n  align-items: flex-end;\n  justify-content: space-between;\n  gap: 24px;\n  margin-top: 20px;\n  margin-bottom: 16px;\n}\n.tabs { display: flex; align-items: flex-end; gap: 30px; border-bottom: 1px solid #e6e9ee; }\n.tab {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  height: 44px;\n  padding: 0 1px 12px;\n  margin-bottom: -1px;\n  border: 0;\n  border-bottom: 2px solid transparent;\n  background: transparent;\n  color: #55606f;\n  font-family: inherit;\n  font-size: 14.5px;\n  font-weight: 600;\n  cursor: pointer;\n  white-space: nowrap;\n}\n.tab:hover { color: #f06428; }\n.tab.active { color: #e2540f; border-bottom-color: #f06428; }\n.tab-count {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  min-width: 19px;\n  height: 19px;\n  padding: 0 5px;\n  border-radius: 5px;\n  background: #eef1f4;\n  color: #5c6674;\n  font-size: 11.5px;\n  font-weight: 700;\n  font-feature-settings: \"tnum\";\n}\n.tab.active .tab-count { background: #fde8dc; color: #c34d10; }\n\n.orders-search {\n  display: flex;\n  align-items: center;\n  gap: 9px;\n  width: 320px;\n  height: 44px;\n  padding: 0 14px;\n  border: 1px solid #e3e7ec;\n  border-radius: 10px;\n  background: #fff;\n  color: #98a0ac;\n  flex-shrink: 0;\n}\n.orders-search i { font-size: 19px; color: #98a0ac; }\n.orders-search input {\n  width: 100%;\n  min-width: 0;\n  border: 0;\n  outline: 0;\n  background: transparent;\n  color: #182235;\n  font-family: inherit;\n  font-size: 13.5px;\n}\n.orders-search input::placeholder { color: #8d96a3; }\n\n.orders-list { display: flex; flex-direction: column; gap: 12px; }\n\n/* ---------------- ongoing order ---------------- */\n.order-ongoing {\n  background: #fff;\n  border: 1px solid #f2dcc9;\n  border-radius: 16px;\n  overflow: hidden;\n}\n.band {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 24px;\n  min-height: 56px;\n  padding: 10px 20px;\n  background: #fff8f3;\n  border-bottom: 1px solid #f6e5d7;\n}\n.band-status {\n  display: flex;\n  align-items: center;\n  gap: 9px;\n  font-size: 19px;\n  font-weight: 700;\n  letter-spacing: -0.25px;\n  color: #c9500f;\n}\n.band-status .s-icon { font-size: 17px; line-height: 1; color: #f06428; }\n.band-total { display: flex; align-items: baseline; gap: 10px; }\n.band-total span { font-size: 12px; font-weight: 600; color: #97796a; letter-spacing: 0.1px; }\n.band-total strong {\n  font-size: 21px;\n  font-weight: 800;\n  letter-spacing: -0.4px;\n  color: #131c2b;\n  font-feature-settings: \"tnum\";\n}\n\n.identity { display: flex; align-items: center; gap: 14px; padding: 15px 20px 0; }\n.identity img {\n  width: 54px;\n  height: 54px;\n  flex-shrink: 0;\n  object-fit: cover;\n  border-radius: 12px;\n  background: #f1f2f4;\n}\n.identity h3 {\n  margin: 0 0 5px;\n  font-size: 17px;\n  font-weight: 700;\n  letter-spacing: -0.2px;\n  color: #182235;\n}\n.meta-line { margin: 0; font-size: 13px; color: #6b7787; font-weight: 500; font-feature-settings: \"tnum\"; }\n.meta-line .order-no { color: #3d4859; font-weight: 600; }\n.meta-line .sep { margin: 0 7px; color: #b3bac4; }\n\n.tracking {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  padding: 22px 46px 18px;\n}\n.tracking-step {\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 8px;\n  font-size: 12.5px;\n  font-weight: 500;\n  color: #79828f;\n  text-align: center;\n}\n.tracking-step:not(:last-child)::after {\n  content: \"\";\n  position: absolute;\n  top: 14px;\n  left: calc(50% + 20px);\n  width: calc(100% - 40px);\n  height: 2px;\n  border-radius: 2px;\n  background: #e1e5ea;\n}\n.tracking-step.done:not(:last-child)::after { background: #f06428; }\n.step-circle {\n  position: relative;\n  z-index: 1;\n  display: grid;\n  place-items: center;\n  width: 30px;\n  height: 30px;\n  border: 2px solid #dfe4ea;\n  border-radius: 50%;\n  background: #fff;\n  font-size: 12px;\n  font-weight: 700;\n  color: #8b939f;\n  font-feature-settings: \"tnum\";\n}\n.tracking-step.done .step-circle { background: #f06428; border-color: #f06428; color: #fff; font-size: 13px; }\n.tracking-step.done { color: #4d5867; }\n.tracking-step.current { color: #c9500f; font-weight: 700; }\n.tracking-step.current .step-circle {\n  border-color: #f06428;\n  color: #e2540f;\n  box-shadow: 0 0 0 4px #fdf0e7;\n}\n\n.order-foot {\n  display: flex;\n  align-items: center;\n  gap: 26px;\n  padding: 14px 20px 16px;\n  border-top: 1px solid #f3f5f7;\n}\n.items { display: flex; align-items: center; gap: 20px; flex: 1; min-width: 0; flex-wrap: wrap; }\n.item { display: flex; align-items: center; gap: 10px; }\n.item img {\n  width: 44px;\n  height: 44px;\n  flex-shrink: 0;\n  object-fit: cover;\n  border-radius: 9px;\n  background: #f1f2f4;\n}\n.item-name { display: flex; flex-direction: column; gap: 3px; }\n.item-name span { font-size: 13px; font-weight: 600; color: #26313f; line-height: 1.25; }\n.item-name small { font-size: 12px; font-weight: 500; color: #7a8290; font-feature-settings: \"tnum\"; }\n\n.payment { flex-shrink: 0; font-size: 12px; font-weight: 500; color: #6e7887; white-space: nowrap; }\n.payment strong { font-size: 12px; font-weight: 700; color: #2c3746; letter-spacing: 0.2px; }\n\n.btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n  height: 44px;\n  padding: 0 16px;\n  border-radius: 10px;\n  font-family: inherit;\n  font-size: 13px;\n  font-weight: 700;\n  white-space: nowrap;\n  cursor: pointer;\n}\n.btn-details { border: 1px solid #dce0e6; background: #fff; color: #1b2432; }\n.btn-details i { font-size: 17px; color: #7d8795; }\n.btn-details:hover { border-color: #f06428; color: #c9500f; }\n.btn-reorder { border: 1px solid #f06428; background: #f06428; color: #fff; padding: 0 18px; }\n.btn-reorder .re { font-size: 16px; line-height: 1; }\n.btn-reorder:hover { background: #d9540f; border-color: #d9540f; }\n.actions { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }\n\n/* ---------------- terminal orders ---------------- */\n.order-past {\n  background: #fff;\n  border: 1px solid #e9ecf0;\n  border-radius: 14px;\n  padding: 14px 18px 13px;\n}\n.past-top { display: flex; align-items: center; gap: 16px; }\n.past-top img.thumb {\n  width: 44px;\n  height: 44px;\n  flex-shrink: 0;\n  object-fit: cover;\n  border-radius: 10px;\n  background: #f1f2f4;\n}\n.past-id { flex: 1; min-width: 0; }\n.past-id h3 {\n  margin: 0 0 4px;\n  font-size: 15.5px;\n  font-weight: 700;\n  letter-spacing: -0.15px;\n  color: #182235;\n}\n.past-state { width: 240px; flex-shrink: 0; display: flex; align-items: center; gap: 12px; }\n.status-chip {\n  display: inline-flex;\n  align-items: center;\n  justify-content: flex-start;\n  min-width: 104px;\n  gap: 6px;\n  padding: 5px 9px;\n  border-radius: 6px;\n  font-size: 12px;\n  font-weight: 700;\n  white-space: nowrap;\n}\n.status-chip .g { font-size: 11px; line-height: 1; }\n.chip-delivered { background: #e9f7ef; color: #07864b; }\n.chip-cancelled { background: #fdebed; color: #ce2231; }\n.past-total {\n  width: 138px;\n  flex-shrink: 0;\n  display: flex;\n  flex-direction: column;\n  align-items: flex-end;\n  gap: 3px;\n}\n.past-total span { font-size: 12px; font-weight: 500; color: #6e7887; }\n.past-total strong { font-size: 18px; font-weight: 800; letter-spacing: -0.3px; color: #131c2b; font-feature-settings: \"tnum\"; }\n\n.past-foot {\n  display: flex;\n  align-items: center;\n  gap: 22px;\n  margin-top: 11px;\n  padding-top: 11px;\n  border-top: 1px solid #f2f4f6;\n}\n.past-foot .items { gap: 18px; }\n.past-foot .item img { width: 34px; height: 34px; border-radius: 8px; }\n.past-foot .item-name span { font-size: 12.5px; }\n.past-foot .item-name small { font-size: 11.5px; }\n.past-foot .payment { margin-right: 2px; }\n</style>\n<nav class=\"navbar\" data-kid=\"1\" data-name=\"site top navigation bar\">\n<div class=\"navbar-inner\" data-kid=\"1-1\" data-name=\"navigation toolbar layout\">\n<a class=\"brand\" data-kid=\"1-1-1\" data-name=\"brand logo link\" href=\"#\"><img alt=\"ZIPBITE\" data-kid=\"1-1-1-1\" data-name=\"brand logo image\" src=\"/api/local/images/frontend/public/logox.png\"/></a>\n<div class=\"nav-middle\" data-kid=\"1-1-2\" data-name=\"navigation middle section\">\n<ul class=\"nav-links\" data-kid=\"1-1-2-1\" data-name=\"primary navigation links\">\n<li data-kid=\"1-1-2-1-1\" data-name=\"home navigation link\"><a data-kid=\"1-1-2-1-1-1\" data-name=\"Home link\" href=\"#\">Home</a></li>\n<li data-kid=\"1-1-2-1-2\" data-name=\"menu navigation link\"><a data-kid=\"1-1-2-1-2-1\" data-name=\"Menu link\" href=\"#\">Menu</a></li>\n<li data-kid=\"1-1-2-1-3\" data-name=\"restaurants navigation link\"><a data-kid=\"1-1-2-1-3-1\" data-name=\"Restaurants link\" href=\"#\">Restaurants</a></li>\n<li data-kid=\"1-1-2-1-4\" data-name=\"offers navigation link\"><a data-kid=\"1-1-2-1-4-1\" data-name=\"Offers link\" href=\"#\">Offers</a></li>\n<li data-kid=\"1-1-2-1-5\" data-name=\"FAQ navigation link\"><a data-kid=\"1-1-2-1-5-1\" data-name=\"FAQ link\" href=\"#\">FAQ</a></li>\n<li data-kid=\"1-1-2-1-6\" data-name=\"contact navigation link\"><a data-kid=\"1-1-2-1-6-1\" data-name=\"Contact link\" href=\"#\">Contact</a></li>\n<li data-kid=\"1-1-2-1-7\" data-name=\"cart navigation link\"><a aria-label=\"Cart\" data-kid=\"1-1-2-1-7-1\" data-name=\"cart icon link\" href=\"#\"><i class=\"mdi mdi-cart-outline nav-cart\" data-kid=\"1-1-2-1-7-1-1\" data-name=\"cart outline icon\"></i></a></li>\n</ul>\n<div class=\"nav-actions\" data-kid=\"1-1-2-2\" data-name=\"navigation right action cluster\">\n<form class=\"nav-search\" data-kid=\"1-1-2-2-1\" data-name=\"navbar search form\">\n<input aria-label=\"Search food or restaurant\" data-kid=\"1-1-2-2-1-1\" data-name=\"navbar search input field\" placeholder=\"Search food...\" type=\"search\"/>\n<button aria-label=\"Search\" data-kid=\"1-1-2-2-1-2\" data-name=\"search submit button\" type=\"submit\"><i class=\"mdi mdi-magnify\" data-kid=\"1-1-2-2-1-2-1\" data-name=\"magnifier search icon\"></i></button>\n</form>\n<button class=\"nav-logout\" data-kid=\"1-1-2-2-2\" data-name=\"logout button\" type=\"button\">Logout <i class=\"mdi mdi-logout\" data-kid=\"1-1-2-2-2-1\" data-name=\"logout icon\"></i></button>\n</div>\n</div>\n</div>\n</nav>\n<div class=\"page\" data-kid=\"2\" data-name=\"main page content container\">\n<header class=\"page-head\" data-kid=\"2-1\" data-name=\"page header with title\">\n<h1 data-kid=\"2-1-1\" data-name=\"page heading\">My Orders</h1>\n<span class=\"order-count\" data-kid=\"2-1-2\" data-name=\"order count summary text\">5 orders</span>\n</header>\n<div class=\"toolbar\" data-kid=\"2-2\" data-name=\"toolbar
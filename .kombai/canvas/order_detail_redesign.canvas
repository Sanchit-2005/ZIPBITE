      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800&family=Manrope:wght@400;500;600;700;800&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css\");\n\n:root{\n  --ink:#15182e; --ink-2:#232846; --text:#1d2036; --muted:#7b7f95;\n  --line:#e8eaf3; --bg:#f3f4fa; --card:#fff; --accent:#ff7a2f; --accent-soft:#fff0e6;\n}\n* { box-sizing: border-box; }\nbody { margin: 0; background: #f3f4fa; color: #1d2036; font-family: \"Manrope\", system-ui, sans-serif; -webkit-font-smoothing: antialiased; }\n.od1-page { max-width: 1280px; margin: 0 auto; padding: 28px 32px 48px; }\n.ord1-back { display: inline-flex; align-items: center; gap: 8px; color: #6a6e86; font-size: 13px; font-weight: 700; text-decoration: none; margin-bottom: 16px; }\n.ord1-back i { font-size: 14px; }\n.ord1-back:hover { color: #e8651e; }\n.ord1-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 24px; margin-bottom: 20px; }\n.ord1-head h1 { font-family: \"Sora\", sans-serif; font-size: 27px; font-weight: 800; letter-spacing: -0.9px; margin: 0; }\n.ord1-meta { display: flex; align-items: center; gap: 12px; margin-top: 8px; color: #6a6e86; font-size: 13px; flex-wrap: wrap; }\n.ord1-meta .id { font-family: \"Sora\", sans-serif; font-size: 12px; font-weight: 700; color: #3a3e56; background: #fff; border: 1px solid #e8eaf3; padding: 4px 9px; border-radius: 7px; letter-spacing: 0.2px; }\n.ord1-meta .sep { width: 3px; height: 3px; border-radius: 50%; background: #b9bdcf; }\n.ord1-status { display: inline-flex; align-items: center; gap: 8px; padding: 9px 15px; border-radius: 999px; font-size: 11px; font-weight: 800; letter-spacing: 0.7px; white-space: nowrap; }\n.ord1-status span { width: 7px; height: 7px; border-radius: 50%; background: currentColor; }\n.ord1-status.placed { background: #fff3dc; color: #b8740a; }\n\n.ord1-grid { display: grid; grid-template-columns: minmax(0, 1fr) 424px; gap: 20px; align-items: start; }\n.ord1-card { background: #fff; border: 1px solid #e8eaf3; border-radius: 22px; }\n.ord1-items { padding: 24px 24px 22px; }\n.ord1-cardhead { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; margin-bottom: 6px; }\n.ord1-cardhead h2 { font-family: \"Sora\", sans-serif; font-size: 18px; font-weight: 700; letter-spacing: -0.4px; margin: 0; }\n.ord1-count { color: #7b7f95; font-size: 12px; font-weight: 700; }\n.ord1-thead, .ord1-row { display: grid; grid-template-columns: minmax(0, 1fr) 72px 116px; align-items: center; gap: 16px; }\n.ord1-thead { padding: 14px 0 10px; border-bottom: 1px solid #eef0f7; color: #8b8fa4; font-size: 10.5px; font-weight: 800; letter-spacing: 0.6px; }\n.ord1-thead .r { text-align: right; }\n.ord1-row { min-height: 92px; border-bottom: 1px solid #f1f3f9; }\n.ord1-row:last-child { border-bottom: none; }\n.ord1-item { display: flex; align-items: center; gap: 14px; min-width: 0; padding: 14px 0; }\n.ord1-item img { width: 52px; height: 52px; border-radius: 11px; object-fit: cover; background: #eef0f7; flex-shrink: 0; }\n.ord1-name { font-size: 14.5px; font-weight: 700; line-height: 1.35; overflow-wrap: anywhere; }\n.ord1-qty { font-size: 14px; font-weight: 800; color: #3a3e56; font-variant-numeric: tabular-nums; }\n.ord1-qty em { font-style: normal; color: #a2a6ba; font-weight: 700; margin-right: 2px; }\n.ord1-price { text-align: right; font-size: 14px; font-weight: 700; color: #3a3e56; font-variant-numeric: tabular-nums; }\n.ord1-note { display: flex; gap: 12px; margin-top: 18px; background: #fdf8f3; border: 1px solid #f6e6d7; border-radius: 12px; padding: 13px 15px; }\n.ord1-note i { color: #e8651e; font-size: 15px; margin-top: 2px; }\n.ord1-note span { display: block; font-size: 10.5px; font-weight: 800; letter-spacing: 0.5px; color: #a97b55; }\n.ord1-note p { margin: 3px 0 0; font-size: 13px; color: #4a4038; line-height: 1.5; }\n\n.ord1-rail { position: sticky; top: 20px; overflow: hidden; }\n.ord1-railsec { padding: 18px 22px; border-bottom: 1px solid #eef0f7; }\n.ord1-railsec:first-child { padding-top: 22px; }\n.ord1-railsec h3 { margin: 0 0 8px; font-size: 10.5px; font-weight: 800; letter-spacing: 0.8px; color: #8b8fa4; font-family: \"Manrope\", sans-serif; }\n.ord1-customer { display: flex; align-items: center; gap: 12px; }\n.ord1-avatar { width: 38px; height: 38px; border-radius: 50%; background: linear-gradient(135deg, #eceefb, #dfe3f7); color: #6670a3; display: grid; place-items: center; font-family: \"Sora\", sans-serif; font-size: 13px; font-weight: 700; flex-shrink: 0; }\n.ord1-customer .n { font-size: 15px; font-weight: 800; }\n.ord1-phone { display: inline-flex; align-items: center; gap: 7px; margin-top: 3px; color: #5d6179; font-size: 12.5px; font-weight: 600; text-decoration: none; }\n.ord1-phone i { color: #ff7a2f; font-size: 12px; }\n.ord1-landmark { margin: 0; font-size: 14px; font-weight: 700; line-height: 1.45; }\n.ord1-addr { margin: 3px 0 0; font-size: 13.5px; line-height: 1.55; color: #5d6179; }\n.ord1-pair { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }\n.ord1-pair h3 { margin-bottom: 6px; }\n.ord1-pair .v { font-family: \"Sora\", sans-serif; font-size: 16px; font-weight: 700; letter-spacing: -0.3px; }\n.ord1-pair .s { display: block; margin-top: 2px; color: #7b7f95; font-size: 12px; font-weight: 600; }\n.ord1-paid { display: inline-flex; align-items: center; gap: 6px; color: #139660; }\n.ord1-paid i { font-size: 13px; }\n.ord1-bill { padding-top: 18px; padding-bottom: 16px; }\n.ord1-line { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding: 4px 0; font-size: 13.5px; color: #5d6179; }\n.ord1-line b { font-weight: 700; color: #3a3e56; font-variant-numeric: tabular-nums; }\n.ord1-total { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; margin-top: 12px; padding-top: 14px; border-top: 1px solid #e8eaf3; }\n.ord1-total span { font-size: 13px; font-weight: 800; color: #3a3e56; }\n.ord1-total strong { font-family: \"Sora\", sans-serif; font-size: 24px; font-weight: 800; letter-spacing: -0.8px; font-variant-numeric: tabular-nums; }\n.ord1-actions { padding: 18px 22px 22px; display: grid; gap: 10px; }\n.ord1-accept { display: flex; align-items: center; justify-content: center; gap: 9px; height: 48px; border: none; border-radius: 12px; background: #ff7a2f; color: #fff; font-family: inherit; font-size: 14.5px; font-weight: 800; cursor: pointer; box-shadow: 0 10px 22px rgba(255,122,47,0.28); transition: background .18s, box-shadow .18s; }\n.ord1-accept:hover { background: #f26a1c; box-shadow: 0 12px 26px rgba(255,122,47,0.36); }\n.ord1-accept i { font-size: 16px; }\n.ord1-cancel { display: flex; align-items: center; justify-content: center; gap: 8px; height: 44px; border: 1px solid #f2d9d9; border-radius: 12px; background: #fff8f8; color: #c94a4a; font-family: inherit; font-size: 13.5px; font-weight: 800; cursor: pointer; transition: background .18s, border-color .18s; }\n.ord1-cancel:hover { background: #ffecec; border-color: #eebcbc; }\n.ord1-cancel i { font-size: 12px; }\n.ord1-accept:focus-visible, .ord1-cancel:focus-visible, .ord1-back:focus-visible { outline: 3px solid rgba(255,122,47,0.45); outline-offset: 2px; }\n</style>\n<div class=\"od1-page\" data-kid=\"1\" data-name=\"order details page layout\">\n<a class=\"ord1-back\" data-kid=\"1-1\" data-name=\"back to orders link\" href=\"#\"><i class=\"bi bi-arrow-left\" data-kid=\"1-1-1\" data-name=\"left arrow icon\"></i>Orders</a>\n<header class=\"ord1-head\" data-kid=\"1-2\" data-name=\"order header bar\">\n<div data-kid=\"1-2-1\" data-name=\"order title and metadata group\">\n<h1 data-kid=\"1-2-1-1\" data-name=\"order details heading\">Order details</h1>\n<div class=\"ord1-meta\" data-kid=\"1-2-1-2\" data-name=\"order number and date metadata\">\n<span class=\"id\" data-kid=\"1-2-1-2-1\" data-name=\"order ID badge\">#68f3a1c9e42b7d0a1f6c8e35</span>\n<span class=\"sep\" data-kid=\"1-2-1-2-2\" data-name=\"metadata separator dot\"></span>\n<span data-kid=\"1-2-1-2-3\" data-name=\"order placed date text\">Placed 5 November 2026, 1:42 PM</span>\n</div>\n</div>\n<span class=\"ord1-status placed\" data-kid=\"1-2-2\" data-name=\"order status pill\"><span data-kid=\"1-2-2-1\" data-name=\"status indicator dot\"></span>PLACED</span>\n</header>\n<div class=\"ord1-grid\" data-kid=\"1-3\" data-name=\"two column order content grid\">\n<section class=\"ord1-card ord1-items\" data-kid=\"1-3-1\" data-name=\"ordered items card\">\n<div class=\"ord1-cardhead\" data-kid=\"1-3-1-1\" data-name=\"items card header\">\n<h2 data-kid=\"1-3-1-1-1\" data-name=\"ordered items title\">Ordered items</h2>\n<span class=\"ord1-count\" data-kid=\"1-3-1-1-2\" data-name=\"item count label\">7 items</span>\n</div>\n<div class=\"ord1-thead\" data-kid=\"1-3-1-2\" data-name=\"items table header row\">\n<span data-kid=\"1-3-1-2-1\" data-name=\"item column header\">Item</span>\n<span data-kid=\"1-3-1-2-2\" data-name=\"quantity column header\">Qty</span>\n<span class=\"r\" data-kid=\"1-3-1-2-3\" data-name=\"unit price column header\">Unit price</span>\n</div>\n<div class=\"ord1-row\" data-kid=\"1-3-1-3\" data-name=\"order item row\">\n<div class=\"ord1-item\" data-kid=\"1-3-1-3-1\" data-name=\"item name and image group\">\n<img alt=\"Chicken Dum Biryani — Prabal Pratap Singh on Pexels\" data-kid=\"1-3-1-3-1-1\" data-name=\"item thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/9609860/pexels-photo-9609860.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=160&amp;q=80\"/>\n<span class=\"ord1-name\" data-kid=\"1-3-1-3-1-2\" data-name=\"item name text\">Chicken Dum Biryani (Full)</span>\n</div>\n<span class=\"ord1-qty\" data-kid=\"1-3-1-3-2\" data-name=\"item quantity value\"><em data-kid=\"1-3-1-3-2-1\" data-name=\"multiplication symbol\">×</em>2</span>\n<span class=\"ord1-price\" data-kid=\"1-3-1-3-3\" data-name=\"item unit price\">₹380.00</span>\n</div>\n<div class=\"ord1-row\" data-kid=\"1-3-1-4\" data-name=\"order item row\">\n<div class=\"ord1-item\" data-kid=\"1-3-1-4-1\" data-name=\"item name and image group\">\n<img alt=\"Paneer Butter Masala — dhiraj jain on Pexels\" data-kid=\"1-3-1-4-1-1\" data-name=\"item thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/12737805/pexels-photo-12737805.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=160&amp;q=80\"/>\n<span class=\"ord1-name\" data-kid=\"1-3-1-4-1-2\" data-name=\"item name text\">Paneer Butter Masala</span>\n</div>\n<span class=\"ord1-qty\" data-kid=\"1-3-1-4-2\" data-name=\"item quantity value\"><em data-kid=\"1-3-1-4-2-1\" data-name=\"multiplication symbol\">×</em>1</span>\n<span class=\"ord1-price\" data-kid=\"1-3-1-4-3\" data-name=\"item unit price\">₹320.00</span>\n</div>\n<div class=\"ord1-row\" data-kid=\"1-3-1-5\" data-name=\"order item row\">\n<div class=\"ord1-item\" data-kid=\"1-3-1-5-1\" data-name=\"item name and image group\">\n<img alt=\"Butter Naan — Gözde Z. on Pexels\" data-kid=\"1-3-1-5-1-1\" data-name=\"item thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/38163958/pexels-photo-38163958.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=160&amp;q=80\"/>\n<span class=\"ord1-name\" data-kid=\"1-3-1-5-1-2\" data-name=\"item name text\">Butter Naan</span>\n</div>\n<span class=\"ord1-qty\" data-kid=\"1-3-1-5-2\" data-name=\"item quantity value\"><em data-kid=\"1-3-1-5-2-1\" data-name=\"multiplication symbol\">×</em>3</span>\n<span class=\"ord1-price\" data-kid=\"1-3-1-5-3\" data-name=\"item unit price\">₹55.00</span>\n</div>\n<div class=\"ord1-row\" data-kid=\"1-3-1-6\" data-name=\"order item row\">\n<div class=\"ord1-item\" data-kid=\"1-3-1-6-1\" data-name=\"item name and image group\">\n<img alt=\"Gulab Jamun — Kiran on Pexels\" data-kid=\"1-3-1-6-1-1\" data-name=\"item thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/7406887/pexels-photo-7406887.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=160&amp;q=80\"/>\n<span class=\"ord1-name\" data-kid=\"1-3-1-6-1-2\" data-name=\"item name text\">Gulab Jamun (2 pcs)</span>\n</div>\n<span class=\"ord1-qty\" data-kid=\"1-3-1-6-2\" data-name=\"item quantity value\"><em data-kid=\"1-3-1-6-2-1\" data-name=\"multiplication symbol\">×</em>1</span>\n<span class=\"ord1-price\" data-kid=\"1-3-1-6-3\" data-name=\"item unit price\">₹120.00</span>\n</div>\n<div class=\"ord1-note\" data-kid=\"1-3-1-7\" data-name=\"order instructions note banner\">\n<i class=\"bi bi-chat-left-text\" data-kid=\"1-3-1-7-1\" data-name=\"chat message icon\"></i>\n<div data-kid=\"1-3-1-7-2\" data-name=\"order instructions text group\">\n<span data-kid=\"1-3-1-7-2-1\" data-name=\"order instructions label\">ORDER INSTRUCTIONS</span>\n<p data-kid=\"1-3-1-7-2-2\" data-name=\"order instructions description\">Less spicy. Pack the naan separately.</p>\n</div>\n</div>\n</section>\n<aside class=\"ord1-card ord1-rail\" data-kid=\"1-3-2\" data-name=\"order summary sidebar\">\n<section class=\"ord1-railsec\" data-kid=\"1-3-2-1\" data-name=\"customer info section\">\n<h3 data-kid=\"1-3-2-1-1\" data-name=\"customer section label\">CUSTOMER</h3>\n<div class=\"ord1-customer\" data-kid=\"1-3-2-1-2\" data-name=\"customer identity row\">\n<span class=\"ord1-avatar\" data-kid=\"1-3-2-1-2-1\" data-name=\"customer initials avatar\">AM</span>\n<div data-kid=\"1-3-2-1-2-2\" data-name=\"customer name and contact group\">\n<div class=\"n\" data-kid=\"1-3-2-1-2-2-1\" data-name=\"customer name text\">Aarav Mehta</div>\n<a class=\"ord1-phone\" data-kid=\"1-3-2-1-2-2-2\" data-name=\"customer phone link\" href=\"tel:+919820455671\"><i class=\"bi bi-telephone\" data-kid=\"1-3-2-1-2-2-2-1\" data-name=\"telephone icon\"></i>+91 98204 55671</a>\n</div>\n</div>\n</section>\n<section class=\"ord1-railsec\" data-kid=\"1-3-2-2\" data-name=\"delivery address section\">\n<h3 data-kid=\"1-3-2-2-1\" data-name=\"delivery address section label\">DELIVERY ADDRESS</h3>\n<p class=\"ord1-landmark\" data-kid=\"1-3-2-2-2\" data-name=\"neighborhood landmark text\">Opposite Bandra Police Station</p>\n<p class=\"ord1-addr\" data-kid=\"1-3-2-2-3\" data-name=\"street address text\">402, Sunrose Apartments, Turner Road<br data-kid=\"1-3-2-2-3-1\" data-name=\"address line break\"/>Mumbai, Maharashtra 400050</p>\n</section>\n<section class=\"ord1-railsec ord1-pair\" data-kid=\"1-3-2-3\" data-name=\"delivery and payment info section\">\n<div data-kid=\"1-3-2-3-1\" data-name=\"estimated delivery group\">\n<h3 data-kid=\"1-3-2-3-1-1\" data-name=\"estimated delivery label\">ESTIMATED DELIVERY</h3>\n<div class=\"v\" data-kid=\"1-3-2-3-1-2\" data-name=\"estimated delivery time\">02:30 PM</div>\n<span class=\"s\" data-kid=\"1-3-2-3-1-3\" data-name=\"estimated delivery date\">5 Nov 2026</span>\n</div>\n<div data-kid=\"1-3-2-3-2\" data-name=\"payment group\">\n<h3 data-kid=\"1-3-2-3-2-1\" data-name=\"payment label\">PAYMENT</h3>\n<div class=\"v\" data-kid=\"1-3-2-3-2-2\" data-name=\"payment method value\" style=\"font-size:15px;\">ONLINE</div>\n<span class=\"s ord1-paid\" data-kid=\"1-3-2-3-2-3\" data-name=\"paid status indicator\"><i class=\"bi bi-check-circle-fill\" data-kid=\"1-3-2-3-2-3-1\" data-name=\"green checkmark icon\"></i>PAID</span>\n</div>\n</section>\n<section class=\"ord1-railsec ord1-bill\" data-kid=\"1-3-2-4\" data-name=\"bill section\">\n<h3 data-kid=\"1-3-2-4-1\" data-name=\"bill section label\">BILL</h3>\n<div class=\"ord1-line\" data-kid=\"1-3-2-4-2\" data-name=\"subtotal bill line\"><span data-kid=\"1-3-2-4-2-1\" data-name=\"subtotal label\">Subtotal</span><b data-kid=\"1-3-2-4-2-2\" data-name=\"subtotal amount\">₹1,365.00</b></div>\n<div class=\"ord1-line\" data-kid=\"1-3-2-4-3\" data-name=\"delivery fee bill line\"><span data-kid=\"1-3-2-4-3-1\" data-name=\"delivery fee label\">Delivery fee</span><b data-kid=\"1-3-2-4-3-2\" data-name=\"delivery fee amount\">₹40.00</b></div>\n<div class=\"ord1-line\" data-kid=\"1-3-2-4-4\" data-name=\"tax bill line\"><span data-kid=\"1-3-2-4-4-1\" data-name=\"tax label\">Tax</span><b data-kid=\"1-3-2-4-4-2\" data-name=\"tax amount\">₹68.00</b></div>\n<div class=\"ord1-line\" data-kid=\"1-3-2-4-5\" data-name=\"discount bill line\"><span data-kid=\"1-3-2-4-5-1\" data-name=\"discount label\">Discount</span><b data-kid=\"1-3-2-4-5-2\" data-name=\"discount amount\">−₹50.00</b></div>\n<div class=\"ord1-total\" data-kid=\"1-3-2-4-6\" data-name=\"order total row\"><span data-kid=\"1-3-2-4-6-1\" data-name=\"order total label\">Order total</span><strong data-kid=\"1-3-2-4-6-2\" data-name=\"order total amount\">₹1,423.00</strong></div>\n</section>\n<div class=\"ord1-actions\" data-kid=\"1-3-2-5\" data-name=\"order action buttons container\">\n<button class=\"ord1-accept\" data-kid=\"1-3-2-5-1\" data-name=\"accept order button\">Accept order<i class=\"bi bi-check2\" data-kid=\"1-3-2-5-1-1\" data-name=\"checkmark icon\"></i></button>\n<button class=\"ord1-cancel\" data-kid=\"1-3-2-5-2\" data-name=\"cancel order button\"><i class=\"bi bi-x-lg\" data-kid=\"1-3-2-5-2-1\" data-name=\"close X icon\"></i>Cancel order</button>\n</div>\n</aside>\n</div>\n</div>",

    "var_7f1a8d62455b": {
      "type": "variant",
      "label": "Receipt spine — orders",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 9730,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');\n  @import url(\"https://cdn.jsdelivr.net/npm/@mdi/font@7.4.47/css/materialdesignicons.min.css\");\n\n  body {\n    margin: 0;\n    background: #f7f8fa;\n    font-family: 'Inter', Arial, Helvetica, sans-serif;\n    color: #141c2b;\n    -webkit-font-smoothing: antialiased;\n  }\n\n  .zp {\n    --ink: #141c2b;\n    --muted: #687181;\n    --line: #e7e9ed;\n    --hair: #f0f1f3;\n    --orange: #f06428;\n    --ground: #f7f8fa;\n    min-height: 100vh;\n    background: var(--ground);\n  }\n\n  .zp *,\n  .zp *::before,\n  .zp *::after { box-sizing: border-box; }\n\n  .zp h1,\n  .zp h2,\n  .zp p,\n  .zp ul,\n  .zp ol,\n  .zp li { margin: 0; padding: 0; }\n\n  .zp ul,\n  .zp ol { list-style: none; }\n\n  /* ---------- navbar (unchanged app shell) ---------- */\n  .nav {\n    position: sticky;\n    top: 0;\n    z-index: 20;\n    background: #ffffff;\n    border-bottom: 1px solid #f0eeeb;\n    box-shadow: 0 4px 18px rgba(35, 27, 17, 0.05);\n  }\n\n  .nav-inner {\n    max-width: 1400px;\n    min-height: 88px;\n    margin: 0 auto;\n    padding: 10px 40px;\n    display: flex;\n    align-items: center;\n    gap: 24px;\n  }\n\n  .brand { display: flex; align-items: center; flex-shrink: 0; }\n\n  .brand img {\n    display: block;\n    width: auto;\n    height: 70px;\n    max-width: 155px;\n    object-fit: contain;\n  }\n\n  .nav-body {\n    flex: 1;\n    min-width: 0;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 22px;\n  }\n\n  .nav-links {\n    display: flex;\n    align-items: center;\n    gap: 26px;\n    margin: 0 auto;\n  }\n\n  .nav-links a {\n    display: inline-flex;\n    align-items: center;\n    padding: 12px 0;\n    color: #333333;\n    font-size: 15px;\n    font-weight: 600;\n    text-decoration: none;\n  }\n\n  .nav-links a i { font-size: 20px; }\n\n  .nav-actions {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    flex-shrink: 0;\n  }\n\n  .nav-search {\n    display: flex;\n    align-items: center;\n    width: 230px;\n    padding: 4px 5px 4px 15px;\n    border: 1px solid #e9e5e1;\n    border-radius: 30px;\n    background: #f8f8f8;\n  }\n\n  .nav-search input {\n    flex: 1;\n    min-width: 0;\n    padding: 9px 0;\n    border: 0;\n    outline: 0;\n    background: transparent;\n    font-family: inherit;\n    font-size: 13.5px;\n    color: #242424;\n  }\n\n  .nav-search input::placeholder { color: #898989; }\n\n  .nav-search button {\n    display: grid;\n    place-items: center;\n    width: 34px;\n    height: 34px;\n    flex-shrink: 0;\n    padding: 0;\n    border: 0;\n    border-radius: 50%;\n    background: #fff0e7;\n    color: #ed5b22;\n    font-size: 18px;\n    cursor: pointer;\n  }\n\n  .nav-login {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    min-height: 42px;\n    padding: 0 20px;\n    border: 1px solid var(--orange);\n    border-radius: 30px;\n    background: var(--orange);\n    color: #ffffff;\n    font-family: inherit;\n    font-size: 14px;\n    font-weight: 700;\n    cursor: pointer;\n  }\n\n  .nav-login i { font-size: 17px; }\n\n  /* ---------- page ---------- */\n  .page {\n    max-width: 1400px;\n    margin: 0 auto;\n    padding: 30px 40px 56px;\n  }\n\n  .head {\n    display: flex;\n    align-items: flex-end;\n    justify-content: space-between;\n    gap: 20px;\n    margin-bottom: 18px;\n  }\n\n  .head h1 {\n    font-size: 27px;\n    font-weight: 700;\n    letter-spacing: -0.7px;\n    line-height: 1.1;\n  }\n\n  .count { display: flex; align-items: baseline; gap: 6px; }\n\n  .count b {\n    font-size: 20px;\n    font-weight: 700;\n    letter-spacing: -0.4px;\n    font-variant-numeric: tabular-nums;\n  }\n\n  .count span {\n    font-size: 12.5px;\n    font-weight: 500;\n    color: var(--muted);\n  }\n\n  .toolbar {\n    display: flex;\n    align-items: flex-end;\n    justify-content: space-between;\n    gap: 24px;\n    margin-bottom: 16px;\n  }\n\n  .tabs { display: flex; gap: 26px; }\n\n  .tab {\n    display: inline-flex;\n    align-items: center;\n    gap: 7px;\n    padding: 0 2px 12px;\n    border: 0;\n    border-bottom: 2px solid transparent;\n    background: transparent;\n    color: #5e6673;\n    font-family: inherit;\n    font-size: 13.5px;\n    font-weight: 600;\n    cursor: pointer;\n  }\n\n  .tab.active {\n    color: var(--orange);\n    border-bottom-color: var(--orange);\n  }\n\n  .chip {\n    display: inline-grid;\n    place-items: center;\n    min-width: 20px;\n    height: 20px;\n    padding: 0 6px;\n    border-radius: 999px;\n    background: #fff1e6;\n    color: #e2540f;\n    font-size: 11px;\n    font-weight: 700;\n    font-variant-numeric: tabular-nums;\n  }\n\n  .tab.active .chip { background: var(--orange); color: #ffffff; }\n\n  .search {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    width: 320px;\n    height: 44px;\n    flex-shrink: 0;\n    padding: 0 14px;\n    border: 1px solid #e3e6ea;\n    border-radius: 10px;\n    background: #ffffff;\n    color: #8a93a1;\n  }\n\n  .search i { font-size: 18px; }\n\n  .search input {\n    flex: 1;\n    min-width: 0;\n    border: 0;\n    outline: 0;\n    background: transparent;\n    font-family: inherit;\n    font-size: 13px;\n    color: var(--ink);\n  }\n\n  .search input::placeholder { color: #8a93a1; }\n\n  .list {\n    display: flex;\n    flex-direction: column;\n    gap: 14px;\n  }\n\n  /* ---------- article shell ---------- */\n  .card {\n    padding: 16px 20px;\n    border: 1px solid var(--line);\n    border-radius: 12px;\n    background: #ffffff;\n    box-shadow: 0 2px 6px rgba(20, 28, 43, 0.03);\n  }\n\n  .card.ongoing { border-color: #ffdcc5; }\n\n  /* ---------- live order: receipt + vertical spine ---------- */\n  .grid {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) 264px;\n    gap: 26px;\n  }\n\n  .receipt {\n    display: flex;\n    flex-direction: column;\n    min-width: 0;\n  }\n\n  .identity {\n    display: grid;\n    grid-template-columns: 60px minmax(0, 1fr);\n    gap: 14px;\n    align-items: center;\n  }\n\n  .r-img {\n    display: block;\n    width: 60px;\n    height: 60px;\n    border-radius: 10px;\n    object-fit: cover;\n    background: #f1f2f4;\n  }\n\n  .r-name {\n    overflow: hidden;\n    font-size: 16.5px;\n    font-weight: 700;\n    letter-spacing: -0.2px;\n    line-height: 1.25;\n    white-space: nowrap;\n    text-overflow: ellipsis;\n  }\n\n  .r-meta {\n    margin-top: 3px !important;\n    overflow: hidden;\n    color: var(--muted);\n    font-size: 12px;\n    line-height: 1.35;\n    white-space: nowrap;\n    text-overflow: ellipsis;\n  }\n\n  .items {\n    display: flex;\n    flex-direction: column;\n    width: 100%;\n    max-width: 460px;\n    margin-top: 14px;\n    margin-bottom: 16px;\n  }\n\n  .items .item { grid-template-columns: 36px 208px 40px; }\n\n  .items .item-qty { text-align: right; }\n\n  .item {\n    display: grid;\n    grid-template-columns: 36px minmax(0, 1fr) auto;\n    gap: 12px;\n    align-items: center;\n    min-height: 44px;\n  }\n\n  .item img {\n    display: block;\n    width: 36px;\n    height: 36px;\n    border-radius: 8px;\n    object-fit: cover;\n    background: #f1f2f4;\n  }\n\n  .item-name {\n    overflow: hidden;\n    color: #283244;\n    font-size: 13.5px;\n    font-weight: 600;\n    white-space: nowrap;\n    text-overflow: ellipsis;\n  }\n\n  .item-qty {\n    color: #7a8290;\n    font-size: 12.5px;\n    font-weight: 500;\n    font-variant-numeric: tabular-nums;\n    white-space: nowrap;\n  }\n\n  .foot {\n    display: flex;\n    align-items: flex-end;\n    justify-content: space-between;\n    gap: 20px;\n    margin-top: auto;\n    padding-top: 14px;\n    border-top: 1px solid var(--hair);\n  }\n\n  .pay { color: #747c8a; font-size: 12px; }\n\n  .pay strong {\n    color: #303b4d;\n    font-weight: 600;\n    letter-spacing: 0.02em;\n  }\n\n  .foot-right {\n    display: flex;\n    align-items: center;\n    gap: 18px;\n  }\n\n  .total {\n    display: flex;\n    flex-direction: column;\n    align-items: flex-end;\n    gap: 2px;\n  }\n\n  .total span { color: #747c8a; font-size: 11.5px; }\n\n  .total strong {\n    font-size: 19px;\n    font-weight: 700;\n    letter-spacing: -0.4px;\n    font-variant-numeric: tabular-nums;\n  }\n\n  .btn {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 2px;\n    height: 40px;\n    padding: 0 14px;\n    border-radius: 8px;\n    font-family: inherit;\n    font-size: 12.5px;\n    font-weight: 600;\n    white-space: nowrap;\n    cursor: pointer;\n  }\n\n  .btn-quiet {\n    border: 1px solid #dce0e6;\n    background: #ffffff;\n    color: var(--ink);\n  }\n\n  .btn-quiet i {\n    margin-right: -4px;\n    font-size: 18px;\n    color: #7c8492;\n  }\n\n  .btn-reorder {\n    border: 1px solid #f5c4a8;\n    background: #fff6f0;\n    color: #d9530f;\n  }\n\n  /* spine column */\n  .fulfil {\n    display: flex;\n    flex-direction: column;\n    gap: 12px;\n    padding-left: 24px;\n    border-left: 1px solid #eceef1;\n  }\n\n  .badge {\n    display: inline-flex;\n    align-items: center;\n    align-self: flex-start;\n    gap: 6px;\n    padding: 7px 11px;\n    border-radius: 8px;\n    font-size: 12.5px;\n    font-weight: 700;\n    line-height: 1;\n    white-space: nowrap;\n  }\n\n  .badge .b-ico { font-size: 12px; }\n\n  .badge-ongoing { background: #fff0e5; color: #e2530b; }\n  .badge-delivered { background: #e7f6ee; color: #067647; }\n  .badge-cancelled { background: #fee4e2; color: #d92d20; }\n\n  .spine { display: flex; flex-direction: column; margin-top: 2px; }\n\n  .step {\n    position: relative;\n    display: flex;\n    align-items: center;\n    min-height: 52px;\n  }\n\n  .spine .step { padding-left: 44px; }\n\n  .step .dot {\n    position: absolute;\n    left: 0;\n    top: 50%;\n    margin-top: -14px;\n    display: grid;\n    place-items: center;\n    width: 28px;\n    height: 28px;\n    border: 1px solid #dde1e6;\n    border-radius: 50%;\n    background: #ffffff;\n    color: #98a0ac;\n    font-size: 11.5px;\n    font-weight: 600;\n  }\n\n  .step:not(:last-child)::after {\n    content: \"\";\n    position: absolute;\n    left: 13px;\n    top: calc(50% + 14px);\n    width: 2px;\n    height: 24px;\n    background: #e1e4e9;\n  }\n\n  .step.done .dot {\n    border-color: var(--orange);\n    background: var(--orange);\n    color: #ffffff;\n  }\n\n  .step.done::after { background: var(--orange); }\n\n  .step.current .dot {\n    border: 2px solid var(--orange);\n    color: var(--orange);\n    font-weight: 700;\n  }\n\n  .step .lbl {\n    color: #8b929e;\n    font-size: 13.5px;\n    font-weight: 500;\n    line-height: 1.25;\n  }\n\n  .step.done .lbl { color: #3b4453; }\n\n  .step.current .lbl {\n    color: var(--orange);\n    font-weight: 700;\n  }\n\n  /* ---------- past order: compact receipt row ---------- */\n  .term {\n    display: grid;\n    grid-template-columns: 262px minmax(0, 1fr) 128px 112px auto;\n    gap: 22px;\n    align-items: center;\n  }\n\n  .term .identity {\n    grid-template-columns: 52px minmax(0, 1fr);\n    gap: 12px;\n  }\n\n  .term .r-img {\n    width: 52px;\n    height: 52px;\n    border-radius: 9px;\n  }\n\n  .term .r-name { font-size: 15px; }\n\n  .term .r-meta { font-size: 11.5px; }\n\n  .term-items {\n    display: flex;\n    flex-direction: column;\n    max-width: 360px;\n    gap: 2px;\n    min-width: 0;\n  }\n\n  .term-items .item {\n    grid-template-columns: 28px minmax(0, 1fr) auto;\n    gap: 10px;\n    min-height: 32px;\n  }\n\n  .term-items .item img {\n    width: 28px;\n    height: 28px;\n    border-radius: 6px;\n  }\n\n  .term-items .item-name { font-size: 13px; font-weight: 500; }\n  .term-items .item-qty { font-size: 12px; }\n\n  .term-status {\n    display: flex;\n    flex-direction: column;\n    align-items: flex-start;\n    gap: 7px;\n  }\n\n  .term-total {\n    display: flex;\n    flex-direction: column;\n    align-items: flex-end;\n    gap: 2px;\n  }\n\n  .term-total span { color: #747c8a; font-size: 11.5px; }\n\n  .term-total strong {\n    font-size: 17px;\n    font-weight: 700;\n    letter-spacing: -0.3px;\n    font-variant-numeric: tabular-nums;\n  }\n\n  .term-actions {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    justify-self: end;\n  }\n</style>\n<div class=\"zp\" data-kid=\"1\" data-name=\"page layout root\">\n<nav class=\"nav\" data-kid=\"1-1\" data-name=\"sticky app header navigation\">\n<div class=\"nav-inner\" data-kid=\"1-1-1\" data-name=\"nav inner layout bar\">\n<div class=\"brand\" data-kid=\"1-1-1-1\" data-name=\"brand logo container\">\n<img alt=\"ZIPBITE\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo image\" src=\"/api/local/images/frontend/public/logox.png\"/>\n</div>\n<div class=\"nav-body\" data-kid=\"1-1-1-2\" data-name=\"nav body flex row\">\n<ul class=\"nav-links\" data-kid=\"1-1-1-2-1\" data-name=\"main navigation links list\">\n<li data-kid=\"1-1-1-2-1-1\" data-name=\"navigation list item\"><a data-kid=\"1-1-1-2-1-1-1\" data-name=\"Home nav link\" href=\"#\">Home</a></li>\n<li data-kid=\"1-1-1-2-1-2\" data-name=\"navigation list item\"><a data-kid=\"1-1-1-2-1-2-1\" data-name=\"Menu nav link\" href=\"#\">Menu</a></li>\n<li data-kid=\"1-1-1-2-1-3\" data-name=\"navigation list item\"><a data-kid=\"1-1-1-2-1-3-1\" data-name=\"Restaurants nav link\" href=\"#\">Restaurants</a></li>\n<li data-kid=\"1-1-1-2-1-4\" data-name=\"navigation list item\"><a data-kid=\"1-1-1-2-1-4-1\" data-name=\"Offers nav link\" href=\"#\">Offers</a></li>\n<li data-kid=\"1-1-1-2-1-5\" data-name=\"navigation list item\"><a data-kid=\"1-1-1-2-1-5-1\" data-name=\"FAQ nav link\" href=\"#\">FAQ</a></li>\n<li data-kid=\"1-1-1-2-1-6\" data-name=\"navigation list item\"><a data-kid=\"1-1-1-2-1-6-1\" data-name=\"Contact nav link\" href=\"#\">Contact</a></li>\n<li data-kid=\"1-1-1-2-1-7\" data-name=\"navigation list item\"><a aria-label=\"Cart\
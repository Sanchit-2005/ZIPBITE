    "var_116b85d3c916": {
      "type": "variant",
      "label": "Order ledger — orders",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 3570,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/@mdi/font@7.4.47/css/materialdesignicons.min.css\");\n\n*{box-sizing:border-box;}\nbody{\n  margin:0;\n  background:#F7F8FA;\n  color:#182235;\n  font-family:'Inter',Arial,Helvetica,sans-serif;\n  -webkit-font-smoothing:antialiased;\n}\nimg{display:block;}\na{text-decoration:none;color:inherit;}\nbutton{font-family:inherit;cursor:pointer;}\ninput{font-family:inherit;}\n\n/* ---------- existing ZIPBITE navbar, unchanged ---------- */\n.z-nav{background:#fff;border-bottom:1px solid #F0EEEB;box-shadow:0 4px 18px rgba(35,27,17,.05);}\n.z-nav-inner{max-width:1600px;margin:0 auto;min-height:88px;padding:10px 40px;display:flex;align-items:center;gap:28px;}\n.z-brand{display:inline-flex;align-items:center;flex-shrink:0;}\n.z-brand img{height:70px;width:auto;max-width:155px;object-fit:contain;}\n.z-links{display:flex;align-items:center;gap:26px;list-style:none;margin:0 auto;padding:0;}\n.z-links li{margin:0;padding:0;}\n.z-links a{display:inline-flex;align-items:center;font-size:15px;font-weight:600;color:#333;padding:12px 0;transition:color .18s ease;}\n.z-links a:hover{color:#F06428;}\n.z-links a i{font-size:20px;color:#333;}\n.z-links a:hover i{color:#F06428;}\n.z-actions{display:flex;align-items:center;gap:12px;flex-shrink:0;}\n.z-search{display:flex;align-items:center;width:236px;padding:4px 5px 4px 15px;border:1px solid #E9E5E1;border-radius:30px;background:#F8F8F8;}\n.z-search input{display:block;width:100%;min-width:0;padding:9px 0;border:0;outline:0;background:transparent;color:#242424;font-size:14px;}\n.z-search input::placeholder{color:#898989;}\n.z-search-btn{display:grid;place-items:center;flex-shrink:0;width:36px;height:36px;padding:0;border:0;border-radius:50%;background:#FFF0E7;color:#ED5B22;font-size:18px;transition:background .18s ease,color .18s ease;}\n.z-search-btn:hover{background:#F06428;color:#fff;}\n.z-login{display:inline-flex;align-items:center;justify-content:center;gap:8px;flex-shrink:0;min-height:44px;padding:0 22px;border:1px solid #F06428;border-radius:30px;background:#F06428;color:#fff;font-size:14.5px;font-weight:700;white-space:nowrap;}\n.z-login i{font-size:17px;}\n\n/* ---------- page ---------- */\n.page{padding:32px 40px 56px;}\n.shell{max-width:1360px;margin:0 auto;}\n\n.page-head{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;}\n.page-head h1{margin:0;font-size:30px;line-height:1.08;font-weight:800;letter-spacing:-.9px;color:#141C2B;}\n.head-count{margin:0 0 2px;display:flex;align-items:baseline;gap:5px;font-size:13px;color:#77808F;}\n.head-count b{font-size:15px;font-weight:700;color:#2A3446;}\n\n.toolbar{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin-top:18px;border-bottom:1px solid #E7E9ED;}\n.tabs{display:flex;align-items:flex-end;gap:26px;}\n.tab{position:relative;display:inline-flex;align-items:center;gap:7px;padding:8px 1px 13px;border:0;background:none;font-size:13.5px;font-weight:600;color:#5A6474;transition:color .18s ease;}\n.tab:hover{color:#E95B0A;}\n.tab.active{color:#DE540E;}\n.tab.active::after{content:\"\";position:absolute;left:0;right:0;bottom:-1px;height:2px;border-radius:2px;background:#F06428;}\n.tab-count{display:inline-grid;place-items:center;min-width:19px;height:19px;padding:0 5px;border-radius:6px;background:#EFF1F5;color:#5A6474;font-size:11px;font-weight:700;}\n.tab.active .tab-count{background:#FFE6D5;color:#D9500F;}\n.orders-search{display:flex;align-items:center;gap:9px;width:320px;height:42px;margin-bottom:8px;padding:0 13px;border:1px solid #E3E6EB;border-radius:10px;background:#fff;color:#8A93A2;}\n.orders-search i{font-size:17px;flex-shrink:0;}\n.orders-search input{width:100%;border:0;outline:0;background:transparent;font-size:13px;color:#182235;}\n.orders-search input::placeholder{color:#98A0AE;}\n\n/* ---------- one shared ledger surface ---------- */\n.ledger{margin-top:16px;background:#fff;border:1px solid #E7E9ED;border-radius:16px;overflow:hidden;box-shadow:0 2px 10px rgba(24,34,53,.03);}\n.rec + .rec{border-top:1px solid #EEF0F3;}\n.rec-body{padding:16px 20px;transition:background .18s ease;}\n.rec:hover .rec-body{background:#FCFCFD;}\n.rec-meta{display:grid;grid-template-columns:minmax(280px,1fr) 198px 216px 172px;gap:24px;align-items:center;min-height:46px;}\n.identity{display:flex;align-items:center;gap:12px;min-width:0;}\n.r-thumb{width:46px;height:46px;flex-shrink:0;border-radius:12px;object-fit:cover;background:#F1F2F4;}\n.identity-text{min-width:0;}\n.identity-text h3{margin:0 0 3px;font-size:15px;font-weight:700;letter-spacing:-.2px;color:#182235;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}\n.oid{margin:0;font-size:11.5px;font-weight:500;letter-spacing:.3px;color:#7B8494;}\n.cell-date{display:flex;flex-direction:column;gap:2px;font-size:12.5px;line-height:1.4;color:#3A4557;font-variant-numeric:tabular-nums;}\n.cell-date .d-time{font-size:11.5px;color:#8A93A2;}\n.cell-state{display:flex;flex-direction:column;align-items:flex-start;gap:6px;}\n.badge{display:inline-flex;align-items:center;gap:6px;padding:5px 9px;border-radius:7px;font-size:11.5px;font-weight:700;white-space:nowrap;}\n.badge i{font-size:13px;line-height:1;}\n.badge.ongoing{background:#FFF0E5;color:#E95B0A;}\n.badge.delivered{background:#E5F8EF;color:#07864B;}\n.badge.cancelled{background:#FFEAEC;color:#D92332;}\n.pay{font-size:11.5px;color:#7B8494;letter-spacing:.1px;}\n.pay b{margin-left:3px;font-weight:700;color:#3A4557;}\n.cell-total{display:flex;flex-direction:column;align-items:flex-end;gap:2px;}\n.t-label{font-size:11px;color:#8A93A2;}\n.t-value{font-size:18px;font-weight:700;letter-spacing:-.4px;color:#182235;font-variant-numeric:tabular-nums;}\n\n.rec-items{display:flex;align-items:center;gap:20px;margin-top:9px;}\n.items{display:flex;align-items:center;flex-wrap:wrap;gap:10px 22px;flex:1;min-width:0;}\n.item{display:flex;align-items:center;gap:9px;}\n.item img{width:32px;height:32px;flex-shrink:0;border-radius:8px;object-fit:cover;background:#F1F2F4;}\n.iname{font-size:13px;font-weight:500;color:#2C374A;}\n.qty{font-size:11.5px;font-weight:600;color:#8A93A2;}\n.actions{display:flex;align-items:center;gap:8px;flex-shrink:0;}\n.btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:40px;padding:0 14px;border:1px solid transparent;border-radius:9px;font-size:12.5px;font-weight:600;white-space:nowrap;transition:background .18s ease,color .18s ease,border-color .18s ease;}\n.btn i{font-size:15px;line-height:1;}\n.btn.ghost{background:#fff;border-color:#DDE1E7;color:#2A3446;}\n.btn.ghost i{color:#9AA3B1;}\n.btn.ghost:hover{border-color:#F06428;color:#DE540E;}\n.btn.ghost:hover i{color:#F06428;}\n.btn.reorder{background:#FFF3EA;border-color:#FFDCC6;color:#D9500F;}\n.btn.reorder:hover{background:#F06428;border-color:#F06428;color:#fff;}\n\n/* ---------- fulfillment row, ongoing records only ---------- */\n.fulfil{padding:13px 20px 15px;border-top:1px solid #F7E4D5;background:#FFFBF7;}\n.track{position:relative;display:grid;grid-template-columns:repeat(4,1fr);max-width:860px;}\n.rail{position:absolute;top:13px;left:12.5%;right:12.5%;height:2px;border-radius:2px;background:#EBE3DC;}\n.rail-fill{position:absolute;top:13px;left:12.5%;height:2px;border-radius:2px;background:#F06428;}\n.w25{width:25%;}\n.w50{width:50%;}\n.step{position:relative;z-index:1;display:flex;flex-direction:column;align-items:center;gap:8px;}\n.dot{display:grid;place-items:center;width:28px;height:28px;border:2px solid #E1E4E9;border-radius:50%;background:#FFFBF7;color:#8B929E;font-size:11.5px;font-weight:700;}\n.dot i{font-size:14px;}\n.step.is-done .dot{border-color:#F06428;background:#F06428;color:#fff;}\n.step.is-current .dot{border-color:#F06428;background:#fff;color:#DE540E;font-weight:800;}\n.lbl{font-size:11.5px;font-weight:500;color:#8B929E;}\n.step.is-done .lb
=\"view details button\" type=\"button\">View Details <i class=\"mdi mdi-chevron-right\" data-kid=\"2-1-3-3-1-2-2-1-1\" data-name=\"chevron right icon\"></i></button>\n<button class=\"btn reorder\" data-kid=\"2-1-3-3-1-2-2-2\" data-name=\"reorder button\" type=\"button\"><i class=\"mdi mdi-refresh\" data-kid=\"2-1-3-3-1-2-2-2-1\" data-name=\"refresh reorder icon\"></i>Reorder</button>\n</div>\n</div>\n</div>\n</article>\n<!-- 4. cancelled -->\n<article class=\"rec\" data-kid=\"2-1-3-4\" data-name=\"order record card with cancelled status\">\n<div class=\"rec-body\" data-kid=\"2-1-3-4-1\" data-name=\"order record body\">\n<div class=\"rec-meta\" data-kid=\"2-1-3-4-1-1\" data-name=\"order record meta grid\">\n<div class=\"identity\" data-kid=\"2-1-3-4-1-1-1\" data-name=\"restaurant identity block\">\n<img alt=\"Wok &amp; Roll, photo by Prajwal on Pexels\" class=\"r-thumb\" data-kid=\"2-1-3-4-1-1-1-1\" data-name=\"restaurant thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/24499488/pexels-photo-24499488.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=320&amp;q=80\"/>\n<div class=\"identity-text\" data-kid=\"2-1-3-4-1-1-1-2\" data-name=\"restaurant identity text block\">\n<h3 data-kid=\"2-1-3-4-1-1-1-2-1\" data-name=\"restaurant name heading\">Wok &amp; Roll</h3>\n<p class=\"oid\" data-kid=\"2-1-3-4-1-1-1-2-2\" data-name=\"order ID number\">#A1D35E08</p>\n</div>\n</div>\n<div class=\"cell-date\" data-kid=\"2-1-3-4-1-1-2\" data-name=\"order date cell\"><span data-kid=\"2-1-3-4-1-1-2-1\" data-name=\"order date value\">28 Oct 2026</span><span class=\"d-time\" data-kid=\"2-1-3-4-1-1-2-2\" data-name=\"order time value\">08:31 pm</span></div>\n<div class=\"cell-state\" data-kid=\"2-1-3-4-1-1-3\" data-name=\"order status cell\">\n<span class=\"badge cancelled\" data-kid=\"2-1-3-4-1-1-3-1\" data-name=\"cancelled status badge\"><i class=\"mdi mdi-close\" data-kid=\"2-1-3-4-1-1-3-1-1\" data-name=\"close cancel icon\"></i>Cancelled</span>\n<spa
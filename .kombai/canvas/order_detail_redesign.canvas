      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/@mdi/font@7.4.47/css/materialdesignicons.min.css\");\n*{box-sizing:border-box}\nbody{margin:0;background:#F7F8FA;font-family:'Inter',Arial,Helvetica,sans-serif;color:#182235;-webkit-font-smoothing:antialiased}\n.shell{background:#F7F8FA;padding-bottom:44px}\n.nav{height:88px;background:#fff;border-bottom:1px solid #F0EEEB;box-shadow:0 4px 18px rgba(35,27,17,.05)}\n.nav-in{max-width:1400px;height:100%;margin:0 auto;padding:0 40px;display:flex;align-items:center;gap:24px}\n.brand img{display:block;height:66px;width:auto}\n.links{display:flex;align-items:center;gap:26px;list-style:none;margin:0 auto;padding:0}\n.links a{color:#333;text-decoration:none;font-size:15.5px;font-weight:600;white-space:nowrap}\n.links a.cart{display:inline-flex;align-items:center}\n.links a.cart i{font-size:22px;color:#333}\n.nav-actions{display:flex;align-items:center;gap:12px;flex-shrink:0}\n.nav-search{display:flex;align-items:center;width:232px;padding:3px 4px 3px 15px;border:1px solid #E9E5E1;border-radius:30px;background:#F8F8F8}\n.nav-search input{flex:1;min-width:0;border:0;outline:0;background:transparent;padding:8px 0;font-family:inherit;font-size:13.5px;color:#242424}\n.nav-search input::placeholder{color:#898989}\n.nav-search button{display:grid;place-items:center;width:34px;height:34px;border:0;border-radius:50%;background:#FFF0E7;color:#ED5B22;cursor:pointer;flex-shrink:0}\n.nav-search button i{font-size:18px}\n.login{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:42px;padding:0 20px;border:1px solid #F06428;border-radius:30px;background:#F06428;color:#fff;font-size:14.5px;font-weight:700;white-space:nowrap;cursor:pointer}\n.login i{font-size:17px}\n\n.main{max-width:1330px;margin:0 auto;padding:32px 40px 0}\n.head{display:flex;align-items:flex-end;justify-content:space-between;gap:24px}\n.head h1{margin:0;font-size:32px;font-weight:800;letter-spacing:-1px;color:#101828;line-height:1.1}\n.head .count{font-size:13.5px;font-weight:600;color:#6E7887;font-variant-numeric:tabular-nums;padding-bottom:4px}\n.toolbar{display:flex;align-items:center;justify-content:space-between;gap:24px;margin-top:16px;border-bottom:1px solid #E7E9ED}\n.tabs{display:flex;align-items:center;gap:26px}\n.tab{position:relative;display:inline-flex;align-items:center;gap:7px;padding:12px 0 13px;border:0;background:none;font-family:inherit;font-size:14px;font-weight:600;color:#4B5565;white-space:nowrap;cursor:pointer}\n.tab.active{color:#E9541A}\n.tab.active::after{content:\"\";position:absolute;left:0;right:0;bottom:-1px;height:2.5px;border-radius:2px;background:#F06428}\n.tab .n{display:inline-grid;place-items:center;min-width:18px;height:18px;padding:0 5px;border-radius:9px;background:#FFF0E5;color:#E9541A;font-size:11px;font-weight:700}\n.search{display:flex;align-items:center;gap:9px;width:320px;height:42px;padding:0 13px;background:#fff;border:1px solid #E6E8EC;border-radius:11px;margin-bottom:8px}\n.search i{font-size:17px;color:#8A93A2}\n.search input{flex:1;min-width:0;border:0;outline:0;background:transparent;font-family:inherit;font-size:13px;color:#182235}\n.search input::placeholder{color:#98A0AC}\n.state{margin-top:20px;min-height:300px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;background:#fff;border:1px solid #E7E9ED;border-radius:16px;padding:40px}\n.state h2{margin:0;font-size:20px;font-weight:700;letter-spacing:-.3px;color:#101828}\n.state p{margin:7px 0 0;font-size:13.5px;line-height:1.55;color:#6E7887}\n.state .btn{margin-top:18px;display:inline-flex;align-items:center;justify-content:center;height:44px;padding:0 22px;border:0;border-radius:10px;background:#F06428;color:#fff;font-family:inherit;font-size:13px;font-weight:700;cursor:pointer}\n.split{height:56px;background:#EAEDF2}\n</style>\n<div class=\"shell\" data-kid=\"1\" data-name=\"orders page wrapper (empty state view)\">\n<div class=\"nav\" data-kid=\"1-1\" data-name=\"top navigation bar\">\n<div class=\"nav-in\" data-kid=\"1-1-1\" data-name=\"navigation inner layout row\">\n<a class=\"brand\" data-kid=\"1-1-1-1\" data-name=\"brand logo link\" href=\"#\"><img alt=\"ZIPBITE\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo image\" src=\"/api/local/images/frontend/public/logox.png\"/></a>\n<ul class=\"links\" data-kid=\"1-1-1-2\" data-name=\"main navigation link list\">\n<li data-kid=\"1-1-1-2-1\" data-name=\"navigation list item\"><a data-kid=\"1-1-1-2-1-1\" data-name=\"Home navigation link\" href=\"#\">Home</a></li>\n<li data-kid=\"1-1-1-2-2\" data-name=\"navigation list item\"><a data-kid=\"1-1-1-2-2-1\" data-name=\"Menu navigation link\" href=\"#\">Menu</a></li>\n<li data-kid=\"1-1-1-2-3\" data-name=\"navigation list item\"><a data-kid=\"1-1-1-2-3-1\" data-name=\"Restaurants navigation link\" href=\"#\">Restaurants</a></li>\n<li data-kid=\"1-1-1-2-4\" data-name=\"navigation list item\"><a data-kid=\"1-1-1-2-4-1\" data-name=\"Offers navigation link\" href=\"#\">Offers</a></li>\n<li data-kid=\"1-1-1-2-5\" data-name=\"navigation list item\"><a data-kid=\"1-1-1-2-5-1\" data-name=\"FAQ navigation link\" href=\"#\">FAQ</a></li>\n<li data-kid=\"1-1-1-2-6\" data-name=\"navigation list item\"><a data-kid=\"1-1-1-2-6-1\" data-name=\"Contact navigation link\" href=\"#\">Contact</a></li>\n<li data-kid=\"1-1-1-2-7\" data-name=\"navigation list item\"><a aria-label=\"Cart\" class=\"cart\" data-kid=\"1-1-1-2-7-1\" data-name=\"cart link with icon\" href=\"#\"><i class=\"mdi mdi-cart-outline\" data-kid=\"1-1-1-2-7-1-1\" data-name=\"cart outline icon\"></i></a></li>\n</ul>\n<div class=\"nav-actions\" data-kid=\"1-1-1-3\" data-name=\"navigation actions container\">\n<form class=\"nav-search\" data-kid=\"1-1-1-3-1\" data-name=\"header search form\" onsubmit=\"return false\" role=\"search\">\n<input aria-label=\"Search food or restaurant\" data-kid=\"1-1-1-3-1-1\" data-name=\"header search input field\" placeholder=\"Search food...\" type=\"search\"/>\n<button aria-label=\"Search\" data-kid=\"1-1-1-3-1-2\" data-name=\"search submit button\" type=\"submit\"><i class=\"mdi mdi-magnify\" data-kid=\"1-1-1-3-1-2-1\" data-name=\"magnifying glass icon\"></i></button>\n</form>\n<button class=\"login\" data-kid=\"1-1-1-3-2\" data-name=\"logout button\" type=\"button\">Logout <i class=\"mdi mdi-logout\" data-kid=\"1-1-1-3-2-1\" data-name=\"logout door arrow icon\"></i></button>\n</div>\n</div>\n</div>\n<main class=\"main\" data-kid=\"1-2\" data-name=\"main content area\">\n<div class=\"head\" data-kid=\"1-2-1\" data-name=\"page title header row\">\n<h1 data-kid=\"1-2-1-1\" data-name='page headline \"My Orders\"'>My Orders</h1>\n<div class=\"count\" data-kid=\"1-2-1-2\" data-name=\"order count label\">0 orders</div>\n</div>\n<div class=\"toolbar\" data-kid=\"1-2-2\" data-name=\"toolbar with tabs and search\">\n<div class=\"tabs\" data-kid=\"1-2-2-1\" data-name=\"order status tabs group\">\n<button class=\"tab active\" data-kid=\"1-2-2-1-1\" data-name=\"All Orders tab button (active)\" type=\"button\">All Orders <span class=\"n\" data-kid=\"1-2-2-1-1-1\" data-name=\"tab count badge\">0</span></button>\n<button class=\"tab\" data-kid=\"1-2-2-1-2\" data-name=\"Ongoing tab button\" type=\"button\">Ongoing</button>\n<button class=\"tab\" data-kid=\"1-2-2-1-3\" data-name=\"Delivered tab button\" type=\"button\">Delivered</button>\n<button class=\"tab\" data-kid=\"1-2-2-1-4\" data-name=\"Cancelled tab button\" type=\"button\">Cancelled</button>\n</div>\n<div class=\"search\" data-kid=\"1-2-2-2\" data-name=\"in-page search bar\">\n<i class=\"mdi mdi-magnify\" data-kid=\"1-2-2-2-1\" data-name=\"magnifying glass icon\"></i>\n<input data-kid=\"1-2-2-2-2\" data-name=\"order search input field\" placeholder=\"Search restaurant or order ID...\" type=\"text\" value=\"\"/>\n</div>\n</div>\n<div class=\"state\" data-kid=\"1-2-3\" data-name=\"empty state container\">\n<h2 data-kid=\"1-2-3-1\" data-name=\"empty state headline\">No orders yet</h2>\n<p data-kid=\"1-2-3-2\" data-name=\"empty state description text\">Orders you place will appear here.</p>\n</div>\n</main>\n</div>\n<div class=\"split\" data-kid=\"2\" data-name=\"section divider bar\"></div>\n<div class=\"shell\" data-kid=\"3\" data-name=\"orders page wrapper (filtered view)\">\n<div class=\"nav\" data-kid=\"3-1\" data-name=\"top navigation bar\">\n<div class=\"nav-in\" data-kid=\"3-1-1\" data-name=\"navigation inner layout row\">\n<a class=\"brand\" data-kid=\"3-1-1-1\" data-name=\"brand logo link\" href=\"#\"><img alt=\"ZIPBITE\" data-kid=\"3-1-1-1-1\" data-name=\"brand logo image\" src=\"/api/local/images/frontend/public/logox.png\"/></a>\n<ul class=\"links\" data-kid=\"3-1-1-2\" data-name=\"main navigation link list\">\n<li data-kid=\"3-1-1-2-1\" data-name=\"navigation list item\"><a data-kid=\"3-1-1-2-1-1\" data-name=\"Home navigation link\" href=\"#\">Home</a></li>\n<li data-kid=\"3-1-1-2-2\" data-name=\"navigation list item\"><a data-kid=\"3-1-1-2-2-1\" data-name=\"Menu navigation link\" href=\"#\">Menu</a></li>\n<li data-kid=\"3-1-1-2-3\" data-name=\"navigation list item\"><a data-kid=\"3-1-1-2-3-1\" data-name=\"Restaurants navigation link\" href=\"#\">Restaurants</a></li>\n<li data-kid=\"3-1-1-2-4\" data-name=\"navigation list item\"><a data-kid=\"3-1-1-2-4-1\" data-name=\"Offers navigation link\" href=\"#\">Offers</a></li>\n<li data-kid=\"3-1-1-2-5\" data-name=\"navigation list item\"><a data-kid=\"3-1-1-2-5-1\" data-name=\"FAQ navigation link\" href=\"#\">FAQ</a></li>\n<li data-kid=\"3-1-1-2-6\" data-name=\"navigation list item\"><a data-kid=\"3-1-1-2-6-1\" data-name=\"Contact navigation link\" href=\"#\">Contact</a></li>\n<li data-kid=\"3-1-1-2-7\" data-name=\"navigation list item\"><a aria-label=\"Cart\" class=\"cart\" data-kid=\"3-1-1-2-7-1\" data-name=\"cart link with icon\" href=\"#\"><i class=\"mdi mdi-cart-outline\" data-kid=\"3-1-1-2-7-1-1\" data-name=\"cart outline icon\"></i></a></li>\n</ul>\n<div class=\"nav-actions\" data-kid=\"3-1-1-3\" data-name=\"navigation actions container\">\n<form class=\"nav-search\" data-kid=\"3-1-1-3-1\" data-name=\"header search form\" onsubmit=\"return false\" role=\"search\">\n<input aria-label=\"Search food or restaurant\" data-kid=\"3-1-1-3-1-1\" data-name=\"header search input field\" placeholder=\"Search food...\" type=\"search\"/>\n<button aria-label=\"Search\" data-kid=\"3-1-1-3-1-2\" data-name=\"search submit button\" type=\"submit\"><i class=\"mdi mdi-magnify\" data-kid=\"3-1-1-3-1-2-1\" data-name=\"magnifying glass icon\"></i></button>\n</form>\n<button class=\"login\" data-kid=\"3-1-1-3-2\" data-name=\"logout button\" type=\"button\">Logout <i class=\"mdi mdi-logout\" data-kid=\"3-1-1-3-2-1\" data-name=\"logout door arrow icon\"></i></button>\n</div>\n</div>\n</div>\n<main class=\"main\" data-kid=\"3-2\" data-name=\"main content area\">\n<div class=\"head\" data-kid=\"3-2-1\" data-name=\"page title header row\">\n<h1 data-kid=\"3-2-1-1\" data-name='page headline \"My Orders\"'>My Orders</h1>\n<div class=\"count\" data-kid=\"3-2-1-2\" data-name=\"order count label\">5 orders</div>\n</div>\n<div class=\"toolbar\" data-kid=\"3-2-2\" data-name=\"toolbar with tabs and search\">\n<div class=\"tabs\" data-kid=\"3-2-2-1\" data-name=\"order status tabs group\">\n<button class=\"tab\" data-kid=\"3-2-2-1-1\" data-name=\"All Orders tab button\" type=\"button\">All Orders <span class=\"n\" data-kid=\"3-2-2-1-1-1\" data-name=\"tab count badge\">5</span></button>\n<button class=\"tab\" data-kid=\"3-2-2-1-2\" data-name=\"Ongoing tab button\" type=\"button\">Ongoing</button>\n<button class=\"tab active\" data-kid=\"3-2-2-1-3\" data-name=\"Delivered tab button (active)\" type=\"button\">Delivered</button>\n<button class=\"tab\" data-kid=\"3-2-2-1-4\" data-name=\"Cancelled tab button\" type=\"button\">Cancelled</button>\n</div>\n<div class=\"search\" data-kid=\"3-2-2-2\" data-name=\"in-page search bar\">\n<i class=\"mdi mdi-magnify\" data-kid=\"3-2-2-2-1\" data-name=\"magnifying glass icon\"></i>\n<input data-kid=\"3-2-2-2-2\" data-name=\"order search input field\" placeholder=\"Search restaurant or order ID...\" type=\"text\" value=\"biryani\"/>\n</div>\n</div>\n<div class=\"state\" data-kid=\"3-2-3\" data-name=\"empty state container\">\n<h2 data-kid=\"3-2-3-1\" data-name=\"empty state headline\">No orders found</h2>\n<button class=\"btn\" data-kid=\"3-2-3-2\" data-name=\"view all orders call-to-action button\" type=\"button\">View All Orders</button>\n</div>\n</main>\n</div>",

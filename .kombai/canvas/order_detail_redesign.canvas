mdi mdi-chevron-right\" data-kid=\"1-2-3-5-1-5-1-1\" data-name=\"right chevron icon\"></i></button>\n<button class=\"btn btn-reorder\" data-kid=\"1-2-3-5-1-5-2\" data-name=\"reorder button\" type=\"button\">Reorder</button>\n</div>\n</div>\n</article>\n</div>\n</main>\n</div>",

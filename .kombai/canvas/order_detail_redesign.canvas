      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/@mdi/font@7.4.47/css/materialdesignicons.min.css\");\n*{box-sizing:border-box}\nbody{margin:0;background:#F5F6F8;font-family:'Inter',Arial,Helvetica,sans-serif;color:#182235;-webkit-font-smoothing:antialiased}\n.page{max-width:390px;margin:0 auto;background:#F5F6F8;padding-bottom:30px}\n.topbar{height:72px;background:#fff;border-bottom:1px solid #F0EEEB;display:flex;align-items:center;justify-content:space-between;padding:0 16px;box-shadow:0 3px 14px rgba(35,27,17,.04)}\n.topbar img{height:50px;width:auto;display:block}\n.burger{width:44px;height:44px;border:1px solid #EEEEEE;border-radius:10px;background:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px}\n.burger span{display:block;width:20px;height:2px;border-radius:2px;background:#282828}\n.wrap{padding:18px 16px 0}\n.head{display:flex;align-items:baseline;justify-content:space-between;gap:12px}\n.head h1{margin:0;font-size:26px;font-weight:800;letter-spacing:-.8px;color:#101828}\n.head .count{font-size:12px;font-weight:600;color:#6E7887;font-variant-numeric:tabular-nums}\n.tabs{display:flex;align-items:center;justify-content:space-between;margin-top:13px;border-bottom:1px solid #E7E9ED}\n.tab{position:relative;display:inline-flex;align-items:center;gap:5px;padding:11px 0 12px;border:0;background:none;font-family:inherit;font-size:12.5px;font-weight:600;color:#4B5565;white-space:nowrap;cursor:pointer}\n.tab.active{color:#E9541A}\n.tab.active::after{content:\"\";position:absolute;left:0;right:0;bottom:-1px;height:2.5px;border-radius:2px;background:#F06428}\n.tab .n{display:inline-grid;place-items:center;min-width:17px;height:17px;padding:0 4px;border-radius:9px;background:#FFF0E5;color:#E9541A;font-size:10.5px;font-weight:700}\n.search{display:flex;align-items:center;gap:9px;margin-top:14px;height:44px;padding:0 13px;background:#fff;border:1px solid #E7E9ED;border-radius:12px}\n.search i{font-size:17px;color:#8A93A2}\n.search input{flex:1;min-width:0;border:0;outline:0;background:transparent;font-family:inherit;font-size:13px;color:#182235}\n.search input::placeholder{color:#98A0AC}\n.list{margin-top:16px;display:flex;flex-direction:column;gap:12px}\n\n.live{background:#fff;border:1px solid #F5D3BA;border-radius:16px;overflow:hidden}\n.live-band{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:13px 16px;background:linear-gradient(180deg,#FFF6EF 0%,#FFFCFA 100%);border-bottom:1px solid #FCE7D8}\n.live-status{display:inline-flex;align-items:center;gap:7px;font-size:15px;font-weight:800;letter-spacing:-.3px;color:#E9541A}\n.live-status i{font-size:17px}\n.live-total{text-align:right}\n.live-total span{display:block;font-size:10px;font-weight:600;letter-spacing:.3px;color:#8A93A2}\n.live-total strong{display:block;margin-top:1px;font-size:18px;font-weight:800;letter-spacing:-.5px;color:#182235;font-variant-numeric:tabular-nums}\n.ident{display:flex;gap:11px;align-items:center;padding:13px 16px 0}\n.ident img{width:52px;height:52px;border-radius:12px;object-fit:cover;background:#F1F2F4;flex-shrink:0}\n.ident h3{margin:0;font-size:15.5px;font-weight:700;letter-spacing:-.2px;color:#182235}\n.ident p{margin:3px 0 0;font-size:11.5px;color:#79828F;line-height:1.35}\n.ident p.id{color:#5E6878;font-weight:500;font-variant-numeric:tabular-nums;letter-spacing:.2px}\n.track{display:grid;grid-template-columns:repeat(4,1fr);margin:15px 16px 0}\n.step{position:relative;display:flex;flex-direction:column;align-items:center;gap:7px}\n.step:not(:last-child)::after{content:\"\";position:absolute;top:11px;left:calc(50% + 14px);width:calc(100% - 28px);height:2px;background:#E7E9ED}\n.step.done:not(:last-child)::after{background:#F06428}\n.dot{position:relative;z-index:1;display:grid;place-items:center;width:24px;height:24px;border-radius:50%;border:2px solid #E1E4E9;background:#fff;font-size:10.5px;font-weight:700;color:#8B939F;font-variant-numeric:tabular-nums}\n.dot i{font-size:13px;line-height:1}\n.step.done .dot{background:#F06428;border-color:#F06428;color:#fff}\n.step.now .dot{border:2.5px solid #F06428;background:#fff;color:#E9541A}\n.step span{font-size:10.5px;font-weight:600;color:#8B939F;text-align:center;line-height:1.25}\n.step.done span{color:#4B5565}\n.step.now span{color:#E9541A;font-weight:700}\n.items{margin-top:14px;padding:0 16px;display:flex;flex-direction:column;gap:9px}\n.item{display:flex;align-items:center;gap:10px}\n.item img{width:34px;height:34px;border-radius:9px;object-fit:cover;background:#F1F2F4;flex-shrink:0}\n.item span{flex:1;min-width:0;font-size:12.5px;font-weight:600;color:#283244;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.item small{font-size:11.5px;font-weight:500;color:#8A93A2}\n.live-foot{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:13px;padding:12px 16px 14px;border-top:1px solid #F2F3F5}\n.pay{font-size:11px;font-weight:500;color:#79828F;white-space:nowrap}\n.pay b{font-weight:700;color:#3A4557}\n.btn{display:inline-flex;align-items:center;justify-content:center;gap:5px;height:40px;padding:0 13px;border-radius:10px;font-family:inherit;font-size:12.5px;font-weight:700;border:1px solid #DCE0E6;background:#fff;color:#182235;white-space:nowrap;cursor:pointer}\n.btn i{font-size:15px}\n.btn.reorder{border-color:#F06428;background:#F06428;color:#fff}\n.btn.ghost{flex:1}\n\n.term{background:#fff;border:1px solid #E7E9ED;border-radius:14px;padding:13px 14px}\n.term-top{display:flex;align-items:flex-start;gap:10px}\n.term-top img{width:44px;height:44px;border-radius:11px;object-fit:cover;background:#F1F2F4;flex-shrink:0}\n.term-id{flex:1;min-width:0}\n.term-id h3{margin:0;font-size:14.5px;font-weight:700;letter-spacing:-.2px;color:#182235}\n.term-id p{margin:3px 0 0;font-size:11px;color:#79828F}\n.term-id p.id{color:#5E6878;font-weight:500;font-variant-numeric:tabular-nums}\n.chip{display:inline-flex;align-items:center;gap:4px;height:24px;padding:0 8px;border-radius:7px;font-size:10.5px;font-weight:700;white-space:nowrap;flex-shrink:0}\n.chip i{font-size:12px;line-height:1}\n.chip.d{background:#E8F7EF;color:#07864B}\n.chip.c{background:#FFECEE;color:#D92332}\n.term-items{display:flex;flex-wrap:wrap;gap:6px 14px;margin-top:11px;padding-top:11px;border-top:1px solid #F2F3F5}\n.ti{display:flex;align-items:center;gap:6px;min-width:0}\n.ti img{width:24px;height:24px;border-radius:7px;object-fit:cover;background:#F1F2F4;flex-shrink:0}\n.ti span{font-size:11.5px;font-weight:600;color:#3A4557;max-width:140px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.ti small{font-size:10.5px;color:#98A0AC}\n.term-foot{display:flex;align-items:flex-end;justify-content:space-between;gap:10px;margin-top:11px}\n.term-total{text-align:right}\n.term-total span{display:block;font-size:10px;color:#8A93A2;font-weight:600}\n.term-total strong{display:block;font-size:16px;font-weight:800;letter-spacing:-.3px;color:#182235;font-variant-numeric:tabular-nums}\n.term-actions{display:flex;gap:8px;margin-top:10px}\n</style>\n<div class=\"page\" data-kid=\"1\" data-name=\"mobile page layout container\">\n<div class=\"topbar\" data-kid=\"1-1\" data-name=\"top app bar\">\n<img alt=\"ZIPBITE\" data-kid=\"1-1-1\" data-name=\"app logo image\" src=\"/api/local/images/frontend/public/logox.png\"/>\n<button aria-label=\"Toggle navigation menu\" class=\"burger\" data-kid=\"1-1-2\" data-name=\"menu hamburger button\" type=\"button\"><span data-kid=\"1-1-2-1\" data-name=\"hamburger top bar span\"></span><span data-kid=\"1-1-2-2\" data-name=\"hamburger middle bar span\"></span><span data-kid=\"1-1-2-3\" data-name=\"hamburger bottom bar span\"></span></button>\n</div>\n<div class=\"wrap\" data-kid=\"1-2\" data-name=\"page content wrapper\">\n<div class=\"head\" data-kid=\"1-2-1\" data-name=\"page header row\">\n<h1 data-kid=\"1-2-1-1\"
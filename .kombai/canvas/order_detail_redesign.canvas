      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800&family=Manrope:wght@400;500;600;700;800&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css\");\n\n* { box-sizing: border-box; }\nbody { margin: 0; background: #f3f4fa; color: #1d2036; font-family: \"Manrope\", system-ui, sans-serif; -webkit-font-smoothing: antialiased; }\n.od2-page { max-width: 1280px; margin: 0 auto; padding: 26px 28px 44px; }\n.od2-back { display: inline-flex; align-items: center; gap: 8px; color: #6a6e86; font-size: 13px; font-weight: 700; text-decoration: none; margin-bottom: 14px; }\n.od2-back:hover { color: #e8651e; }\n.od2-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 24px; margin-bottom: 16px; }\n.od2-head h1 { font-family: \"Sora\", sans-serif; font-size: 26px; font-weight: 800; letter-spacing: -0.9px; margin: 0; }\n.od2-meta { display: flex; align-items: center; gap: 11px; margin-top: 7px; color: #6a6e86; font-size: 12.5px; flex-wrap: wrap; }\n.od2-meta .id { font-family: \"Sora\", sans-serif; font-size: 11.5px; font-weight: 700; color: #3a3e56; background: #fff; border: 1px solid #e8eaf3; padding: 4px 9px; border-radius: 7px; }\n.od2-meta .sep { width: 3px; height: 3px; border-radius: 50%; background: #b9bdcf; }\n.od2-chip { display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; border-radius: 999px; background: #fff3dc; color: #b8740a; font-size: 10.5px; font-weight: 800; letter-spacing: 0.7px; }\n.od2-chip span { width: 7px; height: 7px; border-radius: 50%; background: currentColor; }\n\n.od2-card { background: #fff; border: 1px solid #e8eaf3; border-radius: 20px; }\n\n.od2-dest { display: grid; grid-template-columns: 250px minmax(0, 1fr) 292px; margin-bottom: 16px; overflow: hidden; }\n.od2-dest > div { padding: 22px 26px; position: relative; }\n.od2-dest > div + div::before { content: \"\"; position: absolute; left: 0; top: 22px; bottom: 22px; width: 1px; background: #eef0f7; }\n.od2-label { display: block; margin-bottom: 9px; color: #8b8fa4; font-size: 10px; font-weight: 800; letter-spacing: 0.8px; }\n.od2-name { font-size: 17px; font-weight: 800; letter-spacing: -0.3px; }\n.od2-phone { display: inline-flex; align-items: center; gap: 7px; margin-top: 6px; color: #5d6179; font-size: 13.5px; font-weight: 600; text-decoration: none; }\n.od2-phone i { color: #ff7a2f; font-size: 12px; }\n.od2-landmark { margin: 0 0 4px; font-size: 16px; font-weight: 800; line-height: 1.4; }\n.od2-addr { margin: 0; font-size: 15.5px; line-height: 1.6; color: #4c5068; }\n.od2-time { font-family: \"Sora\", sans-serif; font-size: 21px; font-weight: 800; letter-spacing: -0.6px; }\n.od2-date { display: block; margin-top: 3px; color: #7b7f95; font-size: 12.5px; font-weight: 600; }\n.od2-pay { display: flex; gap: 26px; margin-top: 14px; padding-top: 13px; border-top: 1px solid #f0f2f8; }\n.od2-pay .k { display: block; color: #8b8fa4; font-size: 9.5px; font-weight: 800; letter-spacing: 0.7px; margin-bottom: 4px; }\n.od2-pay .v { font-size: 13.5px; font-weight: 800; color: #3a3e56; }\n.od2-pay .paid { display: inline-flex; align-items: center; gap: 5px; color: #139660; }\n.od2-pay .paid i { font-size: 12px; }\n\n.od2-review { display: grid; grid-template-columns: minmax(0, 1fr) 420px; overflow: hidden; margin-bottom: 16px; }\n.od2-items { padding: 22px 24px 20px; }\n.od2-review-head { display: flex; align-items: baseline; justify-content: space-between; gap: 14px; margin-bottom: 8px; }\n.od2-review-head h2 { font-family: \"Sora\", sans-serif; font-size: 17.5px; font-weight: 700; letter-spacing: -0.4px; margin: 0; }\n.od2-review-head span { color: #7b7f95; font-size: 12px; font-weight: 700; }\n.od2-thead, .od2-row { display: grid; grid-template-columns: minmax(0, 1fr) 60px 108px; gap: 14px; align-items: center; }\n.od2-thead { padding: 12px 0 9px; border-bottom: 1px solid #eef0f7; color: #8b8fa4; font-size: 10.5px; font-weight: 800; letter-spacing: 0.6px; }\n.od2-thead .r { text-align: right; }\n.od2-row { min-height: 64px; border-bottom: 1px solid #f2f4f9; }\n.od2-row:last-of-type { border-bottom: none; }\n.od2-item { display: flex; align-items: center; gap: 13px; min-width: 0; }\n.od2-item img { width: 40px; height: 40px; border-radius: 9px; object-fit: cover; background: #eef0f7; flex-shrink: 0; }\n.od2-name { font-size: 14.5px; font-weight: 700; line-height: 1.35; overflow-wrap: anywhere; }\n.od2-qty { font-size: 13.5px; font-weight: 800; color: #3a3e56; font-variant-numeric: tabular-nums; }\n.od2-qty em { font-style: normal; color: #a2a6ba; font-weight: 700; margin-right: 2px; }\n.od2-price { text-align: right; font-size: 13.5px; font-weight: 700; color: #3a3e56; font-variant-numeric: tabular-nums; }\n.od2-note { display: flex; gap: 11px; margin-top: 16px; padding-top: 15px; border-top: 1px solid #eef0f7; }\n.od2-note i { color: #e8651e; font-size: 14px; margin-top: 2px; }\n.od2-note span { display: block; font-size: 10px; font-weight: 800; letter-spacing: 0.7px; color: #8b8fa4; }\n.od2-note p { margin: 4px 0 0; font-size: 13.5px; color: #3f4359; line-height: 1.5; }\n\n.od2-ledger { padding: 22px 26px 20px; border-left: 1px solid #eef0f7; background: #fcfcfe; }\n.od2-ledger h2 { font-family: \"Sora\", sans-serif; font-size: 17.5px; font-weight: 700; letter-spacing: -0.4px; margin: 0 0 12px; }\n.od2-line { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding: 5px 0; font-size: 13.5px; color: #5d6179; }\n.od2-line b { font-weight: 700; color: #3a3e56; font-variant-numeric: tabular-nums; }\n.od2-total { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; margin-top: 14px; padding-top: 16px; border-top: 1px solid #e2e5f0; }\n.od2-total span { font-size: 13.5px; font-weight: 800; color: #3a3e56; }\n.od2-total strong { font-family: \"Sora\", sans-serif; font-size: 27px; font-weight: 800; letter-spacing: -1px; font-variant-numeric: tabular-nums; }\n.od2-paid-inline { display: inline-flex; align-items: center; gap: 6px; margin-top: 14px; color: #139660; font-size: 12px; font-weight: 700; }\n.od2-paid-icon { width: 18px; height: 18px; border-radius: 50%; background: #e1f8ee; display: grid; place-items: center; font-size: 10px; }\n\n.od2-decision { display: flex; align-items: center; justify-content: space-between; gap: 24px; gap: 24px; background: #15182e; border-radius: 18px; padding: 16px 22px; }\n.od2-decision-left { display: flex; align-items: center; gap: 16px; }\n.od2-state-label { color: #8f94b3; font-size: 9.5px; font-weight: 800; letter-spacing: 0.9px; }\n.od2-state { display: inline-flex; align-items: center; gap: 8px; color: #fff; font-family: \"Sora\", sans-serif; font-size: 15px; font-weight: 700; letter-spacing: 0.2px; margin-top: 3px; }\n.od2-state span { width: 7px; height: 7px; border-radius: 50%; background: #f5b544; box-shadow: 0 0 0 4px rgba(245,181,68,0.14); }\n.od2-when { color: #8f94b3; font-size: 12px; font-weight: 600; padding-left: 16px; border-left: 1px solid rgba(255,255,255,0.12); }\n.od2-btns { display: flex; align-items: center; gap: 10px; }\n.od2-cancel { height: 44px; padding: 0 20px; border-radius: 11px; border: 1px solid rgba(255,255,255,0.24); background: transparent; color: #fff; font-family: inherit; font-size: 13px; font-weight: 800; cursor: pointer; transition: background .18s, border-color .18s; display: inline-flex; align-items: center; gap: 8px; }\n.od2-cancel:hover { background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.4); }\n.od2-accept { height: 46px; padding: 0 22px; border: none; border-radius: 11px; background: #ff7a2f; color: #fff; font-family: inherit; font-size: 13.5px; font-weight: 800; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; box-shadow: 0 8px 20px rgba(255,122,47,0.3); transition: background .18s; }\n.od2-accept:hover { background: #f26a1c; }\n.od2-accept i { font-size: 15px; }\n.od2-cancel:focus-visible, .od2-accept:focus-visible, .od2-back:focus-visible { outline: 3px solid rgba(255,122,47,0.5); outline-offset: 2px; }\n</style>\n<div class=\"od2-page\" data-kid=\"1\" data-name=\"order details page container\">\n<a class=\"od2-back\" data-kid=\"1-1\" data-name=\"back to orders link\" href=\"#\"><i class=\"bi bi-arrow-left\" data-kid=\"1-1-1\" data-name=\"left arrow back icon\"></i>Orders</a>\n<header class=\"od2-head\" data-kid=\"1-2\" data-name=\"page header with title and status\">\n<div data-kid=\"1-2-1\" data-name=\"header title area wrapper\">\n<h1 data-kid=\"1-2-1-1\" data-name=\"page title headline\">Order details</h1>\n<div class=\"od2-meta\" data-kid=\"1-2-1-2\" data-name=\"order metadata row with ID and date\">\n<span class=\"id\" data-kid=\"1-2-1-2-1\" data-name=\"order ID badge\">#68f3a1c9e42b7d0a1f6c8e35</span>\n<span class=\"sep\" data-kid=\"1-2-1-2-2\" data-name=\"metadata separator dot\"></span>\n<span data-kid=\"1-2-1-2-3\" data-name=\"order placed date and time text\">Placed 5 November 2026, 1:42 PM</span>\n</div>\n</div>\n<span class=\"od2-chip\" data-kid=\"1-2-2\" data-name=\"order status chip\"><span data-kid=\"1-2-2-1\" data-name=\"status indicator dot icon\"></span>PLACED</span>\n</header>\n<section class=\"od2-card od2-dest\" data-kid=\"1-3\" data-name=\"delivery details card with customer address and ETA\">\n<div data-kid=\"1-3-1\" data-name=\"customer info column\">\n<span class=\"od2-label\" data-kid=\"1-3-1-1\" data-name=\"customer label text\">CUSTOMER</span>\n<div class=\"od2-name\" data-kid=\"1-3-1-2\" data-name=\"customer name text\">Aarav Mehta</div>\n<a class=\"od2-phone\" data-kid=\"1-3-1-3\" data-name=\"customer phone link\" href=\"tel:+919820455671\"><i class=\"bi bi-telephone\" data-kid=\"1-3-1-3-1\" data-name=\"telephone icon\"></i>+91 98204 55671</a>\n</div>\n<div data-kid=\"1-3-2\" data-name=\"delivery address column\">\n<span class=\"od2-label\" data-kid=\"1-3-2-1\" data-name=\"delivery address label text\">DELIVERY ADDRESS</span>\n<p class=\"od2-landmark\" data-kid=\"1-3-2-2\" data-name=\"landmark text\">Opposite Bandra Police Station</p>\n<p class=\"od2-addr\" data-kid=\"1-3-2-3\" data-name=\"detailed delivery address text\">402, Sunrose Apartments, Turner Road,<br data-kid=\"1-3-2-3-1\" data-name=\"line break in address\"/>Mumbai, Maharashtra 400050</p>\n</div>\n<div data-kid=\"1-3-3\" data-name=\"estimated delivery and payment column\">\n<span class=\"od2-label\" data-kid=\"1-3-3-1\" data-name=\"estimated delivery label text\">ESTIMATED DELIVERY</span>\n<div class=\"od2-time\" data-kid=\"1-3-3-2\" data-name=\"estimated delivery time text\">02:30 PM</div>\n<span class=\"od2-date\" data-kid=\"1-3-3-3\" data-name=\"estimated delivery date text\">5 November 2026</span>\n<div class=\"od2-pay\" data-kid=\"1-3-3-4\" data-name=\"payment summary row\">\n<div data-kid=\"1-3-3-4-1\" data-name=\"payment method display\">\n<span class=\"k\" data-kid=\"1-3-3-4-1-1\" data-name=\"payment method label text\">PAYMENT METHOD</span>\n<div class=\"v\" data-kid=\"1-3-3-4-1-2\" data-name=\"payment method value text\">ONLINE</div>\n</div>\n<div data-kid=\"1-3-3-4-2\" data-name=\"payment status display\">\n<span class=\"k\" data-kid=\"1-3-3-4-2-1\" data-name=\"payment status label text\">PAYMENT STATUS</span>\n<div class=\"v paid\" data-kid=\"1-3-3-4-2-2\" data-name=\"paid status value text\"><i class=\"bi bi-check-circle-fill\" data-kid=\"1-3-3-4-2-2-1\" data-name=\"check-circle paid icon\"></i>PAID</div>\n</div>\n</div>\n</div>\n</section>\n<section class=\"od2-card od2-review\" data-dynamic=\"true\" data-kid=\"1-4\" data-name=\"order items and bill card\" data-reason=\"item rows and item count are generated by script from order data\">\n<div class=\"od2-items\" data-kid=\"1-4-1\" data-name=\"order items list panel\">\n<div class=\"od2-review-head\" data-kid=\"1-4-1-1\" data-name=\"items section header\">\n<h2 data-kid=\"1-4-1-1-1\" data-name=\"items section heading\">Ordered items</h2>\n<span data-dynamic=\"true\" data-kid=\"1-4-1-1-2\" data-name=\"item count badge\" data-reason=\"item count text updated by script from order data\">7 items</span>\n</div>\n<div class=\"od2-thead\" data-kid=\"1-4-1-2\" data-name=\"items table header row\">\n<span data-kid=\"1-4-1-2-1\" data-name=\"Item column header label\">Item</span>\n<span data-kid=\"1-4-1-2-2\" data-name=\"Qty column header label\">Qty</span>\n<span class=\"r\" data-kid=\"1-4-1-2-3\" data-name=\"Unit price column header label\">Unit price</span>\n</div>\n<div class=\"od2-row\" data-kid=\"1-4-1-3\" data-name=\"ordered item row\">\n<div class=\"od2-item\" data-kid=\"1-4-1-3-1\" data-name=\"item cell with image and name\">\n<img alt=\"Chicken Dum Biryani — Prabal Pratap Singh on Pexels\" data-kid=\"1-4-1-3-1-1\" data-name=\"item thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/9609860/pexels-photo-9609860.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=160&amp;q=80\"/>\n<span class=\"od2-name\" data-kid=\"1-4-1-3-1-2\" data-name=\"item name text\">Chicken Dum Biryani (Full)</span>\n</div>\n<span class=\"od2-qty\" data-kid=\"1-4-1-3-2\" data-name=\"item quantity text\"><em data-kid=\"1-4-1-3-2-1\" data-name=\"multiplication symbol\">×</em>2</span>\n<span class=\"od2-price\" data-kid=\"1-4-1-3-3\" data-name=\"item unit price text\">₹380.00</span>\n</div>\n<div class=\"od2-row\" data-kid=\"1-4-1-4\" data-name=\"ordered item row\">\n<div class=\"od2-item\" data-kid=\"1-4-1-4-1\" data-name=\"item cell with image and name\">\n<img alt=\"Paneer Butter Masala — dhiraj jain on Pexels\" data-kid=\"1-4-1-4-1-1\" data-name=\"item thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/12737805/pexels-photo-12737805.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=160&amp;q=80\"/>\n<span class=\"od2-name\" data-kid=\"1-4-1-4-1-2\" data-name=\"item name text\">Paneer Butter Masala</span>\n</div>\n<span class=\"od2-qty\" data-kid=\"1-4-1-4-2\" data-name=\"item quantity text\"><em data-kid=\"1-4-1-4-2-1\" data-name=\"multiplication symbol\">×</em>1</span>\n<span class=\"od2-price\" data-kid=\"1-4-1-4-3\" data-name=\"item unit price text\">₹320.00</span>\n</div>\n<div class=\"od2-row\" data-kid=\"1-4-1-5\" data-name=\"ordered item row\">\n<div class=\"od2-item\" data-kid=\"1-4-1-5-1\" data-name=\"item cell with image and name\">\n<img alt=\"Butter Naan — Gözde Z. on Pexels\" data-kid=\"1-4-1-5-1-1\" data-name=\"item thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/38163958/pexels-photo-38163958.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=160&amp;q=80\"/>\n<span class=\"od2-name\" data-kid=\"1-4-1-5-1-2\" data-name=\"item name text\">Butter Naan</span>\n</div>\n<span class=\"od2-qty\" data-kid=\"1-4-1-5-2\" data-name=\"item quantity text\"><em data-kid=\"1-4-1-5-2-1\" data-name=\"multiplication symbol\">×</em>3</span>\n<span class=\"od2-price\" data-kid=\"1-4-1-5-3\" data-name=\"item unit price text\">₹55.00</span>\n</div>\n<div class=\"od2-row\" data-kid=\"1-4-1-6\" data-name=\"ordered item row\">\n<div class=\"od2-item\" data-kid=\"1-4-1-6-1\" data-name=\"item cell with image and name\">\n<img alt=\"Gulab Jamun — Kiran on Pexels\" data-kid=\"1-4-1-6-1-1\" data-name=\"item thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/7406887/pexels-photo-7406887.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=160&amp;q=80\"/>\n<span class=\"od2-name\" data-kid=\"1-4-1-6-1-2\" data-name=\"item name text\">Gulab Jamun (2 pcs)</span>\n</div>\n<span class=\"od2-qty\" data-kid=\"1-4-1-6-2\" data-name=\"item quantity text\"><em data-kid=\"1-4-1-6-2-1\" data-name=\"multiplication symbol\">×</em>1</span>\n<span class=\"od2-price\" data-kid=\"1-4-1-6-3\" data-name=\"item unit price text\">₹120.00</span>\n</div>\n<div class=\"od2-note\" data-kid=\"1-4-1-7\" data-name=\"order instructions note block\">\n<i class=\"bi bi-chat-left-text\" data-kid=\"1-4-1-7-1\" data-name=\"chat note icon\"></i>\n<div data-kid=\"1-4-1-7-2\" data-name=\"note content container\">\n<span data-kid=\"1-4-1-7-2-1\" data-name=\"order instructions label text\">ORDER INSTRUCTIONS</span>\n<p data-kid=\"1-4-1-7-2-2\" data-name=\"order instructions text\">Less spicy. Pack the naan separately.</p>\n</div>\n</div>\n</div>\n<div class=\"od2-ledger\" data-kid=\"1-4-2\" data-name=\"bill summary panel\">\n<h2 data-kid=\"1-4-2-1\" data-name=\"bill heading text\">Bill</h2>\n<div class=\"od2-line\" data-kid=\"1-4-2-2\" data-name=\"subtotal bill line\"><span data-kid=\"1-4-2-2-1\" data-name=\"subtotal label text\">Subtotal</span><b data-kid=\"1-4-2-2-2\" data-name=\"subtotal amount text\">₹1,365.00</b></div>\n<div class=\"od2-line\" data-kid=\"1-4-2-3\" data-name=\"delivery fee bill line\"><span data-kid=\"1-4-2-3-1\" data-name=\"delivery fee label text\">Delivery fee</span><b data-kid=\"1-4-2-3-2\" data-name=\"delivery fee amount text\">₹40.00</b></div>\n<div class=\"od2-line\" data-kid=\"1-4-2-4\" data-name=\"tax bill line\"><span data-kid=\"1-4-2-4-1\" data-name=\"tax label text\">Tax</span><b data-kid=\"1-4-2-4-2\" data-name=\"tax amount text\">₹68.00</b></div>\n<div class=\"od2-line\" data-kid=\"1-4-2-5\" data-name=\"discount bill line\"><span data-kid=\"1-4-2-5-1\" data-name=\"discount label text\">Discount</span><b data-kid=\"1-4-2-5-2\" data-name=\"discount amount text\">−₹50.00</b></div>\n<div class=\"od2-total\" data-kid=\"1-4-2-6\" data-name=\"order total line\"><span data-kid=\"1-4-2-6-1\" data-name=\"order total label text\">Order total</span><strong data-kid=\"1-4-2-6-2\" data-name=\"order total amount text\">₹1,423.00</strong></div>\n</div>\n</section>\n<section class=\"od2-decision\" data-kid=\"1-5\" data-name=\"dark order status decision bar\">\n<div class=\"od2-decision-left\" data-kid=\"1-5-1\" data-name=\"status info group\">\n<div data-kid=\"1-5-1-1\" data-name=\"status indicator container\">\n<div class=\"od2-state-label\" data-kid=\"1-5-1-1-1\" data-name=\"ORDER STATUS label text\">ORDER STATUS</div>\n<div class=\"od2-state\" data-kid=\"1-5-1-1-2\" data-name=\"PLACED status display\"><span data-kid=\"1-5-1-1-2-1\" data-name=\"status pulsing dot\"></span>PLACED</div>\n</div>\n<div class=\"od2-when\" data-kid=\"1-5-1-2\" data-name=\"order placed timestamp text\">Placed 5 Nov 2026, 1:42 PM</div>\n</div>\n<div class=\"od2-btns\" data-kid=\"1-5-2\" data-name=\"action buttons group\">\n<button class=\"od2-cancel\" data-kid=\"1-5-2-1\" data-name=\"cancel order button\"><i class=\"bi bi-x-lg\" data-kid=\"1-5-2-1-1\" data-name=\"cancel X icon\"></i>Cancel order</button>\n<button class=\"od2-accept\" data-kid=\"1-5-2-2\" data-name=\"accept order primary button\">Accept order<i class=\"bi bi-check2\" data-kid=\"1-5-2-2-1\" data-name=\"checkmark accept icon\"></i></button>\n</div>\n</section>\n</div>",

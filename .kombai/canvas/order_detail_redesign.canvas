      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800&family=Manrope:wght@400;500;600;700;800&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css\");\n\n* { box-sizing: border-box; }\nbody { margin: 0; background: #f3f4fa; color: #1d2036; font-family: \"Manrope\", system-ui, sans-serif; -webkit-font-smoothing: antialiased; }\n.od3-page { max-width: 1104px; margin: 0 auto; padding: 30px 32px 48px; }\n.od3-back { display: inline-flex; align-items: center; gap: 8px; color: #6a6e86; font-size: 13px; font-weight: 700; text-decoration: none; margin-bottom: 15px; }\n.od3-back:hover { color: #e8651e; }\n.od3-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 24px; margin-bottom: 20px; }\n.od3-head h1 { font-family: \"Sora\", sans-serif; font-size: 26px; font-weight: 800; letter-spacing: -0.9px; margin: 0; }\n.od3-meta { display: flex; align-items: center; gap: 11px; margin-top: 8px; color: #6a6e86; font-size: 12.5px; flex-wrap: wrap; }\n.od3-meta .id { font-family: \"Sora\", sans-serif; font-size: 11.5px; font-weight: 700; color: #3a3e56; background: #fff; border: 1px solid #e8eaf3; padding: 4px 9px; border-radius: 7px; }\n.od3-meta .sep { width: 3px; height: 3px; border-radius: 50%; background: #b9bdcf; }\n.od3-chip { display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; border-radius: 999px; background: #fff3dc; color: #b8740a; font-size: 10.5px; font-weight: 800; letter-spacing: 0.7px; white-space: nowrap; }\n.od3-chip span { width: 7px; height: 7px; border-radius: 50%; background: currentColor; }\n\n.od3-facts { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); background: #fff; border: 1px solid #e8eaf3; border-radius: 18px; margin-bottom: 20px; overflow: hidden; }\n.od3-fact { padding: 17px 22px; position: relative; }\n.od3-fact + .od3-fact::before { content: \"\"; position: absolute; left: 0; top: 17px; bottom: 17px; width: 1px; background: #eef0f7; }\n.od3-k { display: block; margin-bottom: 6px; color: #8b8fa4; font-size: 9.5px; font-weight: 800; letter-spacing: 0.7px; }\n.od3-v { font-family: \"Sora\", sans-serif; font-size: 15px; font-weight: 700; letter-spacing: -0.25px; line-height: 1.35; }\n.od3-v small { display: block; font-family: \"Manrope\", sans-serif; font-size: 11.5px; font-weight: 600; color: #7b7f95; letter-spacing: 0; margin-top: 2px; }\n.od3-paid { display: inline-flex; align-items: center; gap: 6px; color: #139660; }\n.od3-paid i { font-size: 13px; }\n\n.od3-record { background: #fff; border: 1px solid #e8eaf3; border-radius: 22px; overflow: hidden; }\n.od3-tabs { display: flex; gap: 26px; padding: 0 24px; border-bottom: 1px solid #e8eaf3; }\n.od3-tab { position: relative; height: 52px; border: none; background: none; padding: 0; color: #8b8fa4; font-family: inherit; font-size: 13.5px; font-weight: 800; cursor: pointer; transition: color .16s; }\n.od3-tab:hover { color: #3a3e56; }\n.od3-tab[aria-selected=\"true\"] { color: #1d2036; }\n.od3-tab[aria-selected=\"true\"]::after { content: \"\"; position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; background: #ff7a2f; border-radius: 2px 2px 0 0; }\n.od3-tab:focus-visible { outline: 2px solid rgba(255,122,47,0.5); outline-offset: 4px; border-radius: 3px; }\n\n.od3-panel { padding: 22px 24px 24px; min-height: 372px; }\n.od3-colhead { display: flex; align-items: baseline; justify-content: space-between; gap: 14px; margin-bottom: 6px; }\n.od3-colhead h2 { font-family: \"Sora\", sans-serif; font-size: 17px; font-weight: 700; letter-spacing: -0.4px; margin: 0; }\n.od3-colhead span { color: #7b7f95; font-size: 12px; font-weight: 700; }\n\n.od3-split { display: grid; grid-template-columns: minmax(0, 1fr) 344px; gap: 26px; }\n.od3-thead, .od3-row { display: grid; grid-template-columns: minmax(0, 1fr) 56px 100px; gap: 12px; align-items: center; }\n.od3-thead { padding: 12px 0 9px; border-bottom: 1px solid #eef0f7; color: #8b8fa4; font-size: 10.5px; font-weight: 800; letter-spacing: 0.6px; }\n.od3-thead .r { text-align: right; }\n.od3-row { min-height: 66px; border-bottom: 1px solid #f2f4f9; }\n.od3-row:last-of-type { border-bottom: none; }\n.od3-item { display: flex; align-items: center; gap: 13px; min-width: 0; }\n.od3-item img { width: 40px; height: 40px; border-radius: 9px; object-fit: cover; background: #eef0f7; flex-shrink: 0; }\n.od3-name { font-size: 14px; font-weight: 700; line-height: 1.35; overflow-wrap: anywhere; }\n.od3-qty { font-size: 13px; font-weight: 800; color: #3a3e56; font-variant-numeric: tabular-nums; }\n.od3-qty em { font-style: normal; color: #a2a6ba; font-weight: 700; margin-right: 2px; }\n.od3-price { text-align: right; font-size: 13px; font-weight: 700; color: #3a3e56; font-variant-numeric: tabular-nums; }\n.od3-note { display: flex; gap: 11px; margin-top: 14px; padding-top: 13px; border-top: 1px solid #eef0f7; }\n.od3-note i { color: #e8651e; font-size: 14px; margin-top: 2px; }\n.od3-note span { display: block; font-size: 10px; font-weight: 800; letter-spacing: 0.7px; color: #8b8fa4; }\n.od3-note p { margin: 4px 0 0; font-size: 13px; color: #3f4359; line-height: 1.5; }\n\n.od3-bill { padding-left: 26px; border-left: 1px solid #eef0f7; }\n.od3-bill h2 { font-family: \"Sora\", sans-serif; font-size: 17px; font-weight: 700; letter-spacing: -0.4px; margin: 0 0 10px; }\n.od3-line { display: flex; justify-content: space-between; align-items: baseline; gap: 14px; padding: 4px 0; font-size: 13px; color: #5d6179; }\n.od3-line b { font-weight: 700; color: #3a3e56; font-variant-numeric: tabular-nums; }\n.od3-total { display: flex; justify-content: space-between; align-items: baseline; gap: 14px; margin-top: 13px; padding-top: 15px; border-top: 1px solid #e2e5f0; }\n.od3-total span { font-size: 13px; font-weight: 800; color: #3a3e56; }\n.od3-total strong { font-family: \"Sora\", sans-serif; font-size: 25px; font-weight: 800; letter-spacing: -0.9px; font-variant-numeric: tabular-nums; }\n.od3-billnote { margin-top: 18px; color: #8b8fa4; font-size: 11.5px; line-height: 1.5; }\n\n.od3-delivery { display: grid; grid-template-columns: 220px minmax(0, 1fr) 200px; }\n.od3-dcol { padding-right: 28px; }\n.od3-dcol + .od3-dcol { padding-left: 28px; padding-right: 28px; border-left: 1px solid #eef0f7; }\n.od3-dcol:last-child { padding-right: 0; }\n.od3-name-lg { font-size: 18px; font-weight: 800; letter-spacing: -0.3px; }\n.od3-phone { display: inline-flex; align-items: center; gap: 7px; margin-top: 8px; color: #5d6179; font-size: 14px; font-weight: 600; text-decoration: none; }\n.od3-phone i { color: #ff7a2f; font-size: 12px; }\n.od3-landmark { margin: 0 0 6px; font-size: 16px; font-weight: 800; line-height: 1.4; }\n.od3-addr { margin: 0; font-size: 15.5px; line-height: 1.65; color: #4c5068; }\n.od3-time { font-family: \"Sora\", sans-serif; font-size: 22px; font-weight: 800; letter-spacing: -0.7px; }\n.od3-date { display: block; margin-top: 4px; color: #7b7f95; font-size: 13px; font-weight: 600; }\n\n.od3-footer { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 15px 24px; border-top: 1px solid #e8eaf3; background: #fcfcfe; }\n.od3-footer-state { display: flex; align-items: center; gap: 10px; }\n.od3-footer-state .dot { width: 7px; height: 7px; border-radius: 50%; background: #f5a524; box-shadow: 0 0 0 4px rgba(245,165,36,0.15); }\n.od3-footer-state b { font-family: \"Sora\", sans-serif; font-size: 13px; font-weight: 700; letter-spacing: 0.3px; }\n.od3-footer-state span { color: #8b8fa4; font-size: 12px; font-weight: 600; padding-left: 10px; border-left: 1px solid #e3e6f0; }\n.od3-btns { display: flex; align-items: center; gap: 10px; }\n.od3-cancel { display: inline-flex; align-items: center; gap: 8px; height: 42px; padding: 0 18px; border-radius: 11px; border: 1px solid #ecd9d9; background: #fff; color: #c94a4a; font-family: inherit; font-size: 12.5px; font-weight: 800; cursor: pointer; transition: background .18s, border-color .18s; }\n.od3-cancel:hover { background: #fff4f4; border-color: #e2bdbd; }\n.od3-accept { display: inline-flex; align-items: center; gap: 8px; height: 44px; padding: 0 20px; border-radius: 11px; border: none; background: #ff7a2f; color: #fff; font-family: inherit; font-size: 13px; font-weight: 800; cursor: pointer; box-shadow: 0 8px 18px rgba(255,122,47,0.26); transition: background .18s; }\n.od3-accept:hover { background: #f26a1c; }\n.od3-cancel:focus-visible, .od3-accept:focus-visible, .od3-back:focus-visible { outline: 3px solid rgba(255,122,47,0.45); outline-offset: 2px; }\n[hidden] { display: none !important; }\n</style>\n<div class=\"od3-page\" data-kid=\"1\" data-name=\"order details page container\">\n<a class=\"od3-back\" data-kid=\"1-1\" data-name=\"back to orders link\" href=\"#\"><i class=\"bi bi-arrow-left\" data-kid=\"1-1-1\" data-name=\"left arrow icon\"></i>Orders</a>\n<header class=\"od3-head\" data-kid=\"1-2\" data-name=\"order details header\">\n<div data-kid=\"1-2-1\" data-name=\"order title and meta group\">\n<h1 data-kid=\"1-2-1-1\" data-name=\"order details headline\">Order details</h1>\n<div class=\"od3-meta\" data-kid=\"1-2-1-2\" data-name=\"order meta info row\">\n<span class=\"id\" data-kid=\"1-2-1-2-1\" data-name=\"order ID badge\">#68f3a1c9e42b7d0a1f6c8e35</span>\n<span class=\"sep\" data-kid=\"1-2-1-2-2\" data-name=\"meta separator dot\"></span>\n<span data-kid=\"1-2-1-2-3\" data-name=\"order placed date time text\">Placed 5 November 2026, 1:42 PM</span>\n</div>\n</div>\n<span class=\"od3-chip\" data-kid=\"1-2-2\" data-name=\"order status chip\"><span data-kid=\"1-2-2-1\" data-name=\"status indicator dot\"></span>PLACED</span>\n</header>\n<section class=\"od3-facts\" data-kid=\"1-3\" data-name=\"order facts summary bar\">\n<div class=\"od3-fact\" data-kid=\"1-3-1\" data-name=\"customer fact cell\">\n<span class=\"od3-k\" data-kid=\"1-3-1-1\" data-name=\"customer label\">CUSTOMER</span>\n<div class=\"od3-v\" data-kid=\"1-3-1-2\" data-name=\"customer name value\">Aarav Mehta</div>\n</div>\n<div class=\"od3-fact\" data-kid=\"1-3-2\" data-name=\"estimated delivery fact cell\">\n<span class=\"od3-k\" data-kid=\"1-3-2-1\" data-name=\"estimated delivery label\">ESTIMATED DELIVERY</span>\n<div class=\"od3-v\" data-kid=\"1-3-2-2\" data-name=\"delivery time value\">02:30 PM<small data-kid=\"1-3-2-2-1\" data-name=\"delivery date subtext\">5 Nov 2026</small></div>\n</div>\n<div class=\"od3-fact\" data-kid=\"1-3-3\" data-name=\"payment method fact cell\">\n<span class=\"od3-k\" data-kid=\"1-3-3-1\" data-name=\"payment method label\">PAYMENT METHOD</span>\n<div class=\"od3-v\" data-kid=\"1-3-3-2\" data-name=\"payment method value\">ONLINE</div>\n</div>\n<div class=\"od3-fact\" data-kid=\"1-3-4\" data-name=\"payment status fact cell\">\n<span class=\"od3-k\" data-kid=\"1-3-4-1\" data-name=\"payment status label\">PAYMENT STATUS</span>\n<div class=\"od3-v od3-paid\" data-kid=\"1-3-4-2\" data-name=\"paid status value\"><i class=\"bi bi-check-circle-fill\" data-kid=\"1-3-4-2-1\" data-name=\"checkmark icon\"></i>PAID</div>\n</div>\n</section>\n<section class=\"od3-record\" data-kid=\"1-4\" data-name=\"order record card\">\n<div aria-label=\"Order record\" class=\"od3-tabs\" data-kid=\"1-4-1\" data-name=\"order record tab list\" role=\"tablist\">\n<button aria-controls=\"od3-panel-items\" aria-selected=\"true\" class=\"od3-tab\" data-kid=\"1-4-1-1\" data-name=\"items and bill tab\" id=\"od3-tab-items\" role=\"tab\">Items &amp; bill</button>\n<button aria-controls=\"od3-panel-delivery\" aria-selected=\"false\" class=\"od3-tab\" data-kid=\"1-4-1-2\" data-name=\"delivery tab\" id=\"od3-tab-delivery\" role=\"tab\" tabindex=\"-1\">Delivery</button>\n</div>\n<div aria-labelledby=\"od3-tab-items\" class=\"od3-panel\" data-kid=\"1-4-2\" data-name=\"items and bill panel\" id=\"od3-panel-items\" role=\"tabpanel\">\n<div class=\"od3-split\" data-kid=\"1-4-2-1\" data-name=\"panel split layout container\">\n<div data-kid=\"1-4-2-1-1\" data-name=\"ordered items section\">\n<div class=\"od3-colhead\" data-kid=\"1-4-2-1-1-1\" data-name=\"ordered items column header\">\n<h2 data-kid=\"1-4-2-1-1-1-1\" data-name=\"ordered items heading\">Ordered items</h2>\n<span data-kid=\"1-4-2-1-1-1-2\" data-name=\"item count label\">7 items</span>\n</div>\n<div class=\"od3-thead\" data-kid=\"1-4-2-1-1-2\" data-name=\"items table header row\">\n<span data-kid=\"1-4-2-1-1-2-1\" data-name=\"item column header\">Item</span>\n<span data-kid=\"1-4-2-1-1-2-2\" data-name=\"quantity column header\">Qty</span>\n<span class=\"r\" data-kid=\"1-4-2-1-1-2-3\" data-name=\"unit price column header\">Unit price</span>\n</div>\n<div class=\"od3-row\" data-kid=\"1-4-2-1-1-3\" data-name=\"food item row for biryani\">\n<div class=\"od3-item\" data-kid=\"1-4-2-1-1-3-1\" data-name=\"item name group\">\n<img alt=\"Chicken Dum Biryani — Prabal Pratap Singh on Pexels\" data-kid=\"1-4-2-1-1-3-1-1\" data-name=\"item thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/9609860/pexels-photo-9609860.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=160&amp;q=80\"/>\n<span class=\"od3-name\" data-kid=\"1-4-2-1-1-3-1-2\" data-name=\"item name text\">Chicken Dum Biryani (Full)</span>\n</div>\n<span class=\"od3-qty\" data-kid=\"1-4-2-1-1-3-2\" data-name=\"quantity value\"><em data-kid=\"1-4-2-1-1-3-2-1\" data-name=\"multiplication symbol\">×</em>2</span>\n<span class=\"od3-price\" data-kid=\"1-4-2-1-1-3-3\" data-name=\"unit price value\">₹380.00</span>\n</div>\n<div class=\"od3-row\" data-kid=\"1-4-2-1-1-4\" data-name=\"food item row for paneer\">\n<div class=\"od3-item\" data-kid=\"1-4-2-1-1-4-1\" data-name=\"item name group\">\n<img alt=\"Paneer Butter Masala — dhiraj jain on Pexels\" data-kid=\"1-4-2-1-1-4-1-1\" data-name=\"item thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/12737805/pexels-photo-12737805.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=160&amp;q=80\"/>\n<span class=\"od3-name\" data-kid=\"1-4-2-1-1-4-1-2\" data-name=\"item name text\">Paneer Butter Masala</span>\n</div>\n<span class=\"od3-qty\" data-kid=\"1-4-2-1-1-4-2\" data-name=\"quantity value\"><em data-kid=\"1-4-2-1-1-4-2-1\" data-name=\"multiplication symbol\">×</em>1</span>\n<span class=\"od3-price\" data-kid=\"1-4-2-1-1-4-3\" data-name=\"unit price value\">₹320.00</span>\n</div>\n<div class=\"od3-row\" data-kid=\"1-4-2-1-1-5\" data-name=\"food item row for naan\">\n<div class=\"od3-item\" data-kid=\"1-4-2-1-1-5-1\" data-name=\"item name group\">\n<img alt=\"Butter Naan — Gözde Z. on Pexels\" data-kid=\"1-4-2-1-1-5-1-1\" data-name=\"item thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/38163958/pexels-photo-38163958.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=160&amp;q=80\"/>\n<span class=\"od3-name\" data-kid=\"1-4-2-1-1-5-1-2\" data-name=\"item name text\">Butter Naan</span>\n</div>\n<span class=\"od3-qty\" data-kid=\"1-4-2-1-1-5-2\" data-name=\"quantity value\"><em data-kid=\"1-4-2-1-1-5-2-1\" data-name=\"multiplication symbol\">×</em>3</span>\n<span class=\"od3-price\" data-kid=\"1-4-2-1-1-5-3\" data-name=\"unit price value\">₹55.00</span>\n</div>\n<div class=\"od3-row\" data-kid=\"1-4-2-1-1-6\" data-name=\"food item row for gulab jamun\">\n<div class=\"od3-item\" data-kid=\"1-4-2-1-1-6-1\" data-name=\"item name group\">\n<img alt=\"Gulab Jamun — Kiran on Pexels\" data-kid=\"1-4-2-1-1-6-1-1\" data-name=\"item thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/7406887/pexels-photo-7406887.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=160&amp;q=80\"/>\n<span class=\"od3-name\" data-kid=\"1-4-2-1-1-6-1-2\" data-name=\"item name text\">Gulab Jamun (2 pcs)</span>\n</div>\n<span class=\"od3-qty\" data-kid=\"1-4-2-1-1-6-2\" data-name=\"quantity value\"><em data-kid=\"1-4-2-1-1-6-2-1\" data-name=\"multiplication symbol\">×</em>1</span>\n<span class=\"od3-price\" data-kid=\"1-4-2-1-1-6-3\" data-name=\"unit price value\">₹120.00</span>\n</div>\n<div class=\"od3-note\" data-kid=\"1-4-2-1-1-7\" data-name=\"order instructions note\">\n<i class=\"bi bi-chat-left-text\" data-kid=\"1-4-2-1-1-7-1\" data-name=\"chat bubble icon\"></i>\n<div data-kid=\"1-4-2-1-1-7-2\" data-name=\"note text group\">\n<span data-kid=\"1-4-2-1-1-7-2-1\" data-name=\"note label\">ORDER INSTRUCTIONS</span>\n<p data-kid=\"1-4-2-1-1-7-2-2\" data-name=\"note instruction text\">Less spicy. Pack the naan separately.</p>\n</div>\n</div>\n</div>\n<div class=\"od3-bill\" data-kid=\"1-4-2-1-2\" data-name=\"bill summary panel\">\n<h2 data-kid=\"1-4-2-1-2-1\" data-name=\"bill heading\">Bill</h2>\n<div class=\"od3-line\" data-kid=\"1-4-2-1-2-2\" data-name=\"subtotal line\"><span data-kid=\"1-4-2-1-2-2-1\" data-name=\"subtotal label\">Subtotal</span><b data-kid=\"1-4-2-1-2-2-2\" data-name=\"subtotal amount\">₹1,365.00</b></div>\n<div class=\"od3-line\" data-kid=\"1-4-2-1-2-3\" data-name=\"delivery fee line\"><span data-kid=\"1-4-2-1-2-3-1\" data-name=\"delivery fee label\">Delivery fee</span><b data-kid=\"1-4-2-1-2-3-2\" data-name=\"delivery fee amount\">₹40.00</b></div>\n<div class=\"od3-line\" data-kid=\"1-4-2-1-2-4\" data-name=\"tax line\"><span data-kid=\"1-4-2-1-2-4-1\" data-name=\"tax label\">Tax</span><b data-kid=\"1-4-2-1-2-4-2\" data-name=\"tax amount\">₹68.00</b></div>\n<div class=\"od3-line\" data-kid=\"1-4-2-1-2-5\" data-name=\"discount line\"><span data-kid=\"1-4-2-1-2-5-1\" data-name=\"discount label\">Discount</span><b data-kid=\"1-4-2-1-2-5-2\" data-name=\"discount amount\">−₹50.00</b></div>\n<div class=\"od3-total\" data-kid=\"1-4-2-1-2-6\" data-name=\"total amount row\"><span data-kid=\"1-4-2-1-2-6-1\" data-name=\"order total label\">Order total</span><strong data-kid=\"1-4-2-1-2-6-2\" data-name=\"order total amount\">₹1,423.00</strong></div>\n</div>\n</div>\n</div>\n<div aria-labelledby=\"od3-tab-delivery\" class=\"od3-panel\" data-kid=\"1-4-3\" data-name=\"delivery details panel\" hidden=\"\" id=\"od3-panel-delivery\" role=\"tabpanel\">\n<div class=\"od3-delivery\" data-kid=\"1-4-3-1\" data-name=\"delivery info grid\">\n<div class=\"od3-dcol\" data-kid=\"1-4-3-1-1\" data-name=\"delivery customer column\">\n<span class=\"od3-k\" data-kid=\"1-4-3-1-1-1\" data-name=\"customer label\">CUSTOMER</span>\n<div class=\"od3-name-lg\" data-kid=\"1-4-3-1-1-2\" data-name=\"customer name\">Aarav Mehta</div>\n<a class=\"od3-phone\" data-kid=\"1-4-3-1-1-3\" data-name=\"phone link\" href=\"tel:+919820455671\"><i class=\"bi bi-telephone\" data-kid=\"1-4-3-1-1-3-1\" data-name=\"phone icon\"></i>+91 98204 55671</a>\n</div>\n<div class=\"od3-dcol\" data-kid=\"1-4-3-1-2\" data-name=\"delivery address column\">\n<span class=\"od3-k\" data-kid=\"1-4-3-1-2-1\" data-name=\"delivery address label\">DELIVERY ADDRESS</span>\n<p class=\"od3-landmark\" data-kid=\"1-4-3-1-2-2\" data-name=\"landmark text\">Opposite Bandra Police Station</p>\n<p class=\"od3-addr\" data-kid=\"1-4-3-1-2-3\" data-name=\"full address text\">402, Sunrose Apartments, Turner Road,<br data-kid=\"1-4-3-1-2-3-1\" data-name=\"line break\"/>Mumbai, Maharashtra 400050</p>\n</div>\n<div class=\"od3-dcol\" data-kid=\"1-4-3-1-3\" data-name=\"delivery time column\">\n<span class=\"od3-k\" data-kid=\"1-4-3-1-3-1\" data-name=\"estimated delivery label\">ESTIMATED DELIVERY</span>\n<div class=\"od3-time\" data-kid=\"1-4-3-1-3-2\" data-name=\"delivery time value\">02:30 PM</div>\n<span class=\"od3-date\" data-kid=\"1-4-3-1-3-3\" data-name=\"delivery date value\">5 November 2026</span>\n</div>\n</div>\n</div>\n<div class=\"od3-footer\" data-kid=\"1-4-4\" data-name=\"order action footer\">\n<div class=\"od3-footer-state\" data-kid=\"1-4-4-1\" data-name=\"order status indicator\">\n<span class=\"dot\" data-kid=\"1-4-4-1-1\" data-name=\"status pulsing dot\"></span>\n<b data-kid=\"1-4-4-1-2\" data-name=\"status text\">PLACED</b>\n<span data-kid=\"1-4-4-1-3\" data-name=\"last updated timestamp\">5 Nov 2026, 1:42 PM</span>\n</div>\n<div class=\"od3-btns\" data-kid=\"1-4-4-2\" data-name=\"footer action buttons group\">\n<button class=\"od3-cancel\" data-kid=\"1-4-4-2-1\" data-name=\"cancel order button\"><i class=\"bi bi-x-lg\" data-kid=\"1-4-4-2-1-1\" data-name=\"cancel x icon\"></i>Cancel order</button>\n<button class=\"od3-accept\" data-kid=\"1-4-4-2-2\" data-name=\"accept order button\">Accept order<i class=\"bi bi-check2\" data-kid=\"1-4-4-2-2-1\" data-name=\"checkmark icon\"></i></button>\n</div>\n</div>\n</section>\n</div>\n<script>\n  const tabs = document.querySelectorAll('.od3-tab');\n  const panels = document.querySelectorAll('.od3-panel');\n  tabs.forEach((tab, i) => {\n    tab.addEventListener('click', () => selectTab(i));\n    tab.addEventListener('keydown', (e) => {\n      if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {\n        e.preventDefault();\n        const next = (i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length;\n        selectTab(next);\n        tabs[next].focus();\n      }\n    });\n  });\n  function selectTab(index) {\n    tabs.forEach((t, i) => {\n      t.setAttribute('aria-selected', String(i === index));\n      t.setAttribute('tabindex', i === index ? '0' : '-1');\n    });\n    panels.forEach((p, i) => { p.hidden = i !== index; });\n  }\n</script>",

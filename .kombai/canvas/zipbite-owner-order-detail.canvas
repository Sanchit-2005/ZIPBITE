 biryani. Cut the naan in half and send extra raita.\n          </p>\n</section>\n</div>\n<!-- Order items -->\n<section class=\"bg-white rounded-[22px] p-6 shadow-[0_8px_30px_rgba(21,24,46,0.06)]\" data-kid=\"1-2-4-2\" data-name=\"order items card\">\n<div class=\"flex items-center justify-between gap-4\" data-kid=\"1-2-4-2-1\" data-name=\"order items header row\">\n<h2 class=\"zbo-display text-[18px] font-bold text-[#15182e]\" data-kid=\"1-2-4-2-1-1\" data-name=\"section title order items\">Order items</h2>\n<div class=\"flex items-center gap-4 text-[13px] font-semibold text-[#7b7f95]\" data-kid=\"1-2-4-2-1-2\" data-name=\"items and units count summary\">\n<span data-kid=\"1-2-4-2-1-2-1\" data-name=\"item count label\">4 items</span>\n<span data-kid=\"1-2-4-2-1-2-2\" data-name=\"unit count label\">8 units</span>\n</div>\n</div>\n<div class=\"mt-4 grid grid-cols-[1fr_64px_100px_110px] items-center pb-2 border-b border-[#e8eaf3] text-[13px] font-semibold text-[#7b7f95]\" data-kid=\"1-2-4-2-2\" data-name=\"table column header row\">\n<span data-kid=\"1-2-4-2-2-1\" data-name=\"item column header\">Item</span>\n<span class=\"text-right\" data-kid=\"1-2-4-2-2-2\" data-name=\"qty column header\">Qty</span>\n<span class=\"text-right\" data-kid=\"1-2-4-2-2-3\" data-name=\"unit price column header\">Unit price</span>\n<span class=\"text-right\" data-kid=\"1-2-4-2-2-4\" data-name=\"amount column header\">Amount</span>\n</div>\n<div class=\"grid grid-cols-[1fr_64px_100px_110px] items-center h-[68px] border-b border-[#f0f2f8]\" data-kid=\"1-2-4-2-3\" data-name=\"item row biryani\">\n<div class=\"flex items-center gap-3 min-w-0 pr-3\" data-kid=\"1-2-4-2-3-1\" data-name=\"item name row\">\n<img alt=\"Hyderabadi Dum Biryani — Saveurs Secretes on Pexels\" class=\"w-11 h-11 rounded-[9px] object-cover bg-[#f0f2f8] shrink-0\" data-kid=\"1-2-4-2-3-1-1\" data-name=\"item thumbnail image false\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/7394819/pexels-ph
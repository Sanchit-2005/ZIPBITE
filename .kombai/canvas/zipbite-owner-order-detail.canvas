title\">Payment &amp; delivery</h3>\n<div class=\"mt-4\" data-kid=\"1-2-3-2-2\" data-name=\"estimated delivery field\">\n<span class=\"block text-[12px] font-medium text-[#7b7f95]\" data-kid=\"1-2-3-2-2-1\" data-name=\"estimated delivery label\">Estimated delivery</span>\n<span class=\"mt-0.5 block text-[14px] font-semibold leading-[20px] text-[#1d2036]\" data-kid=\"1-2-3-2-2-2\" data-name=\"estimated delivery value\">November 4, 2026<br data-kid=\"1-2-3-2-2-2-1\" data-name=\"delivery value line break\"/>07:14 PM</span>\n</div>\n<div class=\"mt-4\" data-kid=\"1-2-3-2-3\" data-name=\"payment method field\">\n<span class=\"block text-[12px] font-medium text-[#7b7f95]\" data-kid=\"1-2-3-2-3-1\" data-name=\"payment method label\">Payment method</span>\n<span class=\"mt-0.5 block text-[14px] font-semibold text-[#1d2036]\" data-kid=\"1-2-3-2-3-2\" data-name=\"payment method value\">Online payment</span>\n</div>\n<div class=\"mt-4\" data-kid=\"1-2-3-2-4\" data-name=\"payment status field\">\n<span class=\"block text-[12px] font-medium text-[#7b7f95]\" data-kid=\"1-2-3-2-4-1\" data-name=\"payment status label\">Payment status</span>\n<span class=\"mt-1.5 inline-flex h-7 items-center gap-1.5 rounded-full bg-[#e1f8ee] px-3 text-[11px] font-extrabold tracking-[0.05em] text-[#139660]\" data-kid=\"1-2-3-2-4-2\" data-name=\"paid status badge\">\n<span class=\"h-1.5 w-1.5 rounded-full bg-current\" data-kid=\"1-2-3-2-4-2-1\" data-name=\"paid status pulse dot\"></span>\n            PAID\n          </span>\n</div>\n</section>\n<!-- Bill -->\n<section class=\"flex flex-col rounded-[18px] bg-white p-5 shadow-[0_6px_20px_rgba(21,24,46,0.05)]\" data-kid=\"1-2-3-3\" data-name=\"bill card\">\n<h3 class=\"ff-sora text-[15px] font-bold text-[#15182e]\" data-kid=\"1-2-3-3-1\" data-name=\"bill card title\">Bill</h3>\n<div class=\"mt-3\" data-kid=\"1-2-3-3-2\" data-name=\"bill line items\">\n<div class=\"flex h-7 items-center justify-between\" data-kid=\"1-2-3-3-2-1\" data-name=\"subtotal bill line\">\n<span class=\"text-[13.5px] text-[#7b7f95]\" data-kid=\"1-2-3-3-2-1-1\" data-name=\"subtotal label\">Subtotal</span>\n<span class=\"tnum text-[14px] font-semibold text-[#1d2036]\" data-kid=\"1-2-3-3-2-1-2\" data-name=\"subtotal amount\">₹1,472</span>\n</div>\n<div class=\"flex h-7 items-center justify-between\" data-kid=\"1-2-3-3-2-2\" data-name=\"delivery fee bill line\">\n<span class=\"text-[13.5px] text-[#7b7f95]\" data-kid=\"1-2-3-3-2-2-1\" data-name=\"delivery fee label\">Delivery fee</span>\n<span class=\"tnum text-[14px] font-semibold text-[#1d2036]\" data-kid=\"1-2-3-3-2-2-2\" data-name=\"delivery fee amount\">₹29</span>\n</div>\n<div class=\"flex h-7 items-center justify-between\" data-kid=\"1-2-3-3-2-3\" data-name=\"tax bill line\">\n<span class=\"text-[13.5px] text-[#7b7f95]\" data-kid=\"1-2-3-3-2-3-1\" data-name=\"tax label\">Tax</span>\n<span class=\"tnum text-[14px] font-semibold text-[#1d2036]\" data-kid=\"1-2-3-3-2-3-2\" data-name=\"tax amount\">₹74</span>\n</div>\n<div class=\"flex h-7 items-center justify-between\" data-kid=\"1-2-3-3-2-4\" data-name=\"discount bill line\">\n<span class=\"text-[13.5px] text-[#7b7f95]\" data-kid=\"1-2-3-3-2-4-1\" data-name=\"discount label\">Discount</span>\n<span class=\"tnum text-[14px] font-semibold text-[#1d2036]\" data-kid=\"1-2-3-3-2-4-2\" data-name=\"discount amount\">− ₹50</span>\n</div>\n</div>\n<div class=\"mt-auto flex items-center justify-between border-t border-[#e8eaf3] pt-3.5\" data-kid=\"1-2-3-3-3\" data-name=\"bill total row\">\n<span class=\"text-[14px] font-bold text-[#1d2036]\" data-kid=\"1-2-3-3-3-1\" data-name=\"total label\">Total</span>\n<span class=\"ff-sora tnum text-[22px] font-extrabold leading-none tracking-[-0.02em] text-[#15182e]\" data-kid=\"1-2-3-3-3-2\" data-name=\"total amount\">₹1,525</span>\n</div>\n</section>\n</div>\n<div class=\"flex-1\" data-kid=\"1-2-4\" data-name=\"spacer filler area\"></div>\n<!-- Decision dock -->\n<div class=\"mt-5 border-t border-[#e8eaf3] bg-white px-6 pb-4\" data-kid=\"1-2-5\" data-name=\"action dock bar\">\n<div class=\"flex h-[88px] items-center justify-between gap-6\" data-kid=\"1-2-5-1\" data-name=\"action dock row\">\n<div class=\"flex items-end gap-8\" data-kid=\"1-2-5-1-1\" data-name=\"order summary mini stats\">\n<div class=\"pb-0.5\" data-kid=\"1-2-5-1-1-1\" data-name=\"units mini stat\">\n<span class=\"block text-[12px] font-medium text-[#7b7f95]\" data-kid=\"1-2-5-1-1-1-1\" data-name=\"units mini label\">Units</span>\n<span class=\"tnum block text-[15px] font-bold leading-tight text-[#1d2036]\" data-kid=\"1-2-5-1-1-1-2\" data-name=\"units mini value\">8</span>\n</div>\n<div data-kid=\"1-2-5-1-1-2\" data-name=\"order total mini stat\">\n<span class=\"block text-[12px] font-medium text-[#7b7f95]\" data-kid=\"1-2-5-1-1-2-1\" data-name=\"order total mini label\">Order total</span>\n<span class=\"ff-sora tnum mt-0.5 block text-[26px] font-extrabold leading-none tracking-[-0.02em] text-[#15182e]\" data-kid=\"1-2-5-1-1-2-2\" data-name=\"order total mini value\">₹1,525</span>\n</div>\n</div>\n<div class=\"flex shrink-0 items-center gap-3\" data-kid=\"1-2-5-1-2\" data-name=\"order action button group\">\n<button class=\"h-11 w-[160px] rounded-[12px] border border-[#e8eaf3] bg-white text-[14px] font-bold text-[#d03f3f] transition-colors hover:border-[#d03f3f]\" data-kid=\"1-2-5-1-2-1\" data-name=\"reject order button\" type=\"button\">\n            Reject order\n          </button>\n<button class=\"inline-flex h-11 w-[192px] items-center justify-center gap-2 rounded-[12px] bg-[#ff7a2f] text-[14px] font-bold text-white shadow-[0_8px_18px_rgba(255,122,47,0.3)] transition-colors hover:bg-[#f06c1f]\" data-kid=\"1-2-5-1-2-2\" data-name=\"accept order button\" type=\"button\">\n            Accept order\n            <i class=\"bi bi-check2 text-[16px]\" data-kid=\"1-2-5-1-2-2-1\" data-name=\"accept checkmark icon\"></i>\n</button>\n</div>\n</div>\n</div>\n</div>\n</div>\n",

e=\"subtotal label\">Subtotal</dt>\n<dd class=\"font-semibold tabular-nums text-[#1d2036]\" data-kid=\"1-2-1-2-1-4-1-1-2\" data-name=\"subtotal value\">₹1,472</dd>\n</div>\n<div class=\"flex items-center justify-between gap-4\" data-kid=\"1-2-1-2-1-4-1-2\" data-name=\"discount row\">\n<dt class=\"text-[#7b7f95]\" data-kid=\"1-2-1-2-1-4-1-2-1\" data-name=\"discount label\">Discount</dt>\n<dd class=\"font-semibold tabular-nums text-[#139660]\" data-kid=\"1-2-1-2-1-4-1-2-2\" data-name=\"discount value\">−₹50</dd>\n</div>\n<div class=\"flex items-center justify-between gap-4\" data-kid=\"1-2-1-2-1-4-1-3\" data-name=\"delivery fee row\">\n<dt class=\"text-[#7b7f95]\" data-kid=\"1-2-1-2-1-4-1-3-1\" data-name=\"delivery fee label\">Delivery fee</dt>\n<dd class=\"font-semibold tabular-nums text-[#1d2036]\" data-kid=\"1-2-1-2-1-4-1-3-2\" data-name=\"delivery fee value\">₹29</dd>\n</div>\n<div class=\"flex items-center justify-between gap-4\" data-kid=\"1-2-1-2-1-4-1-4\" data-name=\"tax row\">\n<dt class=\"text-[#7b7f95]\" data-kid=\"1-2-1-2-1-4-1-4-1\" data-name=\"tax label\">Tax</dt>\n<dd class=\"font-semibold tabular-nums text-[#1d2036]\" data-kid=\"1-2-1-2-1-4-1-4-2\" data-name=\"tax value\">₹74</dd>\n</div>\n</dl>\n<div class=\"flex items-baseline gap-3\" data-kid=\"1-2-1-2-1-4-2\" data-name=\"total price display\">\n<span class=\"text-[13px] font-semibold text-[#7b7f95]\" data-kid=\"1-2-1-2-1-4-2-1\" data-name=\"total label\">Total</span>\n<span class=\"font-['Sora'] text-[20px] font-bold tabular-nums tracking-[-0.4px] text-[#15182e]\" data-kid=\"1-2-1-2-1-4-2-2\" data-name=\"total price value\">₹1,525</span>\n</div>\n</div>\n</section>\n<div class=\"flex flex-col gap-5\" data-kid=\"1-2-1-2-2\" data-name=\"right column card stack\">\n<section class=\"rounded-[22px] bg-white p-6 shadow-[0_8px_30px_rgba(21,24,46,0.06)]\" data-kid=\"1-2-1-2-2-1\" data-name=\"order status and actions card\">\n<span class=\"inline-flex items-center gap-2 rounded-full bg-[#fff3dc] px-3 py-1.5 text-[11.5px] font-extrabold tracking-[0.3px] text-[#c2780a]\" data-kid=\"1-2-1-2-2-1-1\" data-name=\"order status badge\">\n<span class=\"h-1.5 w-1.5 rounded-full bg-current\" data-kid=\"1-2-1-2-2-1-1-1\" data-name=\"status badge indicator dot\"></span>\n              PLACED\n            </span>\n<dl class=\"mt-5 space-y-3.5 text-[13.5px]\" data-kid=\"1-2-1-2-2-1-2\" data-name=\"order details list\">\n<div data-kid=\"1-2-1-2-2-1-2-1\" data-name=\"estimated delivery item\">\n<dt class=\"text-[#7b7f95]\" data-kid=\"1-2-1-2-2-1-2-1-1\" data-name=\"estimated delivery label\">Estimated delivery</dt>\n<dd class=\"mt-1 text-[15px] font-semibold leading-[22px] text-[#15182e]\" data-kid=\"1-2-1-2-2-1-2-1-2\" data-name=\"estimated delivery value\">November 4, 2026 at 07:14 PM</dd>\n</div>\n<div class=\"grid grid-cols-2 gap-4\" data-kid=\"1-2-1-2-2-1-2-2\" data-name=\"payment info row\">\n<div data-kid=\"1-2-1-2-2-1-2-2-1\" data-name=\"payment method item\">\n<dt class=\"text-[#7b7f95]\" data-kid=\"1-2-1-2-2-1-2-2-1-1\" data-name=\"payment method label\">Payment method</dt>\n<dd class=\"mt-1 font-semibold text-[#1d2036]\" data-kid=\"1-2-1-2-2-1-2-2-1-2\" data-name=\"payment method value\">Online payment</dd>\n</div>\n<div data-kid=\"1-2-1-2-2-1-2-2-2\" data-name=\"payment status item\">\n<dt class=\"text-[#7b7f95]\" data-kid=\"1-2-1-2-2-1-2-2-2-1\" data-name=\"payment status label\">Payment status</dt>\n<dd class=\"mt-1\" data-kid=\"1-2-1-2-2-1-2-2-2-2\" data-name=\"payment status value wrapper\">\n<span class=\"inline-flex items-center gap-2 rounded-full bg-[#e1f8ee] px-2.5 py-1 text-[11.5px] font-extrabold tracking-[0.3px] text-[#139660]\" data-kid=\"1-2-1-2-2-1-2-2-2-2-1\" data-name=\"payment status paid badge\">\n<span class=\"h-1.5 w-1.5 rounded-full bg-current\" data-kid=\"1-2-1-2-2-1-2-2-2-2-1-1\" data-name=\"paid badge indicator dot\"></span>\n                      PAID\n                    </span>\n</dd>\n</div>\n</div>\n</dl>\n<div class=\"mt-5 border-t border-[#e8eaf3] pt-4\" data-kid=\"1-2-1-2-2-1-3\" data-name=\"order total display block\">\n<span class=\"text-[12.5px] font-semibold text-[#7b7f95]\" data-kid=\"1-2-1-2-2-1-3-1\" data-name=\"order total label\">Order total</span>\n<p class=\"mt-0.5 font-['Sora'] text-[26px] font-bold leading-tight tabular-nums tracking-[-0.8px] text-[#15182e]\" data-kid=\"1-2-1-2-2-1-3-2\" data-name=\"order total amount\">₹1,525</p>\n</div>\n<div class=\"mt-5 flex gap-3\" data-kid=\"1-2-1-2-2-1-4\" data-name=\"order action buttons row\">\n<button class=\"flex h-11 flex-1 items-center justify-center rounded-[12px] bg-[#ff7a2f] text-[14px] font-bold text-white\" data-kid=\"1-2-1-2-2-1-4-1\" data-name=\"accept order primary button\" type=\"button\">Accept order</button>\n<button class=\"flex h-11 flex-1 items-center justify-center rounded-[12px] border border-[#e8eaf3] bg-white text-[14px] font-semibold text-[#d03f3f]\" data-kid=\"1-2-1-2-2-1-4-2\" data-name=\"reject order secondary button\" type=\"button\">Reject order</button>\n</div>\n</section>\n<section class=\"rounded-[22px] bg-white p-6 shadow-[0_8px_30px_rgba(21,24,46,0.06)]\" data-kid=\"1-2-1-2-2-2\" data-name=\"delivery details card\">\n<h2 class=\"font-['Sora'] text-[16px] font-bold tracking-[-0.2px] text-[#15182e]\" data-kid=\"1-2-1-2-2-2-1\" data-name=\"delivery details section title\">Delivery details</h2>\n<div class=\"mt-4\" data-kid=\"1-2-1-2-2-2-2\" data-name=\"delivery contact block\">\n<p class=\"text-[16px] font-semibold leading-[24px] text-[#15182e]\" data-kid=\"1-2-1-2-2-2-2-1\" data-name=\"delivery contact name\">Ananya Rao</p>\n<p class=\"mt-1 flex items-center gap-2 text-[14px] tabular-nums text-[#70758c]\" data-kid=\"1-2-1-2-2-2-2-2\" data-name=\"delivery contact phone line\">\n<i class=\"bi bi-telephone text-[13px] leading-none\" data-kid=\"1-2-1-2-2-2-2-2-1\" data-name=\"phone icon\"></i>\n                +91 98450 22174\n              </p>\n</div>\n<div class=\"mt-4 border-t border-[#e8eaf3] pt-4 text-[14px] leading-[23px] text-[#3a3f57]\" data-kid=\"1-2-1-2-2-2-3\" data-name=\"delivery street address block\">\n<p data-kid=\"1-2-1-2-2-2-3-1\" data-name=\"delivery street address line 1\">402, Palm Grove Apartments, 27th Main Road, Sector 2, HSR Layout</p>\n<p data-kid=\"1-2-1-2-2-2-3-2\" data-name=\"delivery city address line 2\">Bengaluru, Karnataka 560102</p>\n</div>\n<div class=\"mt-4\" data-kid=\"1-2-1-2-2-2-4\" data-name=\"delivery landmark block\">\n<span class=\"text-[12.5px] font-semibold text-[#7b7f95]\" data-kid=\"1-2-1-2-2-2-4-1\" data-name=\"landmark label\">Landmark</span>\n<p class=\"mt-1 text-[14px] leading-[22px] text-[#1d2036]\" data-kid=\"1-2-1-2-2-2-4-2\" data-name=\"landmark value\">Opposite BDA Complex gate</p>\n</div>\n</section>\n</div>\n</div>\n</div>\n</main>\n</div>",

      "html": "<style>\n  @import url(\"https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800&family=Manrope:wght@400;500;600;700;800&display=swap\");\n  @import url(\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css\");\n\n  .zbo { font-family: \"Manrope\", system-ui, sans-serif; }\n  .zbo .zbo-display { font-family: \"Sora\", \"Manrope\", sans-serif; }\n</style>\n<div class=\"zbo flex min-h-screen bg-[#f3f4fa] text-[#1d2036]\" data-kid=\"1\" data-name=\"page layout container\">\n<!-- Owner sidebar -->\n<aside class=\"w-[240px] shrink-0 bg-white border-r border-[#eeeeee] px-4 py-6 flex flex-col\" data-kid=\"1-1\" data-name=\"owner sidebar panel\">\n<div class=\"zbo-display px-3 mb-8 text-[24px] font-extrabold tracking-[0.5px] text-[#ff6b35]\" data-kid=\"1-1-1\" data-name=\"brand logo wordmark\">Zipbite</div>\n<nav class=\"flex flex-col gap-1\" data-kid=\"1-1-2\" data-name=\"side navigation menu\">\n<div class=\"flex items-center gap-3 px-3.5 py-3 rounded-[12px] text-[15px] font-medium text-[#555555]\" data-kid=\"1-1-2-1\" data-name=\"dashboard nav item\">\n<i class=\"bi bi-grid-1x2 text-[17px] text-[#888888]\" data-kid=\"1-1-2-1-1\" data-name=\"grid list icon\"></i>\n<span data-kid=\"1-1-2-1-2\" data-name=\"dashboard nav label\">Dashboard</span>\n</div>\n<div class=\"flex items-center gap-3 px-3.5 py-3 rounded-[12px] text-[15px] font-semibold text-white bg-[#ff6b35] shadow-[0_4px_12px_rgba(255,107,53,0.3)]\" data-kid=\"1-1-2-2\" data-name=\"active orders nav item\">\n<i class=\"bi bi-collection text-[17px]\" data-kid=\"1-1-2-2-1\" data-name=\"collection icon\"></i>\n<span data-kid=\"1-1-2-2-2\" data-name=\"orders nav label\">Orders</span>\n</div>\n<div class=\"flex items-center gap-3 px-3.5 py-3 rounded-[12px] text-[15px] font-medium text-[#555555]\" data-kid=\"1-1-2-3\" data-name=\"menu nav item\">\n<i class=\"bi bi-journal-text text-[17px] text-[#888888]\" data-kid=\"1-1-2-3-1\" data-name=\"journal icon\"></i>\n<span data-kid=\"1-1-2-3-2\" data-name=\"menu nav label\">Menu</span>\n</div>\n<div class=\"flex items-center gap-3 px-3.5 py-3 rounded-[12px] text-[15px] font-medium text-[#555555]\" data-kid=\"1-1-2-4\" data-name=\"profile nav item\">\n<i class=\"bi bi-person text-[17px] text-[#888888]\" data-kid=\"1-1-2-4-1\" data-name=\"person icon\"></i>\n<span data-kid=\"1-1-2-4-2\" data-name=\"profile nav label\">Profile</span>\n</div>\n</nav>\n</aside>\n<!-- Content -->\n<main class=\"flex-1 min-w-0 px-7 py-7\" data-kid=\"1-2\" data-name=\"main content area\">\n<a class=\"inline-flex items-center gap-2 h-9 text-[13.5px] font-semibold text-[#7b7f95]\" data-kid=\"1-2-1\" data-name=\"back to orders button link\" href=\"#\">\n<i class=\"bi bi-arrow-left text-[14px]\" data-kid=\"1-2-1-1\" data-name=\"left arrow icon\"></i>\n      Back to orders\n    </a>\n<!-- Record header -->\n<header class=\"flex items-start justify-between gap-6 mt-1.5 mb-4\" data-kid=\"1-2-2\" data-name=\"record header row\">\n<div class=\"min-w-0\" data-kid=\"1-2-2-1\" data-name=\"order title block\">\n<h1 class=\"zbo-display text-[26px] font-bold leading-none tracking-[-0.8px] text-[#15182e]\" data-kid=\"1-2-2-1-1\" data-name=\"page headline order details\">Order details</h1>\n<div class=\"mt-2.5 flex items-center gap-2 text-[13px] min-w-0\" data-kid=\"1-2-2-1-2\" data-name=\"order ID display row\">\n<span class=\"font-semibold text-[#7b7f95] shrink-0\" data-kid=\"1-2-2-1-2-1\" data-name=\"order ID field label\">Order ID</span>\n<span class=\"font-medium text-[#1d2036] truncate\" data-kid=\"1-2-2-1-2-2\" data-name=\"order ID value text\">6928f3a1c4e7b21d9a6f40b3</span>\n</div>\n</div>\n<div class=\"shrink-0 text-right pt-0.5\" data-kid=\"1-2-2-2\" data-name=\"order placed date block\">\n<span class=\"block text-[13px] font-semibold text-[#7b7f95]\" data-kid=\"1-2-2-2-1\" data-name=\"order placed label\">Order placed</span>\n<span class=\"block mt-1 text-[14px] font-semibold text-[#1d2036] whitespace-nowrap\" data-kid
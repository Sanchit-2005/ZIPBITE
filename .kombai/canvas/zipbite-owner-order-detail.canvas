nt status</span>\n<span class=\"mt-1 inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-[#e1f8ee] text-[#139660] text-[11.5px] font-extrabold tracking-[0.4px]\" data-kid=\"1-2-3-4-2\" data-name=\"payment status PAID badge\">\n<span class=\"w-1.5 h-1.5 rounded-full bg-current\" data-kid=\"1-2-3-4-2-1\" data-name=\"status indicator dot\"></span>\n          PAID\n        </span>\n</div>\n<div class=\"shrink-0\" data-kid=\"1-2-3-5\" data-name=\"total amount block\">\n<span class=\"block text-[13px] font-semibold text-[#7b7f95] whitespace-nowrap\" data-kid=\"1-2-3-5-1\" data-name=\"total amount label\">Total amount</span>\n<span class=\"zbo-display block mt-0.5 text-[18px] font-bold text-[#15182e] tabular-nums whitespace-nowrap\" data-kid=\"1-2-3-5-2\" data-name=\"total amount value\">₹1,525</span>\n</div>\n<div class=\"ml-auto flex items-center gap-3 shrink-0\" data-kid=\"1-2-3-6\" data-name=\"action buttons container\">\n<button class=\"h-11 w-[152px] rounded-[12px] bg-white border border-[#e8eaf3] text-[14px] font-bold text-[#d03f3f]\" data-kid=\"1-2-3-6-1\" data-name=\"reject order button\" type=\"button\">Reject order</button>\n<button class=\"h-11 w-[168px] rounded-[12px] bg-[#ff7a2f] text-[14px] font-bold text-white shadow-[0_10px_24px_rgba(255,122,47,0.32)]\" data-kid=\"1-2-3-6-2\" data-name=\"accept order button\" type=\"button\">Accept order</button>\n</div>\n</section>\n<!-- Body -->\n<div class=\"grid grid-cols-[392px_732px] gap-5 items-start\" data-kid=\"1-2-4\" data-name=\"content two-column grid\">\n<div class=\"flex flex-col gap-5\" data-kid=\"1-2-4-1\" data-name=\"left column of detail cards\">\n<!-- Delivery details -->\n<section class=\"bg-white rounded-[22px] p-6 shadow-[0_8px_30px_rgba(21,24,46,0.06)]\" data-kid=\"1-2-4-1-1\" data-name=\"delivery details card\">\n<div class=\"flex items-center gap-2\" data-kid=\"1-2-4-1-1-1\" data-name=\"section header with icon\">\n<i class=\"bi bi-geo-alt text-[15px] text-[#ff7a2f]\" data-kid=\"1-2-4-1-1-1-
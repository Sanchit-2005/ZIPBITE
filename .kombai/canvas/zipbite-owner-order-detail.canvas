      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800&family=Manrope:wght@400;500;600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css');\n</style>\n<div class=\"flex min-h-screen bg-[#f3f4fa] font-['Manrope'] text-[#1d2036]\" data-kid=\"1\" data-name=\"page layout container\">\n<aside class=\"flex w-[240px] shrink-0 flex-col border-r border-[#eeeeee] bg-white px-4 py-6\" data-kid=\"1-1\" data-name=\"sidebar navigation panel\">\n<h2 class=\"mb-8 px-3 font-['Sora'] text-[24px] font-extrabold tracking-[0.5px] text-[#ff6b35]\" data-kid=\"1-1-1\" data-name=\"brand logo text\">Zipbite</h2>\n<nav class=\"flex flex-col gap-1 text-[15px] font-medium\" data-kid=\"1-1-2\" data-name=\"sidebar navigation menu\">\n<div class=\"flex cursor-pointer select-none items-center gap-3 rounded-[12px] px-3.5 py-3 text-[#555555]\" data-kid=\"1-1-2-1\" data-name=\"Dashboard sidebar nav item\">\n<i class=\"bi bi-grid-1x2 text-[18px] leading-none text-[#888888]\" data-kid=\"1-1-2-1-1\" data-name=\"grid dashboard icon\"></i>\n<span data-kid=\"1-1-2-1-2\" data-name=\"Dashboard nav label\">Dashboard</span>\n</div>\n<div class=\"flex cursor-pointer items-center gap-3 rounded-[12px] bg-[#ff6b35] px-3.5 py-3 font-semibold text-white shadow-[0_4px_12px_rgba(255,107,53,0.3)]\" data-kid=\"1-1-2-2\" data-name=\"Orders active sidebar nav item\">\n<i class=\"bi bi-receipt-cutoff text-[18px] leading-none text-white\" data-kid=\"1-1-2-2-1\" data-name=\"receipt orders icon\"></i>\n<span data-kid=\"1-1-2-2-2\" data-name=\"Orders nav label\">Orders</span>\n</div>\n<div class=\"flex cursor-pointer items-center gap-3 rounded-[12px] px-3.5 py-3 text-[#555555]\" data-kid=\"1-1-2-3\" data-name=\"Menu sidebar nav item\">\n<i class=\"bi bi-journal-text text-[18px] leading-none text-[#888888]\" data-kid=\"1-1-2-3-1\" data-name=\"journal menu icon\"></i>\n<span data-kid=\"1-1-2-3-2\" data-name=\"Menu nav label\">Menu</span>\n</div>\n<div class=\"flex cursor-pointer items-center gap-3 rounded-[12px] px-3.5 py-3 text-[#555555]\" data-kid=\"1-1-2-4\" data-name=\"Profile sidebar nav item\">\n<i class=\"bi bi-person text-[18px] leading-none text-[#888888]\" data-kid=\"1-1-2-4-1\" data-name=\"person profile icon\"></i>\n<span data-kid=\"1-1-2-4-2\" data-name=\"Profile nav label\">Profile</span>\n</div>\n</nav>\n</aside>\n<main class=\"min-w-0 flex-1 px-8 py-8\" data-kid=\"1-2\" data-name=\"main content area\">\n<div class=\"mx-auto w-[1136px] max-w-full\" data-kid=\"1-2-1\" data-name=\"page content width container\">\n<header class=\"flex items-start justify-between gap-6\" data-kid=\"1-2-1-1\" data-name=\"page header with back link and title\">\n<div class=\"min-w-0\" data-kid=\"1-2-1-1-1\" data-name=\"header title group container\">\n<div class=\"inline-flex h-9 cursor-pointer items-center gap-2 text-[13.5px] font-semibold text-[#7b7f95]\" data-kid=\"1-2-1-1-1-1\" data-name=\"back to orders link\">\n<i class=\"bi bi-arrow-left text-[14px] leading-none\" data-kid=\"1-2-1-1-1-1-1\" data-name=\"left arrow icon\"></i>\n<span data-kid=\"1-2-1-1-1-1-2\" data-name=\"back link label\">Back to orders</span>\n</div>\n<h1 class=\"mt-2 font-['Sora'] text-[26px] font-bold leading-tight tracking-[-0.6px] text-[#15182e]\" data-kid=\"1-2-1-1-1-2\" data-name=\"page title heading\">Order details</h1>\n<div class=\"mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-[13px]\" data-kid=\"1-2-1-1-1-3\" data-name=\"order meta info row\">\n<span class=\"text-[#7b7f95]\" data-kid=\"1-2-1-1-1-3-1\" data-name=\"order ID label\">Order ID</span>\n<span class=\"font-medium tabular-nums text-[#3a3f57]\" data-kid=\"1-2-1-1-1-3-2\" data-name=\"order ID value\">6928f3a1c4e7b21d9a6f40b3</span>\n<span class=\"h-3 w-px bg-[#d9dced]\" data-kid=\"1-2-1-1-1-3-3\" data-name=\"meta info vertical divider\"></span>\n<span class=\"text-[#7b7f95]\" data-kid=\"1-2-1-1-1-3-4\" data-name=\"order timestamp value\">November 4, 2026 at 06:42 PM</span>\n</div>\n</div>\n</header>\n<div class=\"mt-5 grid grid-cols-[704px_412px] items-start gap-5\" data-kid=\"1-2-1-2\" data-name=\"order details two-column grid\">\n<section class=\"rounded-[22px] bg-white p-6 shadow-[0_8px_30px_rgba(21,24,46,0.06)]\" data-kid=\"1-2-1-2-1\" data-name=\"order items card\">\n<div class=\"flex items-center justify-between gap-4\" data-kid=\"1-2-1-2-1-1\" data-name=\"order items card header\">\n<h2 class=\"font-['Sora'] text-[18px] font-bold tracking-[-0.3px] text-[#15182e]\" data-kid=\"1-2-1-2-1-1-1\" data-name=\"order items section title\">Order items</h2>\n<div class=\"flex items-center gap-3 text-[13px] text-[#7b7f95]\" data-kid=\"1-2-1-2-1-1-2\" data-name=\"item count summary\">\n<span data-kid=\"1-2-1-2-1-1-2-1\" data-name=\"item count value\">4 items</span>\n<span class=\"h-3 w-px bg-[#e8eaf3]\" data-kid=\"1-2-1-2-1-1-2-2\" data-name=\"count divider\"></span>\n<span data-kid=\"1-2-1-2-1-1-2-3\" data-name=\"units count value\">8 units</span>\n</div>\n</div>\n<div class=\"mt-4 rounded-[12px] bg-[#fff0e6] px-4 py-3\" data-kid=\"1-2-1-2-1-2\" data-name=\"special instructions alert box\">\n<p class=\"text-[12.5px] font-bold text-[#b0632a]\" data-kid=\"1-2-1-2-1-2-1\" data-name=\"special instructions label\">Special instructions</p>\n<p class=\"mt-1 text-[15px] leading-[23px] text-[#43342a]\" data-kid=\"1-2-1-2-1-2-2\" data-name=\"special instructions text\">Less spice in the biryani. Cut the naan in half and send extra raita.</p>\n</div>\n<div class=\"mt-5\" data-kid=\"1-2-1-2-1-3\" data-name=\"order items table\">\n<div class=\"grid grid-cols-[minmax(0,1fr)_56px_104px_104px] items-center gap-4 border-b border-[#e8eaf3] pb-2.5 text-[12.5px] font-semibold text-[#7b7f95]\" data-kid=\"1-2-1-2-1-3-1\" data-name=\"items table header row\">\n<span data-kid=\"1-2-1-2-1-3-1-1\" data-name=\"item column header\">Item</span>\n<span class=\"text-center\" data-kid=\"1-2-1-2-1-3-1-2\" data-name=\"qty column header\">Qty</span>\n<span class=\"text-right\" data-kid=\"1-2-1-2-1-3-1-3\" data-name=\"unit price column header\">Unit price</span>\n<span class=\"text-right\" data-kid=\"1-2-1-2-1-3-1-4\" data-name=\"amount column header\">Amount</span>\n</div>\n<div class=\"grid grid-cols-[minmax(0,1fr)_56px_104px_104px] items-center gap-4 border-b border-[#f2f3f9] py-[15px]\" data-kid=\"1-2-1-2-1-3-2\" data-name=\"biryani order item row\">\n<div class=\"flex min-w-0 items-center gap-3\" data-kid=\"1-2-1-2-1-3-2-1\" data-name=\"biryani item name with image\">\n<img alt=\"Hyderabadi Dum Biryani — Saveurs Secretes on Pexels\" class=\"h-11 w-11 shrink-0 rounded-[10px] object-cover\" data-kid=\"1-2-1-2-1-3-2-1-1\" data-name=\"biryani thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/7394819/pexels-photo-7394819.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=200&amp;q=80\"/>\n<span class=\"min-w-0 text-[15px] font-semibold leading-[22px] text-[#15182e]\" data-kid=\"1-2-1-2-1-3-2-1-2\" data-name=\"biryani item name\">Hyderabadi Dum Biryani</span>\n</div>\n<span class=\"text-center text-[15px] font-semibold tabular-nums text-[#1d2036]\" data-kid=\"1-2-1-2-1-3-2-2\" data-name=\"biryani quantity value\">2</span>\n<span class=\"text-right text-[15px] tabular-nums text-[#4a4f66]\" data-kid=\"1-2-1-2-1-3-2-3\" data-name=\"biryani unit price value\">₹329</span>\n<span class=\"text-right text-[15px] font-semibold tabular-nums text-[#15182e]\" data-kid=\"1-2-1-2-1-3-2-4\" data-name=\"biryani amount value\">₹658</span>\n</div>\n<div class=\"grid grid-cols-[minmax(0,1fr)_56px_104px_104px] items-center gap-4 border-b border-[#f2f3f9] py-[15px]\" data-kid=\"1-2-1-2-1-3-3\" data-name=\"butter chicken order item row\">\n<div class=\"flex min-w-0 items-center gap-3\" data-kid=\"1-2-1-2-1-3-3-1\" data-name=\"butter chicken item name with image\">\n<img alt=\"Butter Chicken — Jack Baghel on Pexels\" class=\"h-11 w-11 shrink-0 rounded-[10px] object-cover\" data-kid=\"1-2-
      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@mdi/font@7.4.47/css/materialdesignicons.min.css');\n</style>\n<div class=\"min-h-screen bg-[#FFFDF9] text-[#25221F] antialiased [font-family:Inter,ui-sans-serif,system-ui,sans-serif]\" data-kid=\"1\" data-name=\"page layout container\">\n<div class=\"mx-auto w-full max-w-[1240px] px-6 pb-20 pt-7 xl:px-0\" data-kid=\"1-1\" data-name=\"page content container\">\n<!-- Back -->\n<button class=\"inline-flex h-10 items-center gap-1.5 rounded-md pr-2 text-[13px] font-semibold text-[#6F655C] transition-colors hover:text-[#D9481A]\" data-kid=\"1-1-1\" data-name=\"back to restaurants button\" type=\"button\">\n<i class=\"mdi mdi-arrow-left text-[17px] leading-none\" data-kid=\"1-1-1-1\" data-name=\"left arrow icon\"></i>\n<span data-kid=\"1-1-1-2\" data-name=\"back button label\">Back to restaurants</span>\n</button>\n<!-- Restaurant panorama -->\n<div class=\"mt-3\" data-kid=\"1-1-2\" data-name=\"restaurant panorama image wrapper\">\n<img alt=\"Dining room at Spice Route Kitchen — Dmitry Spravko on Unsplash\" class=\"h-[152px] w-full rounded-t-[6px] object-cover object-center\" data-kid=\"1-1-2-1\" data-name=\"restaurant panorama image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1631615535272-1106aa1b3854?auto=format&amp;w=1600&amp;q=80&amp;fit=crop\"/>\n</div>\n<!-- Restaurant information strip -->\n<section class=\"grid grid-cols-1 gap-6 rounded-b-[6px] bg-white px-5 py-5 md:grid-cols-[minmax(0,1fr)_520px] md:gap-10\" data-kid=\"1-1-3\" data-name=\"restaurant information card\">\n<div class=\"min-w-0\" data-kid=\"1-1-3-1\" data-name=\"restaurant details column\">\n<h1 class=\"text-[30px] font-extrabold leading-[1.15] tracking-[-0.02em]\" data-kid=\"1-1-3-1-1\" data-name=\"restaurant name heading\">Spice Route Kitchen</h1>\n<p class=\"mt-1 text-[13px] font-medium text-[#6F655C]\" data-kid=\"1-1-3-1-2\" data-name=\"cuisine type text\">North Indian, Biryani, Mughlai</p>\n<p class=\"mt-2 max-w-[600px] text-[14px] leading-6 text-[#6F655C]\" data-kid=\"1-1-3-1-3\" data-name=\"restaurant description text\">\n          Dum biryani, tandoor kebabs and slow-cooked curries from a 42-seat kitchen in Koramangala.\n        </p>\n<p class=\"mt-3 flex items-start gap-1.5 text-[13px] leading-5 text-[#6F655C]\" data-kid=\"1-1-3-1-4\" data-name=\"restaurant address row\">\n<i class=\"mdi mdi-map-marker-outline text-[16px] leading-none\" data-kid=\"1-1-3-1-4-1\" data-name=\"map marker icon\"></i>\n<span data-kid=\"1-1-3-1-4-2\" data-name=\"restaurant address text\">24, 5th Cross, 80 Feet Road, Koramangala, Bengaluru, Karnataka 560095</span>\n</p>\n</div>\n<div class=\"flex items-start gap-6\" data-kid=\"1-1-3-2\" data-name=\"restaurant stats and rating column\">\n<dl class=\"min-w-0 flex-1 divide-y divide-[#F2ECE5] text-[13px]\" data-kid=\"1-1-3-2-1\" data-name=\"delivery info list\">\n<div class=\"flex items-baseline justify-between gap-3 py-[7px]\" data-kid=\"1-1-3-2-1-1\" data-name=\"delivery time row\">\n<dt class=\"text-[#6F655C]\" data-kid=\"1-1-3-2-1-1-1\" data-name=\"delivery time label\">Delivery</dt>\n<dd class=\"font-semibold tabular-nums\" data-kid=\"1-1-3-2-1-1-2\" data-name=\"delivery time value\">32 min</dd>\n</div>\n<div class=\"flex items-baseline justify-between gap-3 py-[7px]\" data-kid=\"1-1-3-2-1-2\" data-name=\"minimum order row\">\n<dt class=\"text-[#6F655C]\" data-kid=\"1-1-3-2-1-2-1\" data-name=\"minimum order label\">Minimum order</dt>\n<dd class=\"font-semibold tabular-nums\" data-kid=\"1-1-3-2-1-2-2\" data-name=\"minimum order value\">₹149</dd>\n</div>\n<div class=\"flex items-baseline justify-between gap-3 py-[7px]\" data-kid=\"1-1-3-2-1-3\" data-name=\"delivery fee row\">\n<dt class=\"text-[#6F655C]\" data-kid=\"1-1-3-2-1-3-1\" data-name=\"delivery fee label\">Delivery fee</dt>\n<dd class=\"font-semibold tabular-nums\" data-kid=\"1-1-3-2-1-3-2\" data-name=\"delivery fee value\">₹29</dd>\n</div>\n</dl>\n<div class=\"h-[96px] w-px shrink-0 bg-[#F2ECE5]\" data-kid=\"1-1-3-2-2\" data-name=\"vertical divider line\"></div>\n<div class=\"w-[136px] shrink-0\" data-kid=\"1-1-3-2-3\" data-name=\"rating and status block\">\n<div class=\"flex items-center gap-1.5\" data-kid=\"1-1-3-2-3-1\" data-name=\"rating display\">\n<span class=\"text-[22px] font-extrabold leading-none tracking-[-0.02em] tabular-nums\" data-kid=\"1-1-3-2-3-1-1\" data-name=\"rating number\">4.3</span>\n<i class=\"mdi mdi-star text-[14px] leading-none text-[#F05A24]\" data-kid=\"1-1-3-2-3-1-2\" data-name=\"star rating icon\"></i>\n</div>\n<p class=\"mt-1 text-[13px] text-[#6F655C]\" data-kid=\"1-1-3-2-3-2\" data-name=\"ratings count text\">1,284 ratings</p>\n<p class=\"mt-3 flex items-center gap-1.5 text-[13px] font-semibold text-[#1F7A4D]\" data-kid=\"1-1-3-2-3-3\" data-name=\"open status text\">\n<span class=\"h-[7px] w-[7px] rounded-full bg-[#1F7A4D]\" data-kid=\"1-1-3-2-3-3-1\" data-name=\"open status indicator dot\"></span>\n            Open\n          </p>\n</div>\n</div>\n</section>\n<!-- Menu toolbar -->\n<div class=\"mt-10 flex flex-wrap items-end justify-between gap-4\" data-kid=\"1-1-4\" data-name=\"menu toolbar\">\n<div class=\"flex items-baseline gap-3\" data-kid=\"1-1-4-1\" data-name=\"menu heading group\">\n<h2 class=\"text-[24px] font-extrabold tracking-[-0.02em]\" data-kid=\"1-1-4-1-1\" data-name=\"menu heading\">Menu</h2>\n<span class=\"text-[13px] font-medium text-[#6F655C]\" data-kid=\"1-1-4-1-2\" data-name=\"menu dish count text\">9 dishes</span>\n</div>\n<div class=\"flex h-11 w-full max-w-[360px] items-center gap-2 rounded-md border border-[#EAE3DB] bg-white px-3.5 transition-colors focus-within:border-[#F05A24]\" data-kid=\"1-1-4-2\" data-name=\"search input container\">\n<i class=\"mdi mdi-magnify text-[18px] leading-none text-[#8B7F73]\" data-kid=\"1-1-4-2-1\" data-name=\"magnifying glass search icon\"></i>\n<input aria-label=\"Search dishes\" class=\"h-full w-full border-0 bg-transparent text-[14px] outline-none placeholder:text-[#A79C92] focus:ring-0\" data-kid=\"1-1-4-2-2\" data-name=\"search dishes input field\" placeholder=\"Search dishes, flavours…\" type=\"text\"/>\n</div>\n</div>\n<!-- Categories -->\n<div class=\"mt-4 flex flex-wrap gap-2\" data-kid=\"1-1-5\" data-name=\"category filter bar\">\n<button class=\"inline-flex h-10 items-center rounded-full border border-[#F4D2BD] bg-[#FFF0E5] px-4 text-[13px] font-semibold text-[#B4430F]\" data-kid=\"1-1-5-1\" data-name=\"All category filter button (active)\" type=\"button\">All</button>\n<button class=\"inline-flex h-10 items-center rounded-full border border-[#EAE3DB] bg-white px-4 text-[13px] font-semibold text-[#5C534B] transition-colors hover:border-[#D8CDBF]\" data-kid=\"1-1-5-2\" data-name=\"Biryani category filter button\" type=\"button\">Biryani</button>\n<button class=\"inline-flex h-10 items-center rounded-full border border-[#EAE3DB] bg-white px-4 text-[13px] font-semibold text-[#5C534B] transition-colors hover:border-[#D8CDBF]\" data-kid=\"1-1-5-3\" data-name=\"Tandoor category filter button\" type=\"button\">Tandoor</button>\n<button class=\"inline-flex h-10 items-center rounded-full border border-[#EAE3DB] bg-white px-4 text-[13px] font-semibold text-[#5C534B] transition-colors hover:border-[#D8CDBF]\" data-kid=\"1-1-5-4\" data-name=\"Curries category filter button\" type=\"button\">Curries</button>\n<button class=\"inline-flex h-10 items-center rounded-full border border-[#EAE3DB] bg-white px-4 text-[13px] font-semibold text-[#5C534B] transition-colors hover:border-[#D8CDBF]\" data-kid=\"1-1-5-5\" data-name=\"Breads category filter button\" type=\"button\">Breads</button>\n<button class=\"inline-flex h-10 items-center rounded-full border border-[#EAE3DB] bg-white px-4 text-[13px] font-semibold text-[#5C534B] transition-colors hover:border-[#D8CDBF]\" data-kid=\"1-1-5-6\" data-name=\"Rice category filter button\" type=\"button\">Rice</button>\n<button class=\"inline-flex h-10 items-center rounded-full border border-[#EAE3DB] bg-white px-4 text-[13px] font-semibold text-[#5C534B] transition-colors hover:border-[#D8CDBF]\" data-kid=\"1-1-5-7\" data-name=\"Desserts category filter button\" type=\"button\">Desserts</button>\n<button class=\"inline-flex h-10 items-center rounded-full border border-[#EAE3DB] bg-white px-4 text-[13px] font-semibold text-[#5C534B] transition-colors hover:border-[#D8CDBF]\" data-kid=\"1-1-5-8\" data-name=\"Drinks category filter button\" type=\"button\">Drinks</button>\n</div>\n<!-- Dish grid -->\n<div class=\"mt-6 grid grid-cols-1 gap-x-6 gap-y-9 sm:grid-cols-2 lg:grid-cols-3\" data-kid=\"1-1-6\" data-name=\"dishes grid container\">\n<!-- 1 -->\n<article class=\"flex flex-col\" data-kid=\"1-1-6-1\" data-name=\"dish card - Hyderabadi Dum Biryani\">\n<div class=\"overflow-hidden rounded-[6px] bg-[#F7EEE5]\" data-kid=\"1-1-6-1-1\" data-name=\"dish image container\">\n<img alt=\"Hyderabadi dum biryani in a handi — Saveurs Secretes on Pexels\" class=\"h-[199px] w-full object-cover\" data-kid=\"1-1-6-1-1-1\" data-name=\"Hyderabadi Dum Biryani image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/7394819/pexels-photo-7394819.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=900&amp;q=80\"/>\n</div>\n<div class=\"flex flex-1 flex-col pt-4\" data-kid=\"1-1-6-1-2\" data-name=\"dish info content\">\n<div class=\"flex items-baseline justify-between gap-3\" data-kid=\"1-1-6-1-2-1\" data-name=\"dish name and price row\">\n<h3 class=\"text-[18px] font-bold leading-snug\" data-kid=\"1-1-6-1-2-1-1\" data-name=\"dish name heading\">Hyderabadi Dum Biryani</h3>\n<span class=\"shrink-0 text-[16px] font-semibold tabular-nums\" data-kid=\"1-1-6-1-2-1-2\" data-name=\"dish price\">₹329</span>\n</div>\n<div class=\"mt-1.5 flex items-center gap-2 text-[13px] text-[#6F655C]\" data-kid=\"1-1-6-1-2-2\" data-name=\"dish category tag row\">\n<span class=\"inline-flex h-[13px] w-[13px] shrink-0 items-center justify-center rounded-[2px] border border-[#B23B32]\" data-kid=\"1-1-6-1-2-2-1\" data-name=\"category indicator box\"><span class=\"h-[5px] w-[5px] rounded-full bg-[#B23B32]\" data-kid=\"1-1-6-1-2-2-1-1\" data-name=\"category indicator dot\"></span></span>\n<span data-kid=\"1-1-6-1-2-2-2\" data-name=\"dish category label\">Biryani</span>\n</div>\n<p class=\"mt-2 min-h-[48px] text-[14px] leading-6 text-[#6F655C] line-clamp-2\" data-kid=\"1-1-6-1-2-3\" data-name=\"dish description text\">Basmati sealed with mutton marinated in yoghurt and saffron, cooked on dum.</p>\n<div class=\"mt-auto flex items-center justify-between gap-3 pt-3\" data-kid=\"1-1-6-1-2-4\" data-name=\"dish footer with time and action\">\n<span class=\"inline-flex items-center gap-1.5 text-[13px] text-[#6F655C]\" data-kid=\"1-1-6-1-2-4-1\" data-name=\"dish prep time display\"><i class=\"mdi mdi-clock-outline text-[15px] leading-none\" data-kid=\"1-1-6-1-2-4-1-1\" data-name=\"clock icon\"></i>25 min</span>\n<button class=\"inline-flex h-10 items-center gap-1 text-[13px] font-bold text-[#D9481A] transition-colors hover:text-[#A8360F]\" data-kid=\"1-1-6-1-2-4-2\" data-name=\"view item button\" type=\"button\">View item<i class=\"mdi mdi-arrow-right text-[15px] leading-none\" data-kid=\"1-1-6-1-2-4-2-1\" data-name=\"right arrow icon\"></i></button>\n</div>\n</div>\n</article>\n<!-- 2 -->\n<article class=\"flex flex-col\" data-kid=\"1-1-6-2\" data-name=\"dish card - Paneer Tikka\">\n<div class=\"overflow-hidden rounded-[6px] bg-[#F7EEE5]\" data-kid=\"1-1-6-2-1\" data-name=\"dish image container\">\n<img alt=\"Paneer tikka on skewers — Anil Sharma on Pexels\" class=\"h-[199px] w-full object-cover\" data-kid=\"1-1-6-2-1-1\" data-name=\"Paneer Tikka image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/33430556/pexels-photo-33430556.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=900&amp;q=80\"/>\n</div>\n<div class=\"flex flex-1 flex-col pt-4\" data-kid=\"1-1-6-2-2\" data-name=\"dish info content\">\n<div class=\"flex items-baseline justify-between gap-3\" data-kid=\"1-1-6-2-2-1\" data-name=\"dish name and price row\">\n<h3 class=\"text-[18px] font-bold leading-snug\" data-kid=\"1-1-6-2-2-1-1\" data-name=\"dish name heading\">Paneer Tikka</h3>\n<span class=\"shrink-0 text-[16px] font-semibold tabular-nums\" data-kid=\"1-1-6-2-2-1-2\" data-name=\"dish price\">₹269</span>\n</div>\n<div class=\"mt-1.5 flex items-center gap-2 text-[13px] text-[#6F655C]\" data-kid=\"1-1-6-2-2-2\" data-name=\"dish category tag row\">\n<span class=\"inline-flex h-[13px] w-[13px] shrink-0 items-center justify-center rounded-[2px] border border-[#2E8A57]\" data-kid=\"1-1-6-2-2-2-1\" data-name=\"category indicator box\"><span class=\"h-[5px] w-[5px] rounded-full bg-[#2E8A57]\" data-kid=\"1-1-6-2-2-2-1-1\" data-name=\"category indicator dot\"></span></span>\n<span data-kid=\"1-1-6-2-2-2-2\" data-name=\"dish category label\">Tandoor</span>\n</div>\n<p class=\"mt-2 min-h-[48px] text-[14px] leading-6 text-[#6F655C] line-clamp-2\" data-kid=\"1-1-6-2-2-3\" data-name=\"dish description text\">Hung-curd and ajwain marinade, charred in the tandoor, served with mint chutney.</p>\n<div class=\"mt-auto flex items-center justify-between gap-3 pt-3\" data-kid=\"1-1-6-2-2-4\" data-name=\"dish footer with time and action\">\n<span class=\"inline-flex items-center gap-1.5 text-[13px] text-[#6F655C]\" data-kid=\"1-1-6-2-2-4-1\" data-name=\"dish prep time display\"><i class=\"mdi mdi-clock-outline text-[15px] leading-none\" data-kid=\"1-1-6-2-2-4-1-1\" data-name=\"clock icon\"></i>15 min</span>\n<button class=\"inline-flex h-10 items-center gap-1 text-[13px] font-bold text-[#D9481A] transition-colors hover:text-[#A8360F]\" data-kid=\"1-1-6-2-2-4-2\" data-name=\"view item button\" type=\"button\">View item<i class=\"mdi mdi-arrow-right text-[15px] leading-none\" data-kid=\"1-1-6-2-2-4-2-1\" data-name=\"right arrow icon\">
      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');\n  @import url(\"https://cdn.jsdelivr.net/npm/@mdi/font@7.4.47/css/materialdesignicons.min.css\");\n</style>\n<div class=\"min-h-screen bg-[#FFFDF9] text-[#25221F] antialiased\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family: 'Inter', system-ui, -apple-system, sans-serif;\">\n<div class=\"mx-auto w-full max-w-[1240px] px-6 pb-16 pt-7\" data-kid=\"1-1\" data-name=\"page content wrapper with max width\">\n<!-- Back -->\n<button class=\"inline-flex h-10 items-center gap-2 rounded-md pr-2 text-[13.5px] font-semibold text-[#6F655C] transition-colors hover:text-[#F05A24]\" data-kid=\"1-1-1\" data-name=\"back to restaurants button\" type=\"button\">\n<i class=\"mdi mdi-arrow-left text-[17px]\" data-kid=\"1-1-1-1\" data-name=\"left arrow back icon\"></i>\n      Back to restaurants\n    </button>\n<div class=\"mt-4 flex items-start gap-6\" data-kid=\"1-1-2\" data-name=\"restaurant panel and menu layout flex\">\n<!-- ================= Restaurant panel ================= -->\n<aside class=\"w-[248px] shrink-0 rounded-[18px] bg-[#FFF0E5] p-4\" data-kid=\"1-1-2-1\" data-name=\"restaurant info sidebar panel\">\n<img alt=\"Dining room at Spice Route Kitchen — Dmitry Spravko on Unsplash\" class=\"h-[144px] w-full rounded-[12px] object-cover\" data-kid=\"1-1-2-1-1\" data-name=\"restaurant hero photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1631615535272-1106aa1b3854?auto=format&amp;w=600&amp;q=80&amp;fit=crop\"/>\n<h1 class=\"mt-4 text-[26px] font-extrabold leading-[1.14] tracking-[-0.7px]\" data-kid=\"1-1-2-1-2\" data-name=\"restaurant name headline\">Spice Route Kitchen</h1>\n<p class=\"mt-1.5 text-[13px] leading-[1.5] text-[#7A6B5E]\" data-kid=\"1-1-2-1-3\" data-name=\"restaurant cuisine categories text\">North Indian, Biryani, Mughlai</p>\n<p class=\"mt-3 text-[13px] leading-[1.6] text-[#6F655C]\" data-kid=\"1-1-2-1-4\" data-name=\"restaurant description text\">Slow-cooked curries, dum biryani and tandoor breads, from a 42-seat kitchen in Koramangala.</p>\n<!-- status + rating -->\n<div class=\"mt-4 flex flex-wrap items-center gap-x-4 gap-y-2\" data-kid=\"1-1-2-1-5\" data-name=\"open status and rating row\">\n<span class=\"inline-flex items-center gap-1.5 text-[13px] font-semibold text-[#1F7A45]\" data-kid=\"1-1-2-1-5-1\" data-name=\"open now status badge\">\n<span class=\"h-1.5 w-1.5 rounded-full bg-[#1F8A4C]\" data-kid=\"1-1-2-1-5-1-1\" data-name=\"open status green dot\"></span>\n            Open now\n          </span>\n<span class=\"inline-flex items-center gap-1 text-[13px] font-semibold\" data-kid=\"1-1-2-1-5-2\" data-name=\"rating star and count row\">\n<i class=\"mdi mdi-star text-[14px] text-[#E9A20E]\" data-kid=\"1-1-2-1-5-2-1\" data-name=\"star rating icon\"></i>\n            4.3\n            <span class=\"font-normal text-[#8A7C6E]\" data-kid=\"1-1-2-1-5-2-2\" data-name=\"number of ratings text\">1,284 ratings</span>\n</span>\n</div>\n<!-- delivery ledger -->\n<dl class=\"mt-4 border-t border-[#E9D3C1]\" data-kid=\"1-1-2-1-6\" data-name=\"delivery details list\">\n<div class=\"flex h-10 items-center justify-between gap-2 border-b border-[#E9D3C1] text-[13px]\" data-kid=\"1-1-2-1-6-1\" data-name=\"delivery time row\">\n<dt class=\"text-[#7A6B5E]\" data-kid=\"1-1-2-1-6-1-1\" data-name=\"delivery time label\">Delivery</dt>\n<dd class=\"font-semibold\" data-kid=\"1-1-2-1-6-1-2\" data-name=\"delivery time value\">32 min</dd>\n</div>\n<div class=\"flex h-10 items-center justify-between gap-2 border-b border-[#E9D3C1] text-[13px]\" data-kid=\"1-1-2-1-6-2\" data-name=\"minimum order row\">\n<dt class=\"text-[#7A6B5E]\" data-kid=\"1-1-2-1-6-2-1\" data-name=\"minimum order label\">Minimum order</dt>\n<dd class=\"font-semibold\" data-kid=\"1-1-2-1-6-2-2\" data-name=\"minimum order value\">₹149</dd>\n</div>\n<div class=\"flex h-10 items-center justify-between gap-2 text-[13px]\" data-kid=\"1-1-2-1-6-3\" data-name=\"delivery fee row\">\n<dt class=\"text-[#7A6B5E]\" data-kid=\"1-1-2-1-6-3-1\" data-name=\"delivery fee label\">Delivery fee</dt>\n<dd class=\"font-semibold\" data-kid=\"1-1-2-1-6-3-2\" data-name=\"delivery fee value\">₹29</dd>\n</div>\n</dl>\n<!-- address -->\n<div class=\"mt-3 flex gap-2 border-t border-[#E9D3C1] pt-3\" data-kid=\"1-1-2-1-7\" data-name=\"address block\">\n<i class=\"mdi mdi-map-marker-outline mt-[1px] text-[15px] text-[#C8430F]\" data-kid=\"1-1-2-1-7-1\" data-name=\"map location icon\"></i>\n<address class=\"not-italic text-[12.5px] leading-[1.6] text-[#6F655C]\" data-kid=\"1-1-2-1-7-2\" data-name=\"restaurant address text\">\n            24, 5th Cross, 80 Feet Road<br data-kid=\"1-1-2-1-7-2-1\" data-name=\"address line break\"/>\n            Koramangala, Bengaluru<br data-kid=\"1-1-2-1-7-2-2\" data-name=\"address line break\"/>\n            Karnataka 560095\n          </address>\n</div>\n</aside>\n<!-- ================= Menu workspace ================= -->\n<section class=\"min-w-0 flex-1\" data-kid=\"1-1-2-2\" data-name=\"menu section\">\n<div class=\"flex items-center justify-between gap-5\" data-kid=\"1-1-2-2-1\" data-name=\"menu header row with title and search\">\n<div class=\"flex items-baseline gap-3\" data-kid=\"1-1-2-2-1-1\" data-name=\"menu title and count group\">\n<h2 class=\"text-[24px] font-extrabold tracking-[-0.6px]\" data-kid=\"1-1-2-2-1-1-1\" data-name=\"menu heading\">Menu</h2>\n<span class=\"text-[13px] text-[#8A7C6E]\" data-kid=\"1-1-2-2-1-1-2\" data-name=\"dish count text\">9 dishes</span>\n</div>\n<div class=\"flex h-11 w-[460px] shrink-0 items-center gap-2.5 rounded-[12px] border border-[#EAE3DB] bg-white px-3.5 transition-[border-color,box-shadow] focus-within:border-[#F05A24] focus-within:shadow-[0_0_0_3px_rgba(240,90,36,0.10)]\" data-kid=\"1-1-2-2-1-2\" data-name=\"dish search input bar\">\n<i class=\"mdi mdi-magnify text-[18px] text-[#8A8078]\" data-kid=\"1-1-2-2-1-2-1\" data-name=\"magnifying glass search icon\"></i>\n<input aria-label=\"Search dishes\" class=\"h-full w-full border-0 bg-transparent text-[14px] text-[#25221F] outline-hidden placeholder:text-[#A79C93]\" data-kid=\"1-1-2-2-1-2-2\" data-name=\"dish search input field\" placeholder=\"Search dishes, flavours…\" type=\"text\"/>\n</div>\n</div>\n<!-- categories -->\n<div class=\"mt-5 flex flex-wrap gap-2\" data-kid=\"1-1-2-2-2\" data-name=\"dish category filter buttons row\">\n<button class=\"h-9 rounded-full border border-[#F5D9C6] bg-[#FFF0E5] px-4 text-[13px] font-semibold text-[#C8430F]\" data-kid=\"1-1-2-2-2-1\" data-name=\"All category filter button\" type=\"button\">All</button>\n<button class=\"h-9 rounded-full border border-[#EAE3DB] bg-white px-4 text-[13px] font-medium text-[#5C544D] transition-colors hover:border-[#D8CEC3]\" data-kid=\"1-1-2-2-2-2\" data-name=\"Biryani category filter button\" type=\"button\">Biryani</button>\n<button class=\"h-9 rounded-full border border-[#EAE3DB] bg-white px-4 text-[13px] font-medium text-[#5C544D] transition-colors hover:border-[#D8CEC3]\" data-kid=\"1-1-2-2-2-3\" data-name=\"Tandoor category filter button\" type=\"button\">Tandoor</button>\n<button class=\"h-9 rounded-full border border-[#EAE3DB] bg-white px-4 text-[13px] font-medium text-[#5C544D] transition-colors hover:border-[#D8CEC3]\" data-kid=\"1-1-2-2-2-4\" data-name=\"Curries category filter button\" type=\"button\">Curries</button>\n<button class=\"h-9 rounded-full border border-[#EAE3DB] bg-white px-4 text-[13px] font-medium text-[#5C544D] transition-colors hover:border-[#D8CEC3]\" data-kid=\"1-1-2-2-2-5\" data-name=\"Breads category filter button\" type=\"button\">Breads</button>\n<button class=\"h-9 rounded-full border border-[#EAE3DB] bg-white px-4 text-[13px] font-medium text-[#5C544D] transition-colors hover:border-[#D8CEC3]\" data-kid=\"1-1-2-2-2-6\" data-name=\"Rice category filter button\" type=\"button\">Rice</button>\n<button class=\"h-9 rounded-full border border-[#EAE3DB] bg-white px-4 text-[13px] font-medium text-[#5C544D] transition-colors hover:border-[#D8CEC3]\" data-kid=\"1-1-2-2-2-7\" data-name=\"Desserts category filter button\" type=\"button\">Desserts</button>\n<button class=\"h-9 rounded-full border border-[#EAE3DB] bg-white px-4 text-[13px] font-medium text-[#5C544D] transition-colors hover:border-[#D8CEC3]\" data-kid=\"1-1-2-2-2-8\" data-name=\"Drinks category filter button\" type=\"button\">Drinks</button>\n</div>\n<!-- dish grid -->\n<div class=\"mt-6 grid grid-cols-3 gap-x-6 gap-y-8\" data-kid=\"1-1-2-2-3\" data-name=\"dish listing grid\">\n<!-- 1 -->\n<article class=\"min-w-0\" data-kid=\"1-1-2-2-3-1\" data-name=\"dish card\">\n<div class=\"overflow-hidden rounded-[14px] bg-[#F7EEE5]\" data-kid=\"1-1-2-2-3-1-1\" data-name=\"dish photo container\">\n<img alt=\"Hyderabadi Dum Biryani — Saveurs Secretes on Pexels\" class=\"h-[205px] w-full object-cover\" data-kid=\"1-1-2-2-3-1-1-1\" data-name=\"Hyderabadi Dum Biryani dish photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/7394819/pexels-photo-7394819.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=900&amp;q=80\"/>\n</div>\n<div class=\"pt-3\" data-kid=\"1-1-2-2-3-1-2\" data-name=\"dish card details wrapper\">\n<div class=\"flex items-center justify-between gap-3\" data-kid=\"1-1-2-2-3-1-2-1\" data-name=\"price and delivery time row\">\n<span class=\"text-[16px] font-semibold tracking-[-0.2px]\" data-kid=\"1-1-2-2-3-1-2-1-1\" data-name=\"dish price label\">₹329</span>\n<span class=\"inline-flex items-center gap-1.5 text-[13px] text-[#7A6F66]\" data-kid=\"1-1-2-2-3-1-2-1-2\" data-name=\"prep time indicator\"><i class=\"mdi mdi-clock-outline text-[14px]\" data-kid=\"1-1-2-2-3-1-2-1-2-1\" data-name=\"clock icon\"></i>25 min</span>\n</div>\n<h3 class=\"mt-1.5 text-[17px] font-bold leading-[1.32] tracking-[-0.2px]\" data-kid=\"1-1-2-2-3-1-2-2\" data-name=\"dish name headline\">Hyderabadi Dum Biryani</h3>\n<div class=\"mt-1.5 flex items-center gap-2 text-[13px] text-[#6F655C]\" data-kid=\"1-1-2-2-3-1-2-3\" data-name=\"dish category tag row\">\n<span class=\"inline-flex h-[13px] w-[13px] items-center justify-center rounded-[2px] border border-[#D93A32]\" data-kid=\"1-1-2-2-3-1-2-3-1\" data-name=\"category indicator box\"><span class=\"h-[5px] w-[5px] rounded-full bg-[#D93A32]\" data-kid=\"1-1-2-2-3-1-2-3-1-1\" data-name=\"category indicator dot\"></span></span>\n                Biryani\n              </div>\n<p class=\"mt-2 min-h-[40px] text-[13px] leading-[1.55] text-[#6F655C]\" data-kid=\"1-1-2-2-3-1-2-4\" data-name=\"dish description text\">Basmati sealed with mutton marinated in yoghurt and saffron, cooked on dum.</p>\n<button class=\"mt-1 inline-flex h-11 items-center gap-1.5 text-[13.5px] font-semibold text-[#C8430F] transition-colors hover:text-[#F05A24]\" data-kid=\"1-1-2-2-3-1-2-5\" data-name=\"view item button\" type=\"button\">\n                View item <i class=\"mdi mdi-arrow-right text-[15px]\" data-kid=\"1-1-2-2-3-1-2-5-1\" data-name=\"right arrow icon\"></i>\n</button>\n</div>\n</article>\n<!-- 2 -->\n<article class=\"min-w-0\" data-kid=\"1-1-2-2-3-2\" data-name=\"dish card\">\n<div class=\"overflow-hidden rounded-[14px] bg-[#F7EEE5]\" data-kid=\"1-1-2-2-3-2-1\" data-name=\"dish photo container\">\n<img alt=\"Paneer Tikka — Anil Sharma on Pexels\" class=\"h-[205px] w-full object-cover\" data-kid=\"1-1-2-2-3-2-1-1\" data-name=\"Paneer Tikka dish photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/33430556/pexels-photo-33430556.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=900&amp;q=80\"/>\n</div>\n<div class=\"pt-3\" data-kid=\"1-1-2-2-3-2-2\" data-name=\"dish card details wrapper\">\n<div class=\"flex items-center justify-between gap-3\" data-kid=\"1-1-2-2-3-2-2-1\" data-name=\"price and delivery time row\">\n<span class=\"text-[16px] font-semibold tracking-[-0.2px]\" data-kid=\"1-1-2-2-3-2-2-1-1\" data-name=\"dish price label\">₹269</span>\n<span class=\"inline-flex items-center gap-1.5 text-[13px] text-[#7A6F66]\" data-kid=\"1-1-2-2-3-2-2-1-2\" data-name=\"prep time indicator\"><i class=\"mdi mdi-clock-outline text-[14px]\" data-kid=\"1-1-2-2-3-2-2-1-2-1\" data-name=\"clock icon\"></i>15 min</span>\n</div>\n<h3 class=\"mt-1.5 text-[17px] font-bold leading-[1.32] tracking-[-0.2px]\" data-kid=\"1-1-2-2-3-2-2-2\" data-name=\"dish name headline\">Paneer Tikka</h3>\n<div class=\"mt-1.5 flex items-center gap-2 text-[13px] text-[#6F655C]\" data-kid=\"1-1-2-2-3-2-2-3\" data-name=\"dish category tag row\">\n<span class=\"inline-flex h-[13px] w-[13px] items-center justify-center rounded-[2px] border border-[#1F8A4C]\" data-kid=\"1-1-2-2-3-2-2-3-1\" data-name=\"category indicator box\"><span class=\"h-[5px] w-[5px] rounded-full bg-[#1F8A4C]\" data-kid=\"1-1-2-2-3-2-2-3-1-1\" data-name=\"category indicator dot\"></span></span>\n                Tandoor\n              </div>\n<p class=\"mt-2 min-h-[40px] text-[13px] leading-[1.55] text-[#6F655C]\" data-kid=\"1-1-2-2-3-2-2-4\" data-name=\"dish description text\">Hung-curd and ajwain marinade, charred in the tandoor, served with mint chutney.</p>\n<button class=\"mt-1 inline-flex h-11 items-center gap-1.5 text-[13.5px] font-semibold text-[#C8430F] transition-colors hover:text-[#F05A24]\" data-kid=\"1-1-2-2-3-2-2-5\" data-name=\"view item button\" type=\"button\">\n                View item <i class=\"mdi mdi-arrow-right text-[15px]\" data-kid=\"1-1-2-2-3-2-2-5-1\" data-name=\"right arrow icon\"></i>\n</button>\n</div>\n</article>\n<!-- 3 -->\n<article class=\"min-w-0\" data-kid=\"1-1-2-2-3-3\" data-name=\"dish card\">\n<div class=\"overflow-hidden rounded-[14px] bg-[#F7EEE5]\" data-kid=\"1-1-2-2-3-3-1\" data-name=\"dish photo container\">\n<img alt=\"Butter Chicken — Jack Baghel on Pexels\" class=\"h-[205px] w-full object-cover\" data-kid=\"1-1-2-2-3-3-1-1\" data-name=\"Butter Chicken dish photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/20408448/pexels-photo-20408448.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=900&amp;q=80\"/>\n</div>\n<div class=\"pt-3\" data-kid=\"1-1-2-2-3-3-2\" data-name=\"dish card details wrapper\">\n<div class=\"flex items-center justify-between gap-3\" data-kid=\"1-1-2-2-3-3-2-1\" data-name=\"price and delivery time row\">\n<span class=\"text-[16px] font-semibold tracking-[-0.2px]\" data-kid=\"1-1-2-2-3-3-2-1-1\" data-name=\"dish price label\">₹349</span>\n<span class=\"inline-flex items-center gap-1.5 text-[13px] text-[#7A6F66]\" data-kid=\"1-1-2-2-3-3-2-1-2\" data-name=\"prep time indicator\"><i class=\"mdi mdi-clock-outline text-[14px]\" data-kid=\"1-1-2-2-3-3-2-1-2-1\" data-name=\"clock icon\"></i>20 min</span>\n</div>\n<h3 class=\"mt-1.5 text-[17px] font-bold leading-[1.32] tracking-[-0.2px]\" data-kid=\"1-1-2-2-3-3-2-2\" data-name=\"dish name headline\">Butter Chicken</h3>\n<div class=\"mt-1.5 flex items-center gap-2 text-[13px] text-[#6F655C]\" data-kid=\"1-1-2-2-3-3-2-3\" data-name=\"dish category tag row\">\n<span class=\"inline-flex h-[13px] w-[13px] items-center justify-center rounded-[2px] border border-[#D93A32]\" data-kid=\"1-1-2-2-3-3-2-3-1\" data-name=\"category indicator box\"><span class=\"h-[5px] w-[5px] rounded-full bg-[#D93A32]\" data-kid=\"1-1-2-2-3-3-2-3-1-1\" data-name=\"category indicator dot\"></span></span>\n                Curries\n              </div>\n<p class=\"mt-2 min-h-[40px] text-[13px] leading-[1.55] text-[#6F655C]\" data-kid=\"1-1-2-2-3-3-2-4\" data-name=\"dish description text\">Tandoori chicken in a tomato-cashew gravy finished with white butter.</p>\n<button class=\"mt-1 inline-flex h-11 items-center gap-1.5 text-[13.5px] font-semibold text-[#C8430F] transition-colors hover:text-[#F05A24]\" data-kid=\"1-1-2-2-3-3-2-5\" data-name=\"view item button\" type=\"button\">\n                View item <i class=\"mdi mdi-arrow-right text-[15px]\" data-kid=\"1-1-2-2-3-3-2-5-1\" data-name=\"right arrow icon\"></i>\n</button>\n</div>\n</article>\n<!-- 4 -->\n<article class=\"min-w-0\" data-kid=\"1-1-2-2-3-4\" data-name=\"dish card\">\n<div class=\"overflow-hidden rounded-[14px] bg-[#F7EEE5]\" data-kid=\"1-1-2-2-3-4-1\" data-name=\"dish photo container\">\n<img alt=\"Galouti Kebab — Chait Goli on Pexels\" class=\"h-[205px] w-full object-cover\" data-kid=\"1-1-2-2-3-4-1-1\" data-name=\"Galouti Kebab dish photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/7353380/pexels-photo-7353380.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=900&amp;q=80\"/>\n</div>\n<div class=\"pt-3\" data-kid=\"1-1-2-2-3-4-2\" data-name=\"dish card details wrapper\">\n<div class=\"flex items-center justify-between gap-3\" data-kid=\"1-1-2-2-3-4-2-1\" data-name=\"price and delivery time row\">\n<span class=\"text-[16px] font-semibold tracking-[-0.2px]\" data-kid=\"1-1-2-2-3-4-2-1-1\" data-name=\"dish price label\">₹319</span>\n<span class=\"inline-flex items-center gap-1.5 text-[13px] text-[#7A6F66]\" data-kid=\"1-1-2-2-3-4-2-1-2\" data-name=\"prep time indicator\"><i class=\"mdi mdi-clock-outline text-[14px]\" data-kid=\"1-1-2-2-3-4-2-1-2-1\" data-name=\"clock icon\"></i>18 min</span>\n</div>\n<h3 class=\"mt-1.5 text-[17px] font-bold leading-[1.32] tracking-[-0.2px]\" data-kid=\"1-1-2-2-3-4-2-2\" data-name=\"dish name headline\">Galouti Kebab</h3>\n<div class=\"mt-1.5 flex items-center gap-2 text-[13px] text-[#6F655C]\" data-kid=\"1-1-2-2-3-4-2-3\" data-name=\"dish category tag row\">\n<span class=\"inline-flex h-[13px] w-[13px] items-center justify-center rounded-[2px] border border-[#D93A32]\" data-kid=\"1-1-2-2-3-4-2-3-1\" data-name=\"category indicator box\"><span class=\"h-[5px] w-[5px] rounded-full bg-[#D93A32]\" data-kid=\"1-1-2-2-3-4-2-3-1-1\" data-name=\"category indicator dot\"></span></span>\n                Tandoor\n              </div>\n<p class=\"mt-2 min-h-[40px] text-[13px] leading-[1.55] text-[#6F655C]\" data-kid=\"1-1-2-2-3-4-2-4\" data-name=\"dish description text\">Minced mutton kebabs with galouti masala, served with sheermal.</p>\n<button class=\"mt-1 inline-flex h-11 items-center gap-1.5 text-[13.5px] font-semibold text-[#C8430F] transition-colors hover:text-[#F05A24]\" data-kid=\"1-1-2-2-3-4-2-5\" data-name=\"view item button\" type=\"button\">\n                View item <i class=\"mdi mdi-arrow-right text-[15px]\" data-kid=\"1-1-2-2-3-4-2-5-1\" data-name=\"right arrow icon\"></i>\n</button>\n</div>\n</article>\n<!-- 5 -->\n<article class=\"min-w-0\" data-kid=\"1-1-2-2-3-5\" data-name=\"dish card\">\n<div class=\"overflow-hidden rounded-[14px] bg-[#F7EEE5]\" data-kid=\"1-1-2-2-3-5-1\" data-name=\"dish photo container\">\n<img alt=\"Dal Makhani — Kunal Lakhotia on Pexels\" class=\"h-[205px] w-full object-cover\" data-kid=\"1-1-2-2-3-5-1-1\" data-name=\"Dal Makhani dish photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/28674561/pexels-photo-28674561.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=900&amp;q=80\"/>\n</div>\n<div class=\"pt-3\" data-kid=\"1-1-2-2-3-5-2\" data-name=\"dish card details wrapper\">\n<div class=\"flex items-center justify-between gap-3\" data-kid=\"1-1-2-2-3-5-2-1\" data-name=\"price and delivery time row\">\n<span class=\"text-[16px] font-semibold tracking-[-0.2px]\" data-kid=\"1-1-2-2-3-5-2-1-1\" data-name=\"dish price label\">₹249</span>\n<span class=\"inline-flex items-center gap-1.5 text-[13px] text-[#7A6F66]\" data-kid=\"1-1-2-2-3-5-2-1-2\" data-name=\"prep time indicator\"><i class=\"mdi mdi-clock-outline text-[14px]\" data-kid=\"1-1-2-2-3-5-2-1-2-1\" data-name=\"clock icon\"></i>30 min</span>\n</div>\n<h3 class=\"mt-1.5 text-[17px] font-bold leading-[1.32] tracking-[-0.2px]\" data-kid=\"1-1-2-2-3-5-2-2\" data-name=\"dish name headline\">Dal Makhani</h3>\n<div class=\"mt-1.5 flex items-center gap-2 text-[13px] text-[#6F655C]\" data-kid=\"1-1-2-2-3-5-2-3\" data-name=\"dish category tag row\">\n<span class=\"inline-flex h-[13px] w-[13px] items-center justify-center rounded-[2px] border bor
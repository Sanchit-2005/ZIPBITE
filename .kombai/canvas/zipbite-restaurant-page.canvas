      },
      "html": "<style>\n@import url(\"https://cdn.jsdelivr.net/npm/@mdi/font@7.4.47/css/materialdesignicons.min.css\");\n@import url(\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap\");\n\n:root {\n  --zb-bg: #FFFDF9;\n  --zb-ink: #25221F;\n  --zb-ink-2: #4A443E;\n  --zb-muted: #6F655C;\n  --zb-line: #EAE3DB;\n  --zb-peach: #FFF0E5;\n  --zb-accent: #F05A24;\n  --zb-veg: #2E8C57;\n  --zb-nonveg: #B23B2E;\n}\n</style>\n<div class=\"min-h-screen bg-[var(--zb-bg)] text-[var(--zb-ink)] antialiased\" data-kid=\"1\" data-name=\"page background wrapper\" style=\"font-family:'Inter', ui-sans-serif, system-ui, sans-serif;\">\n<div class=\"mx-auto w-full max-w-[1240px] px-6 pt-7 pb-16\" data-kid=\"1-1\" data-name=\"page content container\">\n<!-- Back -->\n<button class=\"inline-flex h-10 items-center gap-2 rounded-[8px] pl-2 pr-3 -ml-2 text-[13px] font-medium text-[var(--zb-muted)] hover:bg-white hover:text-[var(--zb-ink)] transition-colors\" data-kid=\"1-1-1\" data-name=\"back to restaurants button\" type=\"button\">\n<i aria-hidden=\"true\" class=\"mdi mdi-arrow-left text-[18px]\" data-kid=\"1-1-1-1\" data-name=\"left arrow icon\"></i>\n      Back to restaurants\n    </button>\n<!-- Restaurant header -->\n<section class=\"mt-4 flex gap-5 rounded-[18px] border border-[var(--zb-line)] bg-white p-5\" data-kid=\"1-1-2\" data-name=\"restaurant header card\">\n<img alt=\"Spice Route Kitchen dining room — Dmitry Spravko on Unsplash\" class=\"h-[144px] w-[208px] shrink-0 rounded-[12px] object-cover\" data-kid=\"1-1-2-1\" data-name=\"restaurant header photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1631615535272-1106aa1b3854?auto=format&amp;w=1400&amp;q=80&amp;fit=crop\"/>\n<div class=\"flex min-w-0 flex-1 flex-col\" data-kid=\"1-1-2-2\" data-name=\"restaurant info column\">\n<h1 class=\"text-[32px] font-bold leading-[1.1] tracking-[-0.025em]\" data-kid=\"1-1-2-2-1\" data-name=\"restaurant name heading\">Spice Route Kitchen</h1>\n<p class=\"mt-2 text-[13px] font-medium text-[var(--zb-muted)]\" data-kid=\"1-1-2-2-2\" data-name=\"cuisine categories text\">North Indian, Biryani, Mughlai</p>\n<p class=\"mt-3 max-w-[540px] text-[14px] leading-[1.6] text-[var(--zb-muted)] line-clamp-2\" data-kid=\"1-1-2-2-3\" data-name=\"restaurant description text\">Slow-cooked curries, dum biryani and tandoor breads from a 42-seat kitchen in Koramangala.</p>\n<p class=\"mt-auto flex items-start gap-2 pt-3 text-[13px] leading-[1.5] text-[var(--zb-muted)]\" data-kid=\"1-1-2-2-4\" data-name=\"restaurant address row\">\n<i aria-hidden=\"true\" class=\"mdi mdi-map-marker-outline mt-[1px] text-[16px]\" data-kid=\"1-1-2-2-4-1\" data-name=\"map marker icon\"></i>\n<span data-kid=\"1-1-2-2-4-2\" data-name=\"restaurant address text\">24, 5th Cross, 80 Feet Road, Koramangala, Bengaluru, Karnataka 560095</span>\n</p>\n</div>\n<div class=\"w-[272px] shrink-0 border-l border-[var(--zb-line)] pl-5\" data-kid=\"1-1-2-3\" data-name=\"restaurant stats column\">\n<div class=\"flex items-baseline gap-1.5\" data-kid=\"1-1-2-3-1\" data-name=\"rating row\">\n<span class=\"text-[22px] font-bold leading-none tracking-[-0.02em]\" data-kid=\"1-1-2-3-1-1\" data-name=\"rating score value\">4.3</span>\n<i aria-hidden=\"true\" class=\"mdi mdi-star text-[15px] text-[#DB9A34]\" data-kid=\"1-1-2-3-1-2\" data-name=\"star rating icon\"></i>\n<span class=\"ml-1 text-[13px] text-[var(--zb-muted)]\" data-dynamic=\"true\" data-kid=\"1-1-2-3-1-3\" data-name=\"rating count text\" data-reason=\"rating count text is set via data-text and re-typed into span by script on page load\">1,284 ratings</span>\n</div>\n<div class=\"mt-3 flex items-center gap-2\" data-kid=\"1-1-2-3-2\" data-name=\"restaurant open status row\">\n<span class=\"h-[7px] w-[7px] rounded-full bg-[var(--zb-veg)]\" data-kid=\"1-1-2-3-2-1\" data-name=\"green vegan status dot\"></span>\n<span class=\"text-[13px] font-semibold\" data-kid=\"1-1-2-3-2-2\" data-name=\"open status text\">Open</span>\n</div>\n<dl class=\"mt-3\" data-kid=\"1-1-2-3-3\" data-name=\"delivery details list\">\n<div class=\"flex h-[30px] items-center justify-between border-t border-[var(--zb-line)]\" data-kid=\"1-1-2-3-3-1\" data-name=\"delivery time row\">\n<dt class=\"text-[13px] text-[var(--zb-muted)]\" data-kid=\"1-1-2-3-3-1-1\" data-name=\"delivery time label\">Delivery</dt>\n<dd class=\"text-[13px] font-semibold\" data-kid=\"1-1-2-3-3-1-2\" data-name=\"delivery time value\">32 min</dd>\n</div>\n<div class=\"flex h-[30px] items-center justify-between border-t border-[var(--zb-line)]\" data-kid=\"1-1-2-3-3-2\" data-name=\"minimum order row\">\n<dt class=\"text-[13px] text-[var(--zb-muted)]\" data-kid=\"1-1-2-3-3-2-1\" data-name=\"minimum order label\">Minimum order</dt>\n<dd class=\"text-[13px] font-semibold\" data-kid=\"1-1-2-3-3-2-2\" data-name=\"minimum order value\">₹149</dd>\n</div>\n<div class=\"flex h-[30px] items-center justify-between border-t border-[var(--zb-line)]\" data-kid=\"1-1-2-3-3-3\" data-name=\"delivery fee row\">\n<dt class=\"text-[13px] text-[var(--zb-muted)]\" data-kid=\"1-1-2-3-3-3-1\" data-name=\"delivery fee label\">Delivery fee</dt>\n<dd class=\"text-[13px] font-semibold\" data-kid=\"1-1-2-3-3-3-2\" data-name=\"delivery fee value\">₹29</dd>\n</div>\n</dl>\n</div>\n</section>\n<!-- Menu workspace -->\n<div class=\"mt-7 grid grid-cols-[184px_minmax(0,1fr)] items-start gap-6\" data-kid=\"1-1-3\" data-name=\"menu workspace grid\">\n<!-- Category rail -->\n<aside data-kid=\"1-1-3-1\" data-name=\"category navigation rail\">\n<h2 class=\"px-3 pb-2 text-[13px] font-semibold text-[var(--zb-muted)]\" data-kid=\"1-1-3-1-1\" data-name=\"categories heading\">Categories</h2>\n<div class=\"flex flex-col gap-1\" data-kid=\"1-1-3-1-2\" data-name=\"category button list\">\n<button aria-pressed=\"true\" class=\"h-10 w-full rounded-[10px] bg-[var(--zb-peach)] px-3 text-left text-[14px] font-semibold text-[var(--zb-accent)]\" data-kid=\"1-1-3-1-2-1\" data-name=\"all categories filter button (active)\" type=\"button\">All</button>\n<button aria-pressed=\"false\" class=\"h-10 w-full rounded-[10px] px-3 text-left text-[14px] font-medium text-[var(--zb-ink-2)] hover:bg-[#F7F1EA]\" data-kid=\"1-1-3-1-2-2\" data-name=\"biryani category filter button\" type=\"button\">Biryani</button>\n<button aria-pressed=\"false\" class=\"h-10 w-full rounded-[10px] px-3 text-left text-[14px] font-medium text-[var(--zb-ink-2)] hover:bg-[#F7F1EA]\" data-kid=\"1-1-3-1-2-3\" data-name=\"tandoor category filter button\" type=\"button\">Tandoor</button>\n<button aria-pressed=\"false\" class=\"h-10 w-full rounded-[10px] px-3 text-left text-[14px] font-medium text-[var(--zb-ink-2)] hover:bg-[#F7F1EA]\" data-kid=\"1-1-3-1-2-4\" data-name=\"curries category filter button\" type=\"button\">Curries</button>\n<button aria-pressed=\"false\" class=\"h-10 w-full rounded-[10px] px-3 text-left text-[14px] font-medium text-[var(--zb-ink-2)] hover:bg-[#F7F1EA]\" data-kid=\"1-1-3-1-2-5\" data-name=\"breads category filter button\" type=\"button\">Breads</button>\n<button aria-pressed=\"false\" class=\"h-10 w-full rounded-[10px] px-3 text-left text-[14px] font-medium text-[var(--zb-ink-2)] hover:bg-[#F7F1EA]\" data-kid=\"1-1-3-1-2-6\" data-name=\"rice category filter button\" type=\"button\">Rice</button>\n<button aria-pressed=\"false\" class=\"h-10 w-full rounded-[10px] px-3 text-left text-[14px] font-medium text-[var(--zb-ink-2)] hover:bg-[#F7F1EA]\" data-kid=\"1-1-3-1-2-7\" data-name=\"desserts category filter button\" type=\"button\">Desserts</button>\n<button aria-pressed=\"false\" class=\"h-10 w-full rounded-[10px] px-3 text-left text-[14px] font-medium text-[var(--zb-ink-2)] hover:bg-[#F7F1EA]\" data-kid=\"1-1-3-1-2-8\" data-name=\"drinks category filter button\" type=\"button\">Drinks</button>\n</div>\n</aside>\n<!-- Menu -->\n<section class=\"min-w-0\" data-kid=\"1-1-3-2\" data-name=\"menu section\">\n<div class=\"flex items-center justify-between gap-6 border-b border-[var(--zb-line)] pb-4\" data-kid=\"1-1-3-2-1\" data-name=\"menu header bar\">\n<div class=\"flex items-baseline gap-3\" data-kid=\"1-1-3-2-1-1\" data-name=\"menu title and count group\">\n<h2 class=\"text-[22px] font-bold leading-none tracking-[-0.025em]\" data-kid=\"1-1-3-2-1-1-1\" data-name=\"menu section heading\">Menu</h2>\n<span class=\"text-[13px] text-[var(--zb-muted)]\" data-kid=\"1-1-3-2-1-1-2\" data-name=\"dish count text\">9 dishes</span>\n</div>\n<div class=\"relative w-[360px]\" data-kid=\"1-1-3-2-1-2\" data-name=\"search input wrapper\">\n<i aria-hidden=\"true\" class=\"mdi mdi-magnify pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-[18px] text-[var(--zb-muted)]\" data-kid=\"1-1-3-2-1-2-1\" data-name=\"magnifying glass search icon\"></i>\n<input aria-label=\"Search dishes\" class=\"h-11 w-full rounded-[10px] border border-[var(--zb-line)] bg-white pl-10 pr-3 text-[14px] text-[var(--zb-ink)] placeholder:text-[var(--zb-muted)] focus:border-[var(--zb-accent)] focus:outline-none\" data-kid=\"1-1-3-2-1-2-2\" data-name=\"search dishes input field\" placeholder=\"Search dishes, flavours…\" type=\"text\"/>\n</div>\n</div>\n<div class=\"mt-6 grid grid-cols-3 gap-x-6 gap-y-8\" data-kid=\"1-1-3-2-2\" data-name=\"dishes grid container\">\n<!-- 1 -->\n<article class=\"flex flex-col\" data-kid=\"1-1-3-2-2-1\" data-name=\"menu dish card\">\n<div class=\"overflow-hidden rounded-[12px] bg-[var(--zb-peach)]\" data-kid=\"1-1-3-2-2-1-1\" data-name=\"dish image wrapper\">\n<img alt=\"Hyderabadi Dum Biryani — Saveurs Secretes on Pexels\" class=\"h-[208px] w-full object-cover\" data-kid=\"1-1-3-2-2-1-1-1\" data-name=\"dish photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/7394819/pexels-photo-7394819.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=900&amp;q=80\"/>\n</div>\n<div class=\"flex flex-1 flex-col pt-3\" data-kid=\"1-1-3-2-2-1-2\" data-name=\"dish details container\">\n<div class=\"flex items-center gap-2 text-[13px] text-[var(--zb-muted)]\" data-kid=\"1-1-3-2-2-1-2-1\" data-name=\"dish category tag row\">\n<span class=\"flex h-[13px] w-[13px] shrink-0 items-center justify-center rounded-[2px] border-[1.5px] border-[var(--zb-nonveg)]\" data-kid=\"1-1-3-2-2-1-2-1-1\" data-name=\"non-vegetarian indicator box\"><span class=\"h-[5px] w-[5px] rounded-full bg-[var(--zb-nonveg)]\" data-kid=\"1-1-3-2-2-1-2-1-1-1\" data-name=\"non-vegetarian red dot\"></span></span>\n<span data-kid=\"1-1-3-2-2-1-2-1-2\" data-name=\"dish category label\">Biryani</span>\n</div>\n<div class=\"mt-2 flex items-baseline justify-between gap-3\" data-kid=\"1-1-3-2-2-1-2-2\" data-name=\"dish title and price row\">\n<h3 class=\"text-[18px] font-semibold leading-[1.35] tracking-[-0.01em]\" data-kid=\"1-1-3-2-2-1-2-2-1\" data-name=\"dish name heading\">Hyderabadi Dum Biryani</h3>\n<span class=\"shrink-0 text-[16px] font-semibold\" data-kid=\"1-1-3-2-2-1-2-2-2\" data-name=\"dish price\">₹329</span>\n</div>\n<p class=\"mt-1.5 text-[14px] leading-[1.55] text-[var(--zb-muted)] line-clamp-2\" data-kid=\"1-1-3-2-2-1-2-3\" data-name=\"dish description text\">Basmati sealed with mutton marinated in yoghurt and saffron, cooked on dum.</p>\n<div class=\"mt-auto flex items-center justify-between gap-3 pt-4\" data-kid=\"1-1-3-2-2-1-2-4\" data-name=\"dish footer row\">\n<span class=\"inline-flex items-center gap-1.5 text-[13px] text-[var(--zb-muted)]\" data-kid=\"1-1-3-2-2-1-2-4-1\" data-name=\"preparation time badge\"><i aria-hidden=\"true\" class=\"mdi mdi-clock-outline text-[15px]\" data-kid=\"1-1-3-2-2-1-2-4-1-1\" data-name=\"clock icon\"></i>25 min</span>\n<button class=\"inline-flex h-9 items-center gap-1 rounded-[8px] px-1 text-[13px] font-semibold no-underline text-[var(--zb-accent)] hover:bg-[var(--zb-peach)]\" data-kid=\"1-1-3-2-2-1-2-4-2\" data-name=\"view item button\" type=\"button\">View item<i aria-hidden=\"true\" class=\"mdi mdi-arrow-right text-[15px]\" data-kid=\"1-1-3-2-2-1-2-4-2-1\" data-name=\"right arrow icon\"></i></button>\n</div>\n</div>\n</article>\n<!-- 2 -->\n<article class=\"flex flex-col\" data-kid=\"1-1-3-2-2-2\" data-name=\"menu dish card\">\n<div class=\"overflow-hidden rounded-[12px] bg-[var(--zb-peach)]\" data-kid=\"1-1-3-2-2-2-1\" data-name=\"dish image wrapper\">\n<img alt=\"Paneer Tikka — Anil Sharma on Pexels\" class=\"h-[208px] w-full object-cover\" data-kid=\"1-1-3-2-2-2-1-1\" data-name=\"dish photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/33430556/pexels-photo-33430556.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=900&amp;q=80\"/>\n</div>\n<div class=\"flex flex-1 flex-col pt-3\" data-kid=\"1-1-3-2-2-2-2\" data-name=\"dish details container\">\n<div class=\"flex items-center gap-2 text-[13px] text-[var(--zb-muted)]\" data-kid=\"1-1-3-2-2-2-2-1\" data-name=\"dish category tag row\">\n<span class=\"flex h-[13px] w-[13px] shrink-0 items-center justify-center rounded-[2px] border-[1.5px] border-[var(--zb-veg)]\" data-kid=\"1-1-3-2-2-2-2-1-1\" data-name=\"vegetarian indicator box\"><span class=\"h-[5px] w-[5px] rounded-full bg-[var(--zb-veg)]\" data-kid=\"1-1-3-2-2-2-2-1-1-1\" data-name=\"vegetarian green dot\"></span></span>\n<span data-kid=\"1-1-3-2-2-2-2-1-2\" data-name=\"dish category label\">Tandoor</span>\n</div>\n<div class=\"mt-2 flex items-baseline justify-between gap-3\" data-kid=\"1-1-3-2-2-2-2-2\" data-name=\"dish title and price row\">\n<h3 class=\"text-[18px] font-semibold leading-[1.35] tracking-[-0.01em]\" data-kid=\"1-1-3-2-2-2-2-2-1\" data-name=\"dish name heading\">Paneer Tikka</h3>\n<span class=\"shrink-0 text-[16px] font-semibold\" data-kid=\"1-1-3-2-2-2-2-2-2\" data-name=\"dish price\">₹269</span>\n</div>\n<p class=\"mt-1.5 text-[14px] leading-[1.55] text-[var(--zb-muted)] line-clamp-2\" data-kid=\"1-1-3-2-2-2-2-3\" data-name=\"dish description text\">Hung-curd and ajwain marinade, charred in the tandoor, served with mint chutney.</p>\n<div class=\"mt-auto flex items-center justify-between gap-3 pt-4\" data-kid=\"1-1-3-2-2-2-2-4\" data-name=\"dish footer row\">\n<span class=\"inline-flex items-center gap-1.5 text-[13px] text-[var(--zb-muted)]\" data-kid=\"1-1-3-2-2-2-2-4-1\" data-name=\"preparation time badge\"><i aria-hidden=\"true\" class=\"mdi mdi-clock-outline text-[15px]\" data-kid=\"1-1-3-2-2-2-2-4-1-1\" data-name=\"clock icon\"></i>15 min</span>\n<button class=\"inline-flex h-9 items-center gap-1 rounded-[8px] px-1 text-[13px] font-semibold no-underline text-[var(--zb-accent)] hover:bg-[var(--zb-peach)]\" data-kid=\"1-1-3-2-2-2-2-4-2\" data-name=\"view item button\" type=\"button\">View item<i aria-hidden=\"true\" class=\"mdi mdi-arrow-right text-[15px]\" data-kid=\"1-1-3-2-2-2-2-4-2-1\" data-name=\"right arrow icon\"></i></button>\n</div>\n</div>\n</article>\n<!-- 3 -->\n<article class=\"flex flex-col\" data-kid=\"1-1-3-2-2-3\" data-name=\"menu dish card\">\n<div class=\"overflow-hidden rounded-[12px] bg-[var(--zb-peach)]\" data-kid=\"1-1-3-2-2-3-1\" data-name=\"dish image wrapper\">\n<img alt=\"Butter Chicken — Saveurs Secretes on Pexels\" class=\"h-[208px] w-full object-cover\" data-kid=\"1-1-3-2-2-3-1-1\" data-name=\"dish photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/7625056/pexels-photo-7625056.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=900&amp;q=80\"/>\n</div>\n<div class=\"flex flex-1 flex-col pt-3\" data-kid=\"1-1-3-2-2-3-2\" data-name=\"dish details container\">\n<div class=\"flex items-center gap-2 text-[13px] text-[var(--zb-muted)]\" data-kid=\"1-1-3-2-2-3-2-1\" data-name=\"dish category tag row\">\n<span class=\"flex h-[13px] w-[13px] shrink-0 items-center justify-center rounded-[2px] border-[1.5px] border-[var(--zb-nonveg)]\" data-kid=\"1-1-3-2-2-3-2-1-1\" data-name=\"non-vegetarian indicator box\"><span class=\"h-[5px] w-[5px] rounded-full bg-[var(--zb-nonveg)]\" data-kid=\"1-1-3-2-2-3-2-1-1-1\" data-name=\"non-vegetarian red dot\"></span></span>\n<span data-kid=\"1-1-3-2-2-3-2-1-2\" data-name=\"dish category label\">Curries</span>\n</div>\n<div class=\"mt-2 flex items-baseline justify-between gap-3\" data-kid=\"1-1-3-2-2-3-2-2\" data-name=\"dish title and price row\">\n<h3 class=\"text-[18px] font-semibold leading-[1.35] tracking-[-0.01em]\" data-kid=\"1-1-3-2-2-3-2-2-1\" data-name=\"dish name heading\">Butter Chicken</h3>\n<span class=\"shrink-0 text-[16px] font-semibold\" data-kid=\"1-1-3-2-2-3-2-2-2\" data-name=\"dish price\">₹349</span>\n</div>\n<p class=\"mt-1.5 text-[14px] leading-[1.55] text-[var(--zb-muted)] line-clamp-2\" data-kid=\"1-1-3-2-2-3-2-3\" data-name=\"dish description text\">Tandoori chicken in a tomato-cashew gravy finished with white butter.</p>\n<div class=\"mt-auto flex items-center justify-between gap-3 pt-4\" data-kid=\"1-1-3-2-2-3-2-4\" data-name=\"dish footer row\">\n<span class=\"inline-flex items-center gap-1.5 text-[13px] text-[var(--zb-muted)]\" data-kid=\"1-1-3-2-2-3-2-4-1\" data-name=\"preparation time badge\"><i aria-hidden=\"true\" class=\"mdi mdi-clock-outline text-[15px]\" data-kid=\"1-1-3-2-2-3-2-4-1-1\" data-name=\"clock icon\"></i>20 min</span>\n<button class=\"inline-flex h-9 items-center gap-1 rounded-[8px] px-1 text-[13px] font-semibold no-underline text-[var(--zb-accent)] hover:bg-[var(--zb-peach)]\" data-kid=\"1-1-3-2-2-3-2-4-2\" data-name=\"view item button\" type=\"button\">View item<i aria-hidden=\"true\" class=\"mdi mdi-arrow-right text-[15px]\" data-kid=\"1-1-3-2-2-3-2-4-2-1\" data-name=\"right arrow icon\"></i></button>\n</div>\n</div>\n</article>\n<!-- 4 -->\n<article class=\"flex flex-col\" data-kid=\"1-1-3-2-2-4\" data-name=\"menu dish card\">\n<div class=\"overflow-hidden rounded-[12px] bg-[var(--zb-peach)]\" data-kid=\"1-1-3-2-2-4-1\" data-name=\"dish image wrapper\">\n<img alt=\"Galouti Kebab — Chait Goli on Pexels\" class=\"h-[208px] w-full object-cover\" data-kid=\"1-1-3-2-2-4-1-1\" data-name=\"dish photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/7353380/pexe